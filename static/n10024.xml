    <div class="alpheios-lex-entry" lemma-id="n10024" body-key=""><b><span class="alpheios-lex-la" lang="lat">condītūra</span></b> ,
			ae, f.
		condio. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A preserving of fruits</i>, <i><span class="en">Col. 12,
				48, 1</span></i>; <i><span class="en">12, 49,
				3</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">olivarum,</span>”
				 <i><span class="en">id.
					12, 11, 2</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
