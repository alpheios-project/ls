    <div class="alpheios-lex-entry" lemma-id="n16276" body-key=""><b><span class="alpheios-lex-la" lang="lat">ēsus</span></b> , ūs,
			m.
		1. edo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an eating</i> (anteclass. and post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">esui condi,</span>”
				 <i><span class="en">Varr. R. R. 1, 60</span></i>
			; cf.: 
				“<span class="alpheios-lex-la" lang="lat">esui dare alicui,</span>”
				 <i><span class="en">Plin.
					20, 17, 69, § 178</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">agni,</span>”
				 <i><span class="en">Vulg.
					Exod. 12, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">esui esse,</span>”
				 <i><span class="en">Gell.
					4, 1, 20</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">esum et potum eximere,</span>”
				 <i><span class="en">Tert. Anim. 43</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			Concr., <i>food</i>, <i><span class="en">Alcim. 5,
				258</span></i>.</div>
