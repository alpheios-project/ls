    <div class="alpheios-lex-entry" lemma-id="n36586" body-key=""><b><span class="alpheios-lex-la" lang="lat">plastĭcē</span></b> ,
		ēs, and <b><span class="alpheios-lex-la" lang="lat">-ca</span></b> , ae, f., = <span class="alpheios-lex-greek" lang="grc">πλαστική</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the plastic art</i>, <i>statuary</i>
			(post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">qui plasticen matrem statuariae scalpturaeque
					et caelaturae esse dixit,</span>”
				 <i><span class="en">Plin.
					35, 12, 43, § 151</span></i>
			.—Form plastica, <i><span class="en">Tert. Cult.
				Fem. 2 <i>fin.</i></span></i> 5;
				<i><span class="en">id. Spect. 18</span></i>.</div>
