    <div class="alpheios-lex-entry" lemma-id="n26702" body-key=""><b><span class="alpheios-lex-la" lang="lat">linguōsus</span></b> , a, um,
			adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>talkative, loquacious</i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">durae buccae fuit, linguosus,</span>”
				 <i><span class="en">Petr. 43, 3</span></i>
			; <i><span class="en">63, 2</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">adulescentula,</span>”
				 <i><span class="en">Hier. Ep. 108</span></i>
			, n. 20.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>expressive</i>: 
				“<span class="alpheios-lex-la" lang="lat">orchestarum linguosi digiti,</span>”
				 <i><span class="en">Cassiod. Var. 4, 51</span></i>
			.</div>
