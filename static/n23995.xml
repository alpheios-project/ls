    <div class="alpheios-lex-entry" lemma-id="n23995" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-strēnŭus</span></b> , a,
		um, adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>not brisk</i>, <i>inactive</i>, <i>sluggish</i>, <i>spiritless</i> (<b>poet.</b> and in post-Aug. prose): 
				“<span class="alpheios-lex-la" lang="lat">homo,</span>”
				 <i><span class="en">Plaut. Most. 1, 2, 23</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">animus,</span>”
				 <i><span class="en">Ter.
					Heaut. 1, 1, 68</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">dux,</span>”
				 <i><span class="en">Suet. Vesp. 4</span></i>
			. — <i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">instrēnŭē</span></b> , <i>without spirit</i>: 
				“<span class="alpheios-lex-la" lang="lat">non instrenue moriens,</span>”
				 <i><span class="en">Just.
					17, 2, 1</span></i>
			.</div>
