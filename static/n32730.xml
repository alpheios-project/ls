    <div class="alpheios-lex-entry" lemma-id="n32730" body-key=""><b><span class="alpheios-lex-la" lang="lat">Opĭlĭus</span></b> , i,
			m., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>a Roman surname.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b> Aurelius Opilius, <i>a grammarian and author</i>, <i><span class="en">Suet. Gram.
			6</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Another</i> Aurelius Opilius, <i>a
				physician</i>, <i><span class="en">Plin. 28, 4, 7, §
			38</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			M. Opilius Severus Macrinus, <i>emperor of Rome</i>,
			A. D. 218, <i><span class="en">Eutr. 8, 21</span></i>.</div>
