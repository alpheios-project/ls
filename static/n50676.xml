    <div class="alpheios-lex-entry" lemma-id="n50676" body-key=""><b><span class="alpheios-lex-la" lang="lat">vēsānĭa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">vaesā-</span></b> ),
			ae, f.
		vesanus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>madness</i>, <i>insanity</i> (very
			rare): 
				“<span class="alpheios-lex-la" lang="lat">extimui, ne vos ageret vesania discors,</span>”
				 <i><span class="en">Hor.
					S. 2, 3, 174</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">simulata (Ulixis),</span>”
