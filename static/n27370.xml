    <div class="alpheios-lex-entry" lemma-id="n27370" body-key=""><b><span class="alpheios-lex-la" lang="lat">lygdĭnus</span></b> , a, um,
			adj., = <span class="alpheios-lex-greek" lang="grc">λύγδινος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of white marble</i>: 
				“<span class="alpheios-lex-la" lang="lat">horoscopus,</span>”
				 <i><span class="en">Jul. Val. Rer. Gest. Alex. M. 1,
				3</span></i>
			.—Esp.: 
				“<span class="alpheios-lex-la" lang="lat">lygdinus lapis,</span>”
				<i>a dazzling white marble found in the island of
					Paros</i>,
				 <i><span class="en">Plin.
					36, 8, 13, § 62</span></i>
			; <i><span class="en">Isid. Orig. 16, 5, 8</span></i> (the same
			as lygdos).</div>
