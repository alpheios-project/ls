			cannibals.— <i>Sing. collect.</i>: 
				“<span class="alpheios-lex-la" lang="lat">vicinus Phoebo tenet arva Padaeus,</span>”
				 <i><span class="en">Tib. 15, 1, 145</span></i>
			.</div>
