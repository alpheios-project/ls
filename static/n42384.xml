    <div class="alpheios-lex-entry" lemma-id="n42384" body-key=""><b><span class="alpheios-lex-la" lang="lat">salsūgo</span></b>  (collat. form <b><span class="alpheios-lex-la" lang="lat">salsĭlāgo</span></b> , <i><span class="en">Plin. 31, 7, 42,
			§ 92</span></i>; <i><span class="en">18,
			12, 32, § 124</span></i>), ĭnis,
			f.
		salsus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>saltness</i>, <i>brackishness</i>,
				<i><span class="en">Vitr. 1,
				4</span></i>; 
			<i><span class="en">Plin. 36,
				23, 55, § 176</span></i>; <i><span class="en">19, 5, 26, § 84
				al.</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">terra salsuginis,</span>”
				i. e. <i>a desert</i>,
				 <i><span class="en">Vulg. Job, 39, 6</span></i>
			; <i><span class="en">id.
				Jer. 17, 6</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>salt-water</i>,
				<i>brine</i>, <i><span class="en">Plin. 19, 5,
				26, § 85</span></i>; <i><span class="en">31, 7, 42, §
			92</span></i>.</div>
