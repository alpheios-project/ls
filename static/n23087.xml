    <div class="alpheios-lex-entry" lemma-id="n23087" body-key=""><b><span class="alpheios-lex-la" lang="lat">ĭn-exstinguĭbĭlis</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inext-</span></b> ), e,
			adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unextinguishable</i> (ante- and post-class.).
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">flamma,</span>”
				 <i><span class="en">Lact. 7, 19</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ignis,</span>”
				 <i><span class="en">Vulg.
					Matt. 3, 12</span></i>
			; <i><span class="en">ib.
				Marc. 9, 42</span></i>.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>: mala consuetudo, <i>indelible</i>, Varr. ap. <i><span class="en">Non. 131,
			6</span></i>.</div>
