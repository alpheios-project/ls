    <div class="alpheios-lex-entry" lemma-id="n28562" body-key=""><b><span class="alpheios-lex-la" lang="lat">mĕlōdus</span></b> , a, um,
			adj., = <span class="alpheios-lex-greek" lang="grc">μελῳδός</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>pleasantly singing,
				melodious</i> (post-class.): 
				“<span class="alpheios-lex-la" lang="lat">virgines,</span>”
				 <i><span class="en">Aus. Prof. 15, 8</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">carmen,</span>”
				 <i><span class="en">Prud. Cath. 9, 2</span></i>
			.—Hence, <i>subst.</i>: <b><span class="alpheios-lex-la" lang="lat">mĕlōda</span></b> ,
				ae, f., <i>a melody</i>:
			lyricae melodae, Ven. Carm. 9, 7, 13.</div>
