    <div class="alpheios-lex-entry" lemma-id="n34911" body-key=""><b><span class="alpheios-lex-la" lang="lat">perfĭcus</span></b> , a, um,
			adj.
		perficio, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>completing</i>, <i>perfecting</i>
				(<b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">natura,</span>”
				 <i><span class="en">Lucr.
					2, 1116</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">Perfĭca</span></b> , ae, f.,
				<i>the finishing</i> or <i>completing
				goddess</i>, <i>she that perfects</i>: 
				“<span class="alpheios-lex-la" lang="lat">natura creatrix,</span>”
				 <i><span class="en">Lucr.
					2, 1116</span></i>
			.— 
				“<span class="alpheios-lex-la" lang="lat">Of the goddess supposed to preside over sexual
					indulgence,</span>”
				 <i><span class="en">Arn. 4, 131</span></i>
			.</div>
