    <div class="alpheios-lex-entry" lemma-id="n13751" body-key=""><b><span class="alpheios-lex-la" lang="lat">dĭastēma</span></b>  (short ĕ,
				<i><span class="en">Sid. Carm. 15, 64</span></i>),
