    <div class="alpheios-lex-entry" lemma-id="n21768" body-key=""><b><span class="alpheios-lex-la" lang="lat">immundĭtĭa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inm-</span></b> ), ae, f.
		immundus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>uncleanness</i>, <i>impurity</i>, <i>filth</i>, <i><span class="en">Plaut. Stich. 5, 5,
			6</span></i>.—Also <b><span class="alpheios-lex-la" lang="lat">immundĭtĭes</span></b> ,
			ēi, <i><span class="en">Tert. Mon.
			7</span></i>.—In plur., <i><span class="en">Col. 1, 6,
				11</span></i>; <i><span class="en">12, 3,
			8</span></i>; <i><span class="en">Dig. 43, 23, 1, § 2</span></i>;
					<i><span class="en">Tert. Res. Carn. 47</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">continet se a viis nostris, quasi ab
					immunditiis,</span>”
				 <i><span class="en">Lact. 4, 16, 8</span></i>
			.</div>
