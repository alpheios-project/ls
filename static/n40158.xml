    <div class="alpheios-lex-entry" lemma-id="n40158" body-key=""><b><span class="alpheios-lex-la" lang="lat">quingentĭes</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-tĭens</span></b> ), adv.
		quingenti, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>five hundred times</i>: 
				“<span class="alpheios-lex-la" lang="lat">quingentiens mille,</span>”
				 <i><span class="en">Vitr. 1,
					6</span></i>
			.—Of money: 
				“<span class="alpheios-lex-la" lang="lat">quingentiens HS.,</span>”
				<i>fifty millions of sesterces</i>,
				 <i><span class="en">Cic. Verr. 2, 2, 38, § 93</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">miliens et quingentiens,</span>”
				 <i><span class="en">Suet. Aug. 101</span></i>
			; <i><span class="en">id. Galb. 5</span></i>.</div>
