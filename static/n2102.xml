    <div class="alpheios-lex-entry" lemma-id="n2102" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ămantĭa</span></b> , ae,
			f., = <span class="alpheios-lex-greek" lang="grc">Ἀμαντία</span>, Ptol.,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>name of two
				towns of Illyricum</i>, one inland, and the other on the coast,
			now <i>Nivitza</i>, <i><span class="en">Cic. Phil.
				11, 11</span></i>; <i><span class="en">Caes. B. C. 3, 40</span></i>.—<i>Its inhabitants</i>, <b><span class="alpheios-lex-la" lang="lat">Ămantĭāni</span></b> ,
				ōrum, m., <i><span class="en">Caes. B. C.
				3, 12</span></i>.—<b><span class="alpheios-lex-la" lang="lat">Ămantīni</span></b> ,
			ōrum, m., <i><span class="en">Plin. 4, 10,
				17, § 35</span></i>.—<b><span class="alpheios-lex-la" lang="lat">Ămantes</span></b> , um,
			m., <i><span class="en">Plin. 3, 23, 26, §
		145</span></i>.</div>
