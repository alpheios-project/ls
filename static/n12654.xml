    <div class="alpheios-lex-entry" lemma-id="n12654" body-key=""><b><span class="alpheios-lex-la" lang="lat">dēfătīgātĭo</span></b> 
		or <b><span class="alpheios-lex-la" lang="lat">defĕt-</span></b> ,
			ōnis, f.
		defatigo. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Act., a wearying, tiring out, fatiguing</i>, <i><span class="en">Hirt.
				B. G. 8, 27, 4</span></i>; <i><span class="en">Cic. Sen. 23, 86</span></i>; <i><span class="en">id. de Or. 3,
				44</span></i>; <i><span class="en">id. N. D. 2, 23,
			59</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Pass., weariness, fatigue, exhaustion</i>, <i><span class="en">Caes. B. G.
				3, 19, 3</span></i>; <i><span class="en">Auct. Her. 1, 17,
			27</span></i>; <i><span class="en">Cic. Phil. 5, 7, 20</span></i>; <i><span class="en">id. Sen.
				11, 36 al.</span></i></div>
