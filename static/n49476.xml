    <div class="alpheios-lex-entry" lemma-id="n49476" body-key=""><b><span class="alpheios-lex-la" lang="lat">tūrĭbŭlum</span></b>  (<b><span class="alpheios-lex-la" lang="lat">thūr-</span></b> ),
		i, n.
		tus. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i>a vessel to burn
				incense in</i>, <i>a censer</i>, <i><span class="en">Cic. Verr. 2, 4, 21, § 46</span></i>;
				<i><span class="en">Liv. 29, 14, 13</span></i>; <i><span class="en">Curt. 8, 9,
				23</span></i>; <i><span class="en">Val.
					Max. 3, 3</span></i>, ext. 1;
				<i><span class="en">Aus. Idyll. 12, 104</span></i>;
					<i><span class="en">Prud. Apoth.
			479</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>a
			constellation</i>, <i>otherwise called</i> Ara,
					<i><span class="en">German. Arat. 390</span></i>; <i><span class="en">Vitr. 9,
			7</span></i>.</div>
