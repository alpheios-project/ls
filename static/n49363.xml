    <div class="alpheios-lex-entry" lemma-id="n49363" body-key=""><b><span class="alpheios-lex-la" lang="lat">Tuccĭus</span></b> , i,
		m.; <b><span class="alpheios-lex-la" lang="lat">Tuccĭa</span></b> ,
			ae, f., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the name of a Roman</i> gens.
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b> M. Tuccius, <i><span class="en">Liv. 35,
			41</span></i>; Cael. ap. <i><span class="en">Cic. Fam. 8,
			8</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			L. Tuccius Valla, <i>a physician</i>, <i><span class="en">Plin. 7, 53,
				54, § 183</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b> Tuccia, <i>a
				celebrated vestal</i>, <i><span class="en">Val. Max. 8, 1, 5</span></i>; <i><span class="en">Plin. 28, 2,
				3, § 12</span></i>.</div>
