    <div class="alpheios-lex-entry" lemma-id="n48917" body-key=""><b><span class="alpheios-lex-la" lang="lat">trăpētus</span></b> , i,
			m., = <span class="alpheios-lex-greek" lang="grc">τραπητός,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an olivemill</i>,
				<i>oil-mill</i>, <i><span class="en">Cato, R.
				R. 20, 1</span></i>; <i><span class="en">20, 12</span></i>; <i><span class="en">22, 3</span></i>; <i><span class="en">Verg. G. 2,
				519</span></i>; <i><span class="en">Plin. 15, 6, 6, §
			23</span></i>.—Collat. form <b><span class="alpheios-lex-la" lang="lat">trăpētum</span></b> , i,
			n., = <span class="alpheios-lex-greek" lang="grc">τραπητόν,</span>
			<i><span class="en">Col. 12,
				52, 6</span></i>; <i><span class="en">Dig. 19, 2, 19, §
			2</span></i>.—And plur.: <b><span class="alpheios-lex-la" lang="lat">trăpētes</span></b> ,
			um, m., = <span class="alpheios-lex-greek" lang="grc">τράπητες,</span>
			<i><span class="en">Varr. L. L. 4, § 138</span></i>
			Müll.; <i><span class="en">id. R. R. 1, 55, 5</span></i>;
					<i><span class="en">Cato, R. R. 18, 2</span></i>.</div>
