    <div class="alpheios-lex-entry" lemma-id="n51004" body-key=""><b><span class="alpheios-lex-la" lang="lat">vīnŏlentus</span></b> , a,
		um, adj.
		vinum, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of</i> or <i>drunk with wine</i>, <i>drunk</i>, <i>intoxicated</i>, <i><span class="en">Ter. Phorm.
				5, 9, 28</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">ne sobrius in violentiam vinolentorum incidat,</span>”
				 <i><span class="en">Cic. Tusc. 5, 41, 118</span></i>
			; <i><span class="en">id. Agr. 1, 1, 1</span></i>; <i><span class="en">id. Phil.
				2, 28, 68</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">furor,</span>”
				 <i><span class="en">id.
					Fam. 12, 25, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">homines,</span>”
				 <i><span class="en">Nep. Alcib. 11, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">medicamenta,</span>”
				<i>strongly mixed with wine</i>,
				 <i><span class="en">Cic.
					Pis. 6, 13</span></i>
			.</div>
