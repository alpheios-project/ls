    <div class="alpheios-lex-entry" lemma-id="n2421" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ănā^crĕōn</span></b> ,
			ontis, m., = <span class="alpheios-lex-greek" lang="grc">Ἀνακρέων</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a distinguished lyric poet of Teos</i>, <i>who fl.</i> 540 B.C., <i><span class="en">Cic. Tusc.
				4, 33, 71</span></i>; <i><span class="en">Hor. C. 4, 9, 9</span></i>; <i><span class="en">id. Epod.
				14, 10 al.</span></i>—Hence, <b><span class="alpheios-lex-la" lang="lat">Ănā^crĕōntēus</span></b> ,
				a, um, adj.,
				<i><span class="en">Diom. p. 512</span></i> P.; <b><span class="alpheios-lex-la" lang="lat">Ănā^crĕōn-tĭus</span></b> ,
				a, um, adj., <i><span class="en">Quint. 9,
				4, 78</span></i>; <i><span class="en">Gell. 19, 9</span></i>; and <b><span class="alpheios-lex-la" lang="lat">Ănā^crĕōntĭcus</span></b> ,
				a, um, adj.,
				<i><span class="en">Fulg. Myth. 1</span></i>.</div>
