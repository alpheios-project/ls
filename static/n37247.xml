    <div class="alpheios-lex-entry" lemma-id="n37247" body-key=""><b><span class="alpheios-lex-la" lang="lat">postscaenĭum</span></b>  or <b><span class="alpheios-lex-la" lang="lat">poscaenĭum</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-cen-</span></b> ), ii, n.
