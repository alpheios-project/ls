<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n7704" body-key=""><b><span class="alpheios-lex-la" lang="lat">chămaelĕon</span></b> ,
			ōnis and ontis, m., = <span class="alpheios-lex-greek" lang="grc">χαμαιλέων</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Masc.</i>, <i>a kind of lizard that
				changes its color</i>, <i>the chameleon</i>,
				<i><span class="en">Plin.
				8, 33, 51, § 120</span></i>; <i><span class="en">10, 52, 73, §
			143</span></i>; <i><span class="en">Gell. 10, 12, 1
			sq.</span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Masc.</i> and <i>fem.</i>, <i>a plant</i>, <i>the carline thistle;
				masc.</i>, <i><span class="en">Plin. 22, 18, 21, § 45</span></i>;
				<i><span class="en">27, 13, 118,
				§ 143</span></i>; <i>fem.</i>, <i><span class="en">id. 30, 4,
				10, § 30</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
