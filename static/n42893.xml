    <div class="alpheios-lex-entry" lemma-id="n42893" body-key=""><b><span class="alpheios-lex-la" lang="lat">Scarphēa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-ĭ_a</span></b> ), ae, f.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A town of Locris</i>, <i>near
				Thermopylœ</i>, <i><span class="en">Liv. 32,
			3</span></i>; <i><span class="en">36, 20</span></i>;
				<i><span class="en">Plin.
				4, 7, 12, § 27</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>An island of the Ægean Sea</i>, <i><span class="en">Plin. 4, 12,
				20, § 62</span></i>.</div>
