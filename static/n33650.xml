    <div class="alpheios-lex-entry" lemma-id="n33650" body-key=""><b><span class="alpheios-lex-la" lang="lat">Pāniscus</span></b> , i,
		m., = <span class="alpheios-lex-greek" lang="grc">Πανίσκος</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A little Pan</i>, <i>a rural
			deity</i>: 
				“<span class="alpheios-lex-la" lang="lat">si Nymphae, Panisci etiam et Satyri,</span>”
				 <i><span class="en">Cic.
					N. D. 3, 17, 43</span></i>
			; <i><span class="en">id. Div. 1, 13, 23</span></i>; <i><span class="en">2, 21,
			48</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A Roman surname</i>, <i><span class="en">Inscr.
				Gud. 172, 3</span></i>.</div>
