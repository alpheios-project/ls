    <div class="alpheios-lex-entry" lemma-id="n26251" body-key=""><b><span class="alpheios-lex-la" lang="lat">lentĭtĭa</span></b> , ae
			(<b><span class="alpheios-lex-la" lang="lat">lentĭtĭes</span></b> , ēi,
				<i><span class="en">Auct. Aetn. 540</span></i>), f.
		lentus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>pliancy, flexibility, toughness, viscosity,
				stickiness</i>: 
				“<span class="alpheios-lex-la" lang="lat">virgas sequacis ad vincturas lentitiae,</span>”
				 <i><span class="en">Plin.
					16, 37, 68, § 174</span></i>
			; <i><span class="en">16, 40, 77,
				§ 210</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">lactucae lentitiam pituitae digerunt,</span>”
				 <i><span class="en">id.
					20, 7, 26, § 64</span></i>
			; cf. lentor.</div>
