    <div class="alpheios-lex-entry" lemma-id="n20163" body-key=""><b><span class="alpheios-lex-la" lang="lat">Hălĭcyensis</span></b> ,
			e, adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>belonging to
				the city Halicyœ</i> (<span class="alpheios-lex-greek" lang="grc">Ἁλικύαι</span>) <i>in Sicily</i> (now <i>Salemi</i>), <i>Halicyœan</i>: 
				“<span class="alpheios-lex-la" lang="lat">civitas,</span>”
				 <i><span class="en">Cic. Verr. 2, 3, 6, § 13</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Sopater quidam,</span>”
				<i>of Halicyœ</i>,
				 <i><span class="en">id. ib. 2, 2, 28</span></i>
			, § 68.—<i>Plur. subst.</i>:
				<b><span class="alpheios-lex-la" lang="lat">Halicy-enses</span></b> ,
			ium, m., <i>the inhabitants
				of Halicyœ</i>, <i>Halicyœans</i>, <i><span class="en">Cic. Verr. 2, 3, 40, § 91</span></i>;
				<i><span class="en">Plin.
				3, 8, 14, § 91</span></i>.</div>
