    <div class="alpheios-lex-entry" lemma-id="n33532" body-key=""><b><span class="alpheios-lex-la" lang="lat">palpĭtātĭo</span></b> ,
			ōnis, f.
		palpito, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a frequent and rapid motion</i>, <i>a
				palpitation</i>: 
				“<span class="alpheios-lex-la" lang="lat">cordis,</span>”
				<i>a palpitation of the heart</i>,
				 <i><span class="en">Plin.
					32, 5, 18, § 49</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">oculorum,</span>”
				<i>a blinking</i>,
				 <i><span class="en">id.
					32, 10, 46, § 132</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">partium singularum,</span>”
				 <i><span class="en">id.
					11, 4, 3, § 10</span></i>
			.</div>
