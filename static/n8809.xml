    <div class="alpheios-lex-entry" lemma-id="n8809" body-key=""><b><span class="alpheios-lex-la" lang="lat">cōcĭo</span></b>  or <b><span class="alpheios-lex-la" lang="lat">cōtĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">coctio</span></b> , Paul. ex <i><span class="en">Fest. p.
			20, 12</span></i>, and 51, 3 Müll. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>N. cr.</i>),
