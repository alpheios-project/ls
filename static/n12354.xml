    <div class="alpheios-lex-entry" lemma-id="n12354" body-key=""><b><span class="alpheios-lex-la" lang="lat">daucum</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-on</span></b> ), i, n., also <b><span class="alpheios-lex-la" lang="lat">daucus</span></b> , i,
		m., <i><span class="en">Scrib. Comp. 167</span></i>; <i><span class="en">170</span></i>; <i><span class="en">177</span></i> = <span class="alpheios-lex-greek" lang="grc">δαῦκον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a plant of the parsnip or carrot kind</i>, much
			used in medicine, <i><span class="en">Plin. 19, 5, 27, § 89</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">probatissimus in Creta,</span>”
				 <i><span class="en">id. 25, 9, 64, § 110 al.</span></i>
			; <i><span class="en">Cels. 5, 23, 3 al.</span></i> In
					<i><span class="en">App. Herb. 80</span></i>, called daucion
			and daucites.</div>
