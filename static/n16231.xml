    <div class="alpheios-lex-entry" lemma-id="n16231" body-key=""><b><span class="alpheios-lex-la" lang="lat">ĕrȳ^thrănos</span></b> ,
			on, = <span class="alpheios-lex-greek" lang="grc">ἐρυθρανός</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>red</i>: 
				“<span class="alpheios-lex-la" lang="lat">cissus erythranos similis hederae,</span>”
				 <i><span class="en">Plin.
					24, 10, 49, § 82</span></i>
			.—Hence, † <b><span class="alpheios-lex-la" lang="lat">ĕrythrănon</span></b> , i,
				n., = <span class="alpheios-lex-greek" lang="grc">ἐρυθρανόν</span>,
				<i>a kind of ivy with reddish berries</i>, <i><span class="en">Plin. 16,
				34, 62, § 147</span></i>.</div>
