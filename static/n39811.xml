    <div class="alpheios-lex-entry" lemma-id="n39811" body-key=""><b><span class="alpheios-lex-la" lang="lat">Pȳthon</span></b> , ōnis,
			m., = <span class="alpheios-lex-greek" lang="grc">Πύθων,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the serpent
			slain</i>, <i>according to the myth</i>, <i>near Delphi by Apollo</i>, <i>who was
				fabled to have been called Pythius in commemoration of this
				victory</i>, <i><span class="en">Ov. M. 1, 438</span></i>; <i><span class="en">460</span></i>;
					<i><span class="en">Claud. in Rufin. 1, 1</span></i>.</div>
