    <div class="alpheios-lex-entry" lemma-id="n5965" body-key=""><b><span class="alpheios-lex-la" lang="lat">căcūmĭno</span></b> ,
			āvi, ātum, 1, v. a.
		cacumen, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>to point</i>, <i>make pointed</i>
			(prob. formed by Ovid): 
				“<span class="alpheios-lex-la" lang="lat">summas cacuminat aures,</span>”
				 <i><span class="en">Ov. M.
					3, 195</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">saxoque cacuminat ensem,</span>”
				 <i><span class="en">Sid. Carm. 7, 414</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ova cacuminata,</span>”
				 <i><span class="en">Plin.
					10, 52, 74, § 145</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">apex in conum cacuminatus,</span>”
				 <i><span class="en">Sid. Ep. 2, 2</span></i>
			.</div>
