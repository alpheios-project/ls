    <div class="alpheios-lex-entry" lemma-id="n31430" body-key=""><b><span class="alpheios-lex-la" lang="lat">nummātus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">nūmāt-</span></b> ), a, um,
			adj.
		numus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>moneyed, furnished with money, rich</i>: 
				“<span class="alpheios-lex-la" lang="lat">homo bene nummatus,</span>”
				 <i><span class="en">Cic.
					Agr. 2, 22, 58</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">bene nummatum decorat Suadela Venusque,</span>”
				 <i><span class="en">Hor. Ep. 1, 6, 38</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">nummatior revertor,</span>”
				 <i><span class="en">App. M. 1, p. 105, 19</span></i>
			.</div>
