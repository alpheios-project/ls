    <div class="alpheios-lex-entry" lemma-id="n44013" body-key=""><b><span class="alpheios-lex-la" lang="lat">sessōrĭum</span></b> , ii,
			n.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>a seat.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A stool</i>, <i>chair</i>, <i><span class="en">Cael.
				Aur. Acut. 1, 11 <i>med.</i></span></i>— * </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A place of residence</i>, <i>a
				dwelling</i>, <i>habitation</i>: 
				“<span class="alpheios-lex-la" lang="lat">viperae hujus sessorium,</span>”
				 <i><span class="en">Petr. 77, 4</span></i>
			.</div>
