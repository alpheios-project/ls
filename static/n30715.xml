    <div class="alpheios-lex-entry" lemma-id="n30715" body-key=""><b><span class="alpheios-lex-la" lang="lat">nĕmŏrālis</span></b> ,
		e, adj.
		nemus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>belonging to a grove</i> or <i>wood, woody, sylvan</i> (<b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">templum Dianae,</span>”
				<i>near Aricia</i>,
				 <i><span class="en">Ov. A.
					A. 1, 259</span></i>
			; cf. 
				“<span class="alpheios-lex-la" lang="lat">Aricia,</span>”
				<i>situated near the grove</i>,
				 <i><span class="en">id. F.
					6, 59</span></i>
			; <i><span class="en">Mart. 13, 19, 1</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">umbrae,</span>”
				 <i><span class="en">Ov.
					Am. 3, 1, 5</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">antrum,</span>”
				 <i><span class="en">id. M.
					3, 157</span></i>
			.</div>
