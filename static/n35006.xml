    <div class="alpheios-lex-entry" lemma-id="n35006" body-key=""><b><span class="alpheios-lex-la" lang="lat">per-grandis</span></b> , e, adj.,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>very
			large</i>, <i>very great</i> (rare but class.): 
				“<span class="alpheios-lex-la" lang="lat">gemma,</span>”
				 <i><span class="en">Cic. Verr. 2, 4, 27, § 62</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vectigal,</span>”
				 <i><span class="en">id.
					Agr. 1, 4, 9</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">lucrum,</span>”
				 <i><span class="en">Plaut. Pers. 4, 3, 23</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">pergrandis natu,</span>”
				<i>very old</i>, <i>very aged</i>,
				 <i><span class="en">Liv.
					29, 29, 6</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">lapis,</span>”
				 <i><span class="en">Vulg. Josue, 24, 26</span></i>
			.</div>
