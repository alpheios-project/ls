    <div class="alpheios-lex-entry" lemma-id="n50466" body-key=""><b><span class="alpheios-lex-la" lang="lat">ventrĭcŭlus</span></b>  (collat. form
			<b><span class="alpheios-lex-la" lang="lat">ventrĭ-cŭlum</span></b> , i,
		n., <i><span class="en">Cassiod. in Psa. 150, 5</span></i>),
			i, m.
		dim.
		venter, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>the belly.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, Aug. ap. Suet. Vit. Aug.; <i><span class="en">Juv. 3,
			97</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<i>The stomach</i>, <i><span class="en">Cels. 4, 1,
				12</span></i>; <i><span class="en">5, 26,
			16</span></i>; <i><span class="en">Plin. 11, 37, 79, §
			200</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			Cordis, <i>a ventricle</i> of the heart, <i><span class="en">Cic. N.
				D. 2, 55, 138</span></i>.</div>
