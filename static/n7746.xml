    <div class="alpheios-lex-entry" lemma-id="n7746" body-key=""><b><span class="alpheios-lex-la" lang="lat">chăristĭa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">car-</span></b> ), ōrum,
			n., = <span class="alpheios-lex-greek" lang="grc">χαρίστεια</span> or
			<span class="alpheios-lex-greek" lang="grc">χαριστήρια</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an annual family repast made three
				days after the Parentalia</i>, <i>on the 20th of
				February; a family banquet</i>, <i>at which
				existing family feuds were settled</i>, <i><span class="en">Ov. F. 2,
				617 sq.</span></i>; <i><span class="en">Val. Max. 2, 1, 8</span></i>; cf. <i><span class="en">Mart. 9,
				56, 1</span></i>.</div>
