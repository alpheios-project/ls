    <div class="alpheios-lex-entry" lemma-id="n1563" body-key=""><b><span class="alpheios-lex-la" lang="lat">ag-gŭberno</span></b>  (<b><span class="alpheios-lex-la" lang="lat">adg-</span></b> ), āre,
