    <div class="alpheios-lex-entry" lemma-id="n47932" body-key=""><b><span class="alpheios-lex-la" lang="lat">tersus</span></b> , ūs, m.
		tergeo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a wiping off</i>, <i>cleansing</i>
			(Appuleian): 
				“<span class="alpheios-lex-la" lang="lat">lintea tersui profer,</span>”
				 <i><span class="en">App. M. 1, p. 113, 2</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">tersui dentium petere aliquid,</span>”
				i.e. <i>for tooth-powder</i>,
				 <i><span class="en">id. Mag. p. 277, 2</span></i>
			.</div>
