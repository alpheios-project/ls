    <div class="alpheios-lex-entry" lemma-id="n8947" body-key=""><b><span class="alpheios-lex-la" lang="lat">cŏ-haeresco</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-hēresco</span></b> ), si,
