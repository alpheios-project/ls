    <div class="alpheios-lex-entry" lemma-id="n42206" body-key=""><b><span class="alpheios-lex-la" lang="lat">Sadala</span></b> , ae, m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A king of Thrace</i> (perh. <i>the
				father of Cotys</i>), <i><span class="en">Cic. Verr. 2, 1, 24, § 63</span></i>; v.
			Zumpt <i>N. cr.;</i>
			<i><span class="en">Luc. 5,
			54</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A son of Cotys</i>, <i>king of
			Thrace</i>, <i><span class="en">Caes. B. C. 3, 4</span></i>.</div>
