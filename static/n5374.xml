    <div class="alpheios-lex-entry" lemma-id="n5374" body-key=""><b><span class="alpheios-lex-la" lang="lat">bĭpālĭum</span></b> ,
		ii, n.
		bis-pala, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a double mattock</i>: 
				“<span class="alpheios-lex-la" lang="lat">solum ad bipalium defodere,</span>”
				 <i><span class="en">Col.
					11, 2, 17</span></i>
			 Schneid. ad loc. (MSS. <b><span class="alpheios-lex-la" lang="lat">bĭpĕdā-lĭum</span></b> ;
			elsewhere only in <i>abl. sing.</i>): 
				“<span class="alpheios-lex-la" lang="lat">bipalio vertere terram,</span>”
				 <i><span class="en">Cato, R. R. 6, 3</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">bipalio agrum subigere,</span>”
				 <i><span class="en">id. ib. 45, 1</span></i>
			; <i><span class="en">Varr. R. R. 1, 37, 5</span></i>; <i><span class="en">Col. 3, 5,
			3</span></i>; <i><span class="en">11, 3,
			11</span></i>; <i><span class="en">id. Arb. 1, 5</span></i>; <i><span class="en">Plin. 17,
				21, 35, § 159</span></i>; <i><span class="en">18, 26, 62, §
			230</span></i>.</div>
