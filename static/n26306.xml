    <div class="alpheios-lex-entry" lemma-id="n26306" body-key=""><b><span class="alpheios-lex-la" lang="lat">lē^pra</span></b> , ae, f.,
		= <span class="alpheios-lex-greek" lang="grc">λέπρα</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the leprosy</i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Sing.</i> (late Lat.): 
				“<span class="alpheios-lex-la" lang="lat">plaga leprae,</span>”
				 <i><span class="en">Vulg. Lev. 13, 9 al.</span></i>
			; <i><span class="en">Scrib. Comp. 250</span></i>;
				<i><span class="en">Juvenc.
			1</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Plur.</i>: <b><span class="alpheios-lex-la" lang="lat">leprae</span></b> , ārum (class.): 
				“<span class="alpheios-lex-la" lang="lat">lepras sedare,</span>”
				 <i><span class="en">Plin.
					24, 8, 33, § 48</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">curare,</span>”
				 <i><span class="en">id.
					20, 21, 86, § 234</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">emendare,</span>”
				 <i><span class="en">id.
					22, 25, 74, § 156</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">sanare,</span>”
				 <i><span class="en">id.
					32, 9, 31, § 97</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">tollere,</span>”
				 <i><span class="en">id.
					20, 17, 70, § 181</span></i>
			.</div>
