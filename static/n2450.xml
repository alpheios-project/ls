    <div class="alpheios-lex-entry" lemma-id="n2450" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ănāpis</span></b> , is, or
			<b><span class="alpheios-lex-la" lang="lat">-us</span></b> , i, m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Brother of Amphinomus</i>, q.
			v.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A river in Sicily</i>, <i>which
				empties into the bay of Syracuse</i>, now <i>Anapo</i> or <i>Fiume di Sortino</i>, <i><span class="en">Ov. M. 5,
				417</span></i>; <i><span class="en">id. F. 4, 469</span></i>.</div>
