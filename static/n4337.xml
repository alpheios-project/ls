    <div class="alpheios-lex-entry" lemma-id="n4337" body-key=""><b><span class="alpheios-lex-la" lang="lat">attĕnŭātĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">adt-</span></b> ),
			ōnis, f.
		attenuo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a diminishing</i>, <i>lessening</i>
