    <div class="alpheios-lex-entry" lemma-id="n20325" body-key=""><b><span class="alpheios-lex-la" lang="lat">hĕdĕrācĕus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">ĕd-</span></b> ) or <b><span class="alpheios-lex-la" lang="lat">-ĭus</span></b> , a,
		um, adj.
		hedera, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of ivy</i>, <i>ivy-.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">materia,</span>”
				 <i><span class="en">Cato, R. R. 111</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">folia,</span>”
				 <i><span class="en">Plin.
					16, 24, 38, § 92</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>ivy-colored</i>,
				<i>ivygreen</i>: 
				“<span class="alpheios-lex-la" lang="lat">calcei,</span>”
				 <i><span class="en">Vop. Aurel. 49</span></i>
			: patina argentea, Gallien. ap. Treb. Poll.
					<i><span class="en">Claud. 17, 5</span></i> Peter.</div>
