<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n24289" body-key=""><b><span class="alpheios-lex-la" lang="lat">intĕrĭtus</span></b> ,
			ūs, m.
		intereo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>destruction</i>, <i>ruin</i>, <i>annihilation</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">interitus est quasi discessus et secretio, ac
					diremptio earum rerum, quae junctione aliqua tenebantur,</span>”
				 <i><span class="en">Cic.
					Tusc. 1, 29</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">omnium rerum interitus atque obitus,</span>”
				 <i><span class="en">id.
					Div. 2, 16, 37</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">legum,</span>”
				 <i><span class="en">id. Cat.
					3, 8</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">exercitus,</span>”
				 <i><span class="en">id.
					Div. 1, 32</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">pravitatis,</span>”
				 <i><span class="en">id. Fin.
					2, 9</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">immaturus,</span>”
				i. e. <i>death</i>,
				 <i><span class="en">id. Brut. 33</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">tuum ingemuisse interitum,</span>”
				 <i><span class="en">Verg.
					E. 5, 28</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vitae,</span>”
				 <i><span class="en">Gell.
					15, 1</span></i>
			.</div>
