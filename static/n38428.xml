    <div class="alpheios-lex-entry" lemma-id="n38428" body-key=""><b><span class="alpheios-lex-la" lang="lat">prŏcācĭtas</span></b> ,
			ātis, f.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>boldness</i>, <i>shamelessness</i>, <i>impudence</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">itaque a petendo petulantia, a procando, id est
					poscendo, procacitas nominata est,</span>”
				 <i><span class="en">Cic.
					Rep. 4, 6, 19</span></i>
			 (ap. <i><span class="en">Non. 23, 19</span></i>): 
				“<span class="alpheios-lex-la" lang="lat">procacitatem alicujus coërcere,</span>”
				 <i><span class="en">Nep.
					Timol. 5, 2</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">procacitatis et petulantiae certamen,</span>”
				 <i><span class="en">Tac. H.
					3, 11</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">lepida,</span>”
				 <i><span class="en">Mart. 2, 41, 17</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">galli gallinacei,</span>”
				<i>lechery</i>,
				 <i><span class="en">Col.
					8, 2, 15</span></i>
			.</div>
