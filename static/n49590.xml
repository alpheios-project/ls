    <div class="alpheios-lex-entry" lemma-id="n49590" body-key=""><b><span class="alpheios-lex-la" lang="lat">tyrannĭcus</span></b> , a,
		um, adj., = <span class="alpheios-lex-greek" lang="grc">τυραννικός</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>tyrannous</i>, <i>tyrannical</i>: 
				“<span class="alpheios-lex-la" lang="lat">tetrum facinus, crudele, nefarium, tyrannicum,</span>”
				 <i><span class="en">Auct. Her. 2, 30, 49</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">leges,</span>”
				 <i><span class="en">Cic.
					Leg. 1, 15, 42</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ira,</span>”
				 <i><span class="en">Sen. Ben. 1, 11, 2</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">crudelitas,</span>”
				 <i><span class="en">Just. 16, 4, 11</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">dominatio,</span>”
				 <i><span class="en">id.
					16, 4, 16</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vitia,</span>”
				 <i><span class="en">id.
					21, 5, 9</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">regia et paene tyrannica facere,</span>”
				 <i><span class="en">Eutr. 6, 25</span></i>
			.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">tyrannĭcē</span></b> , <i>tyrannically</i>: 
				“<span class="alpheios-lex-la" lang="lat">ea quae regie seu potius tyrannice statnit,</span>”
				 <i><span class="en">Cic. Verr. 2, 3, 48, § 115</span></i>
			.</div>
