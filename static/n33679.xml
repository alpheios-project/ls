    <div class="alpheios-lex-entry" lemma-id="n33679" body-key=""><b><span class="alpheios-lex-la" lang="lat">pantăgăthus</span></b> ,
		i, m., = <span class="alpheios-lex-greek" lang="grc">πανταγαθός</span> (all good). <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A bird of good omen</i>,
				<i><span class="en">Lampr. Anton. Diadum. 4 <i>fin.</i></span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A plant</i>, <i>also called</i>
			pulegium, <i><span class="en">App. Herb. 92</span></i>.</div>
