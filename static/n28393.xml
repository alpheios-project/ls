    <div class="alpheios-lex-entry" lemma-id="n28393" body-key=""><b><span class="alpheios-lex-la" lang="lat">Mĕgăbyzus</span></b> , i,
			m., = <span class="alpheios-lex-greek" lang="grc">Μεγάβυζος</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A priest of Diana at Ephesus</i>, <i><span class="en">Plin. 35,
				10, 36, § 93</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>One of Darius's generals</i>, <i><span class="en">Just. 7, 3,
				7</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>The name of a Persian eunuch</i>, <i><span class="en">Quint. 5,
				12, 21</span></i>.</div>
