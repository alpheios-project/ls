    <div class="alpheios-lex-entry" lemma-id="n4948" body-key=""><b><span class="alpheios-lex-la" lang="lat">barbātŭlus</span></b> , a,
		um, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>adj.
				dim.</i> [barbatus], <i>having a small</i> or <i>foppish beard</i>: 
				“<span class="alpheios-lex-la" lang="lat">concursabant barbatuli juvenes,</span>”
				 <i><span class="en">Cic.
					Att. 1, 14, 5</span></i>
			; <i><span class="en">1, 16, 10</span></i>; <i><span class="en">Hier. Ep.
			117</span></i>, n. 6 and 10.— <b>Transf.</b>
			to fishes: 
				“<span class="alpheios-lex-la" lang="lat">barbatuli mulli,</span>”
				 <i><span class="en">Cic.
					Par. 5, 2, 38</span></i>
			.</div>
