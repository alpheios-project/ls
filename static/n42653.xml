    <div class="alpheios-lex-entry" lemma-id="n42653" body-key=""><b><span class="alpheios-lex-la" lang="lat">Sarpēdōn</span></b> ,
			ŏnis, m., = <span class="alpheios-lex-greek" lang="grc">Σαρπηδών</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a son of Jupiter and Europa</i>, <i>king of Lycia</i>, <i>who was killed
				by Patroclus before Troy</i>, <i><span class="en">Hyg. Fab.
				106</span></i>; <i><span class="en">112</span></i>;
				<i><span class="en">Verg.
				A. 1, 100</span></i>; <i><span class="en">Serv. 9, 697</span></i>;
				<i><span class="en">10, 471</span></i>; <i><span class="en">Ov. M. 13, 255</span></i>; <i><span class="en">Cic. Div.
				2, 10, 25</span></i>; Gr. acc. Sarpedona, <i><span class="en">Gell. 15,
				21, 1</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A promontory in Cilicia</i>, now <i>Lissan el Kahpe</i>, <i><span class="en">Liv. 38,
				38, 9</span></i>; <i><span class="en">Mel. 1, 13, 5</span></i>; <i><span class="en">Plin. 5, 27,
				22, § 92</span></i>.</div>
