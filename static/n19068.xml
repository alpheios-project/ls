    <div class="alpheios-lex-entry" lemma-id="n19068" body-key=""><b><span class="alpheios-lex-la" lang="lat">fungōsus</span></b> , a, um, adj.
		fungus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of holes</i>, <i>spongy</i>, <i>fungous</i>: 
				“<span class="alpheios-lex-la" lang="lat">medulla,</span>”
				 <i><span class="en">Col.
					4, 29, 6</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">raphanus,</span>”
				 <i><span class="en">Plin.
					19, 5, 26, § 83</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">caro,</span>”
				 <i><span class="en">id.
					16, 6, 8, § 25</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">lingua,</span>”
				 <i><span class="en">id.
					23, 1, 24, § 49</span></i>
			.— <i>Comp.</i>: 
				“<span class="alpheios-lex-la" lang="lat">harundo,</span>”
				 <i><span class="en">Plin.
					16, 36, 64, § 137</span></i>
			.— <i>Sup.</i> and adv. do
			not occur.</div>
