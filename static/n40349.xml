    <div class="alpheios-lex-entry" lemma-id="n40349" body-key=""><b><span class="alpheios-lex-la" lang="lat">rădĭŏlus</span></b> ,
		i, m.
		dim.
		radius. * <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A small</i>, <i>feeble sunbeam</i>,
					<i><span class="en">Amm. 28, 4,
			18</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A kind of long olive</i>, <i><span class="en">Col. 12,
				49, 2</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>A plant resembling fern</i>,
				<i><span class="en">App. Herb. 83</span></i>.</div>
