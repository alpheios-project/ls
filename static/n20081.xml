    <div class="alpheios-lex-entry" lemma-id="n20081" body-key=""><b><span class="alpheios-lex-la" lang="lat">hăbĭtābĭlis</span></b> ,
		e, adj.
		habito, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>habitable.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b> (class.): 
				“<span class="alpheios-lex-la" lang="lat">regiones,</span>”
				 <i><span class="en">Cic.
					Tusc. 1, 20, 45</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cinguli (terrae),</span>”
				 <i><span class="en">id.
					Rep. 6, 20</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">media plaga (terrae),</span>”
				 <i><span class="en">Ov. M.
					1, 49</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">orae,</span>”
				 <i><span class="en">Hor.
					C. 4, 14, 5</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">caelum,</span>”
				 <i><span class="en">Ov. F.
					4, 611</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">non habitabile frigus,</span>”
				 <i><span class="en">id.
					Tr. 3, 4, 51</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Poet.</b> transf., <i>inhabited</i>: 
				“<span class="alpheios-lex-la" lang="lat">Tarpeiae rupes Superisque habitabile saxum,</span>”
				 <i><span class="en">Sil.
					1, 541</span></i>
			.</div>
