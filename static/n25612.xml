    <div class="alpheios-lex-entry" lemma-id="n25612" body-key=""><b><span class="alpheios-lex-la" lang="lat">lăcuscŭlus</span></b> , i,
			m.
		dim.
		lacus. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A little lake</i> (only in Columella), <i><span class="en">Col. 4, 8,
			2</span></i>; <i><span class="en">id. Arb. 10,
			4</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A receptacle</i> or <i>bin for keeping
				olives</i>, <i><span class="en">Col. 12, 50, 3 sq.</span></i></div>
