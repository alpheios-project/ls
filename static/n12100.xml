    <div class="alpheios-lex-entry" lemma-id="n12100" body-key=""><b><span class="alpheios-lex-la" lang="lat">cybĭum</span></b>  or <b><span class="alpheios-lex-la" lang="lat">-ĭon</span></b> , ii, n.,
		= <span class="alpheios-lex-greek" lang="grc">κύβιον</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A tunny-fish</i>, <i><span class="en">Varr. L. L. 5, § 77</span></i>
			Müll.; <i><span class="en">Mart. 11, 27, 3</span></i>; cf. Paul. ex <i><span class="en">Fest.
				p. 52, 15</span></i> Müll.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Meton.</b>, <i>a dish made of
				pieces of the tunny-fish salted and chopped</i>, <i><span class="en">Plin. 9, 15,
				18, § 48</span></i>; <i><span class="en">32, 11, 53, §
			151</span></i>; <i><span class="en">Mart. 5, 79, 3</span></i>.</div>
