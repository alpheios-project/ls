    <div class="alpheios-lex-entry" lemma-id="n19014" body-key=""><b><span class="alpheios-lex-la" lang="lat">fūmĕus</span></b> , a, um,
			adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of smoke</i>, <i>smoky</i>, <i>smoking</i>: 
				“<span class="alpheios-lex-la" lang="lat">lumina taedis,</span>”
				 <i><span class="en">Verg.
					A. 6, 593</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">flatus,</span>”
				 <i><span class="en">Macr. S. 7, 10</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Acheron,</span>”
				 <i><span class="en">Val.
					Fl. 4, 595</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vina Massiliae,</span>”
				<i>ripened by smoke</i>,
				 <i><span class="en">Mart.
					13, 123</span></i>
			 (cf. fumarium).</div>
