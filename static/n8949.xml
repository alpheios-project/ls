    <div class="alpheios-lex-entry" lemma-id="n8949" body-key=""><b><span class="alpheios-lex-la" lang="lat">cŏ-hēres</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-haeres</span></b> ),
		ēdis, comm., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a coheir</i>, <i>fellow-heir</i>, <i><span class="en">Cic. Verr. 2, 1, 48, § 127</span></i>;
				<i><span class="en">id.
				Fam. 13, 46 <i>init.</i></span></i>; <i><span class="en">7, 2,
			1</span></i>; <i><span class="en">Quint. 5, 14, 16</span></i>.— <i>Gen. plur.</i> coheredum, <i><span class="en">Hor. S. 2,
				5, 107</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">esse coheres alicui,</span>”
				 <i><span class="en">id. ib. 2, 5, 54</span></i>
			; <i><span class="en">Petr. 76, 2</span></i>.— In the
				<i>fem.</i>, <i><span class="en">Dig. 34,
				9, 16</span></i>.</div>
