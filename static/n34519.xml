    <div class="alpheios-lex-entry" lemma-id="n34519" body-key=""><b><span class="alpheios-lex-la" lang="lat">pennĭger</span></b> , ĕra,
			ĕrum, adj., or <b><span class="alpheios-lex-la" lang="lat">pinnĭ-ger</span></b> 
		penna-gero, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>feathered</i>, <i>winged.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b> (class.): 
				“<span class="alpheios-lex-la" lang="lat">genus animantium,</span>”
				 <i><span class="en">Cic. Univ. 10</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">pinniger rex apum,</span>”
				 <i><span class="en">Plin.
					11, 16, 16, § 48</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b> (<b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">sagittae,</span>”
				 <i><span class="en">Sil.
					3, 375</span></i>
			.</div>
