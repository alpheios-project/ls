    <div class="alpheios-lex-entry" lemma-id="n6311" body-key=""><b><span class="alpheios-lex-la" lang="lat">Callon</span></b> , ōnis, m., =
			<span class="alpheios-lex-greek" lang="grc">Κάλλων</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A statuary of Ægina</i>, <i><span class="en">Quint. 12,
				10, 7</span></i>.—<i>Plur.</i>: 
				“<span class="alpheios-lex-la" lang="lat">Callones,</span>”
				i. e. <i>people like Callon</i>,
				 <i><span class="en">Quint. 12, 10, 10</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A statuary of Elis</i>, <i>who
				flourished about</i> 430 B. C., <i><span class="en">Plin. 34, 8,
				19, § 49</span></i>.</div>
