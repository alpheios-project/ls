				 <i><span class="en">id. 5,
				1</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">iter,</span>”
				 <i><span class="en">id. 9,
				4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">annum lunari computatione,</span>”
				 <i><span class="en">Sol. 1, 37</span></i>
			.</div>
