    <div class="alpheios-lex-entry" lemma-id="n24014" body-key=""><b><span class="alpheios-lex-la" lang="lat">in -sŭāvis</span></b> , e,
			adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unpleasant</i>, <i>disagreeable</i>
			(class.): 
				“<span class="alpheios-lex-la" lang="lat">herba cibo non insuavis,</span>”
				 <i><span class="en">Plin.
					24, 16, 97, § 154</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vita,</span>”
				 <i><span class="en">Cic.
					Att. 10, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">voces,</span>”
				 <i><span class="en">Gell.
					18, 11</span></i>
			.— <i>Comp.</i>: 
				“<span class="alpheios-lex-la" lang="lat">quid insuavius quam clamor?</span>”
				 <i><span class="en">Auct. Her. 3, 12</span></i>
			.—<i>Sup.</i>: 
				“<span class="alpheios-lex-la" lang="lat">insuavissima littera,</span>”
				 <i><span class="en">Cic.
					Or. 49, 163</span></i>
			.</div>
