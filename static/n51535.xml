    <div class="alpheios-lex-entry" lemma-id="n51535" body-key=""><b><span class="alpheios-lex-la" lang="lat">Zĕphyrus</span></b> , i,
			m., = <span class="alpheios-lex-greek" lang="grc">Ζέφυρος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a gentle west
			wind</i>, <i>the western breeze</i>, <i>zephyr</i> (pure Lat. Favonius); personified, <i>son of Astrœus</i>
			
			<i>and Aurora.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i><span class="en">Plin. 18,
				34, 77, § 337</span></i>; <i><span class="en">Hor. C. 3,
				1, 24</span></i>; <i><span class="en">4, 7, 9</span></i>; <i><span class="en">id.
				Ep. 1, 7, 13</span></i>; <i><span class="en">Verg. G. 1, 44</span></i>; <i><span class="en">id. A. 4,
				223</span></i>; <i><span class="en">Ov. M. 1, 64</span></i>; <i><span class="en">1, 108</span></i>; cf.
				<i><span class="en">Sen. Q. N. 5, 16,
			5</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Poet.</b>, in gen., <i>wind</i>,
				<i><span class="en">Verg.
				A. 4, 562</span></i>.</div>
