    <div class="alpheios-lex-entry" lemma-id="n29704" body-key=""><b><span class="alpheios-lex-la" lang="lat">mōrĭo</span></b> ,
		ōnis, m., = <span class="alpheios-lex-greek" lang="grc">μωρός</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an arrant fool</i> (post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">quidam tantae sunt fatuitatis, ut non multum a
					pecoribus differant: quos moriones vulgo vocant,</span>”
				 <i><span class="en">Aug.
					Ep. 26</span></i>
			; <i><span class="en">Plin. Ep. 9, 17, 1 sq.</span></i>; <i><span class="en">Mart. 8,
			13</span></i>; <i><span class="en">14, 210</span></i>
			<i>in lemm.</i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>a monster, deformed
				person</i>, <i><span class="en">Mart. 6, 39, 17</span></i>.</div>
