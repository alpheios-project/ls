    <div class="alpheios-lex-entry" lemma-id="n40204" body-key=""><b><span class="alpheios-lex-la" lang="lat">quinquĭens</span></b> , adv.
		quinque, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>five times</i>: 
				“<span class="alpheios-lex-la" lang="lat">quinquiens quinque numerare,</span>”
				 <i><span class="en">Cato, R. R. 156</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">absolutus est,</span>”
				 <i><span class="en">Cic.
					Phil. 11, 5, 11</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">quinquiens miliens,</span>”
				<i>five thousand</i>,
				 <i><span class="en">Plin.
					2, 23, 21, § 85</span></i>
			.</div>
