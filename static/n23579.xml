    <div class="alpheios-lex-entry" lemma-id="n23579" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-nŭmĕrābĭlis</span></b> ,
			e, adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>countless</i>, <i>innumerable</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">mundi,</span>”
				 <i><span class="en">Cic. Ac. 2, 17, 55</span></i>
			; <i><span class="en">1, 10, 25</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">atomi,</span>”
				 <i><span class="en">id.
					N. D. 1, 20, 54</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">homines,</span>”
				 <i><span class="en">id.
					de Or. 2, 38, 142</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">pecunia,</span>”
				 <i><span class="en">id. Quint. 11, 37</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">series annorum,</span>”
				 <i><span class="en">Hor.
					C. 3, 30, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">numerus annorum,</span>”
				 <i><span class="en">Gell. 14, 1, 18</span></i>
			.— <b>
				<i>Absol.</i>
			</b>: 
				“<span class="alpheios-lex-la" lang="lat">reperiam multos vel innumerabiles potius
					quibus, etc.,</span>”
				 <i><span class="en">Cic.
					Fin. 2, 9, 28</span></i>
			; <i><span class="en">Quint. 12, 2, 30</span></i>; cf. 
				“<span class="alpheios-lex-la" lang="lat">innumerabilia,</span>”
				 <i><span class="en">id. 3,
					4, 2</span></i>
			; <i><span class="en">12, 1,
				45</span></i>.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">innŭmĕrābĭlĭter</span></b> ,
				<i>innumerably</i>, <i><span class="en">Lucr. 5,
			274</span></i>; <i><span class="en">Cic. de Or. 3, 52, 201</span></i>; <i><span class="en">id. Div. 1,
				14 <i>fin.</i></span></i></div>
