    <div class="alpheios-lex-entry" lemma-id="n21903" body-key=""><b><span class="alpheios-lex-la" lang="lat">impervĭus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inp-</span></b> ), a, um,
			adj.
		2. inpervius, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>that cannot be passed through</i>, <i>impassable</i>, <i>impervious</i> (<b>poet.</b> and in post-Aug. prose; cf.: 
				“<span class="alpheios-lex-la" lang="lat">inaccessus, invius): amnis,</span>”
				 <i><span class="en">Ov. M.
					9, 106</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">iter,</span>”
				 <i><span class="en">Quint. 12, 11, 11</span></i>
			; cf. 
				“<span class="alpheios-lex-la" lang="lat">itinera (with interrupta),</span>”
				 <i><span class="en">Tac. A.
					3, 31</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">tellus,</span>”
				<i>inaccessible</i>,
				 <i><span class="en">Val.
					Fl. 2, 643</span></i>
			.— <b>Transf.</b>: 
				“<span class="alpheios-lex-la" lang="lat">lapis ignibus,</span>”
				 <i><span class="en">Tac.
					A. 15, 43</span></i>
			.</div>
