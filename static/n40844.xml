    <div class="alpheios-lex-entry" lemma-id="n40844" body-key=""><b><span class="alpheios-lex-la" lang="lat">rē^frīgĕrātĭo</span></b> ,
			ōnis, f.
		refrigero. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i>a cooling</i>, <i>coolness</i>: refrigeratio aestate, * <i><span class="en">Cic. Sen.
				14, 46</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">aurae,</span>”
				 <i><span class="en">Col.
					11, 1, 16</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">caeli,</span>”
				 <i><span class="en">Vitr.
					6, 1, 3</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>a mitigation</i>
			of diseases, <i><span class="en">Veg. 5, 56, 1</span></i>. 
			</div>
