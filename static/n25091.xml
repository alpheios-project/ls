    <div class="alpheios-lex-entry" lemma-id="n25091" body-key=""><b><span class="alpheios-lex-la" lang="lat">istīus-mŏdi</span></b>  (also separately
			<b><span class="alpheios-lex-la" lang="lat">istīus
		mŏdi</span></b> , <b><span class="alpheios-lex-la" lang="lat">istīmŏdi</span></b> , <i><span class="en">Plaut. Truc. 5,
			38</span></i>), <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of
				that kind</i>, <i>such</i>: 
				“<span class="alpheios-lex-la" lang="lat">istius modi amicos,</span>”
				 <i><span class="en">Plaut. Ep. 1, 2, 16</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">istius modi clientes,</span>”
				 <i><span class="en">id.
					Most. 3, 2, 59</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cum istius modi virtutibus,</span>”
				 <i><span class="en">id.
					Rud. 2, 2, 15</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vos esse istius modi,</span>”
				 <i><span class="en">Ter.
					Heaut. 2, 4, 7</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">istiusmodi ratio,</span>”
				 <i><span class="en">Cic.
					Verr. 1, 11, 33</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">nihil istiusmodi,</span>”
				 <i><span class="en">id. ib. 2, 4, 5</span></i>
			, § 9.</div>
