    <div class="alpheios-lex-entry" lemma-id="n31242" body-key=""><b><span class="alpheios-lex-la" lang="lat">nōtor</span></b>  (collat. form ‡ <b><span class="alpheios-lex-la" lang="lat">nōtos</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
				v.
				infra
			), ōris, m.
			nosco, <i>one who knows</i> a person or
			thing, <i>a voucher, witness</i>, = cognitor
			(postAug.): 
				“<span class="alpheios-lex-la" lang="lat">qui notorem dat ignotus est,</span>”
				 <i><span class="en">Sen. Ep. 39, 1</span></i>
			; <i><span class="en">Petr. 92</span></i>; Sen. Apoc. <i>med.</i>; 
				“<span class="alpheios-lex-la" lang="lat">NOTOS (i. e. notor) ADVENISTI,</span>”
				 <i><span class="en">Inscr. Orell. 4957</span></i>
			.</div>
