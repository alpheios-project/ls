    <div class="alpheios-lex-entry" lemma-id="n36846" body-key=""><b><span class="alpheios-lex-la" lang="lat">pŏlītor</span></b> ,
		ōris, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>one who furbishes</i> or <i>polishes</i>, <i>a polisher.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: gemmarum, Firm. Math. 4, 7 <i>fin.</i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>a cultivator</i>,
				<i>improver</i>: 
				“<span class="alpheios-lex-la" lang="lat">agri,</span>”
				 <i><span class="en">Cato, R. R. 5, 136</span></i>
			; <i><span class="en">Dig. 17, 2, 52</span></i>.</div>
