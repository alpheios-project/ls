    <div class="alpheios-lex-entry" lemma-id="n50346" body-key=""><b><span class="alpheios-lex-la" lang="lat">vēlĭfĭco</span></b> ,
			āre (<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>act.</i> collat. form of velificor), <i>to sail</i>, <i>make sail</i>: 
				“<span class="alpheios-lex-la" lang="lat">nauta per urbanas velificabat aquas,</span>”
				 <i><span class="en">Prop.
				4</span></i>
			 (5), 9, 6: 
				“<span class="alpheios-lex-la" lang="lat">per summa aequora,</span>”
				 <i><span class="en">Plin.
					9, 33, 52, § 103</span></i>
			; <i><span class="en">9, 29, 47,
				§ 88</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">erectis capitibus,</span>”
				 <i><span class="en">id. 8,
					13, 13, § 35</span></i>
			.— <i>Pass.</i>: 
				“<span class="alpheios-lex-la" lang="lat">velificatus Athōs,</span>”
				<i>sailed through</i>,
				 <i><span class="en">Juv.
					10, 174</span></i>
			.</div>
