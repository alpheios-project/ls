    <div class="alpheios-lex-entry" lemma-id="n16285" body-key=""><b><span class="alpheios-lex-la" lang="lat">ĕtēsius</span></b> , a, um,
			adj., = <span class="alpheios-lex-greek" lang="grc">ἐτήσιος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>yearly.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b> Prop.: 
				“<span class="alpheios-lex-la" lang="lat">flabra aquilonum = etesiae,</span>”
				 <i><span class="en">Lucr.
					5, 742</span></i>
			; <i><span class="en">6, 730</span></i> Munro
			ad loc.; cf. <i><span class="en">id. 6, 715</span></i>
			sqq.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>: 
				“<span class="alpheios-lex-la" lang="lat">lapis,</span>”
				<i>a kind of stone</i>,
				 <i><span class="en">Plin.
					36, 22, 43, § 157</span></i>
			.</div>
