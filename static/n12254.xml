    <div class="alpheios-lex-entry" lemma-id="n12254" body-key=""><b><span class="alpheios-lex-la" lang="lat">dactylĭŏthēca</span></b> ,
			ae, f., = <span class="alpheios-lex-greek" lang="grc">δακτυλιοθήκη</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>1.</b>
			<i>A casket to keep rings in</i>, <i><span class="en">Mart. 11,
				59, 4</span></i>; <i><span class="en">14,
			123</span></i>, <i>title</i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<b>Transf.</b>, <i>a collection of
				seal-rings and jewels</i>, <i><span class="en">Plin. 37, 1,
				5, § 11</span></i>; Caesaris, Murat. Inscr. 907, 3.</div>
