    <div class="alpheios-lex-entry" lemma-id="n8611" body-key=""><b><span class="alpheios-lex-la" lang="lat">Clīnĭas</span></b> , ae,
			m., = <span class="alpheios-lex-greek" lang="grc">Κλεινίας</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>The father of Alcibiades</i>, <i><span class="en">Nep.
				Alcib. 1</span></i>; hence, the latter is called <b><span class="alpheios-lex-la" lang="lat">Clīnĭădes</span></b> ,
				<i><span class="en">Ov. Ib.
				635</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A Cretan</i>, <i><span class="en">Cic. Leg.
				1, 5, 15</span></i>.</div>
