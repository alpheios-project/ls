    <div class="alpheios-lex-entry" lemma-id="n49530" body-key=""><b><span class="alpheios-lex-la" lang="lat">tūtāmen</span></b> ,
		ĭnis, n.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				means of defence</i>, <i>defence</i>, <i>protection</i> (<b>poet.</b> and
			postclass.): 
				“<span class="alpheios-lex-la" lang="lat">(lorica) decus et tutamen in armis,</span>”
				 <i><span class="en">Verg.
					A. 5, 262</span></i>
			.—<i>Plur.</i>: 
				“<span class="alpheios-lex-la" lang="lat">domorum aut vestium,</span>”
				 <i><span class="en">Arn. 2, 71</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">deposcimus rebus fessis,</span>”
				 <i><span class="en">id. 1, 15</span></i>
			.</div>
