    <div class="alpheios-lex-entry" lemma-id="n29510" body-key=""><b><span class="alpheios-lex-la" lang="lat">mōly</span></b> , yos,
			n., = <span class="alpheios-lex-greek" lang="grc">μῶλυ</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A plant with a white flower and a black root</i>,
				<i><span class="en">Plin.
				25, 4, 8, § 26</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Another plant, a kind of nightshade</i>, <i><span class="en">Plin. 21,
				31, 105, § 180</span></i>.</div>
