    <div class="alpheios-lex-entry" lemma-id="n21833" body-key=""><b><span class="alpheios-lex-la" lang="lat">impĕdītĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inp-</span></b> ),
			ōnis, f.
		impedio, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a hinderance</i>, <i>obstruction</i>
			(rare but class.): 
				“<span class="alpheios-lex-la" lang="lat">sine impeditione praeterire,</span>”
				 <i><span class="en">Vitr. 1,
					5</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">animus in somniis liber est sensibus et omni
					impeditione curarum, etc.,</span>”
				 <i><span class="en">Cic. Div. 1, 51, 115</span></i>
			; <i><span class="en">Arn. 2, 52</span></i>.</div>
