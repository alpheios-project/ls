    <div class="alpheios-lex-entry" lemma-id="n17919" body-key=""><b><span class="alpheios-lex-la" lang="lat">fĕnestella</span></b> , ae, f.
		dim.
		fenestra, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a small opening in the wall</i>, <i>a
				little window.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b> Prop., <i><span class="en">Col. 1, 6,
				10</span></i>; <i><span class="en">8, 3,
			3</span></i>; <i><span class="en">9, 5,
			3</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b><span class="alpheios-lex-la" lang="lat">Fenestella</span></b> , ae,
				<i>nom. propr.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<i>Fem.</i>: 
				“<span class="alpheios-lex-la" lang="lat">Porta,</span>”
				<i>a gate in Rome</i>,
				 <i><span class="en">Ov. F.
					6, 578</span></i>
			; cf. Becker's Antiq. 1, p. 175.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<i>Masc.</i>, L., <i>a Roman historian
				under Augustus and Tiberius</i>, <i><span class="en">Plin. 8, 48,
				74, § 195</span></i>; <i><span class="en">Gell.
				15, 28, 4 al.</span></i></div>
