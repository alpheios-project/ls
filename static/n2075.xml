    <div class="alpheios-lex-entry" lemma-id="n2075" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ăluntĭum</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Hal-</span></b> ), i,
		n., = <span class="alpheios-lex-greek" lang="grc">Ἀλούντιον</span>, Dion.
		Hal., <span class="alpheios-lex-greek" lang="grc">Ἀλόντιον</span> Ptol., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a town in the northern
				part of Sicily</i>, <i>not far from the
			coast</i>, now <i>S. Filadelpho</i>, <i><span class="en">Plin. 3, 8,
				14, § 90</span></i>; cf. Mann. Ital. 2,
			410.—Hence, <b><span class="alpheios-lex-la" lang="lat">Ăluntīnus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Hal-</span></b> ), a, um,
				adj., <i>of Aluntium</i>: 
				“<span class="alpheios-lex-la" lang="lat">civitas,</span>”
				 <i><span class="en">Cic.
					Verr. 2, 3, 43</span></i>
			.</div>
