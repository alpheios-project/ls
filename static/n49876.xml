    <div class="alpheios-lex-entry" lemma-id="n49876" body-key=""><b><span class="alpheios-lex-la" lang="lat">upŭpa</span></b> , ae, f.
		
			<span class="alpheios-lex-greek" lang="grc">ἔποψ</span>
		. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i>a hoopoe</i>, <i><span class="en">Plin. 10,
				29, 44, § 86</span></i>; <i><span class="en">10, 25, 36, §
			73</span></i>; <i><span class="en">Varr. L. L. 5, § 75</span></i>
			Müll.; cf. epops.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>a kind of hoe</i>
			or <i>mattock</i>, <i><span class="en">Plaut. Capt.
				5, 4, 7</span></i>.</div>
