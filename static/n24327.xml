    <div class="alpheios-lex-entry" lemma-id="n24327" body-key=""><b><span class="alpheios-lex-la" lang="lat">inter-menstrŭus</span></b> , a, um,
			adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>between two months</i>: 
				“<span class="alpheios-lex-la" lang="lat">lunā intermenstruā,</span>”
				i. e. <i>at the time of new moon</i>,
				 <i><span class="en">Plin.
					18, 32, 75, § 322</span></i>
			.—<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">intermenstrŭum</span></b> , i. n.
			(sc. tempus), <i>the new moon</i>, <i>time of new moon</i>, <i><span class="en">Varr.
				R. R. 1, 37, 1</span></i>; <i><span class="en">Cic. Rep.
				1, 16, 25</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">tempore intermenstrui,</span>”
				 <i><span class="en">Amm. 20, 3, 11</span></i>
			.</div>
