    <div class="alpheios-lex-entry" lemma-id="n7658" body-key=""><b><span class="alpheios-lex-la" lang="lat">Chaerĕas</span></b> , ae,
		m., = <span class="alpheios-lex-greek" lang="grc">Χαιρέας</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>a Grecian proper name.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A writer on husbandry</i>, <i><span class="en">Varr.
				R. R. 1, 1, 8</span></i>; <i><span class="en">Col. 1, 1, 8</span></i>; <i><span class="en">Plin. 20,
				23, 99, § 263</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A sculptor of the time of Alexander the Great</i>,
				<i><span class="en">Plin.
				34, 8, 19, § 75</span></i>; <i><span class="en">Vitr. 10,
				13, 3</span></i>.</div>
