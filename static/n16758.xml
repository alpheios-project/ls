    <div class="alpheios-lex-entry" lemma-id="n16758" body-key=""><b><span class="alpheios-lex-la" lang="lat">excūsābĭlis</span></b>  (<b><span class="alpheios-lex-la" lang="lat">excuss-</span></b> ),
		e, adj.
		excuso, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>that may be excused</i>, <i>excusable</i> (very rare; 
				“<span class="alpheios-lex-la" lang="lat">not in Cic.): delicti pars,</span>”
				 <i><span class="en">Ov.
					P. 1, 7, 41</span></i>
			.—<i>Comp.</i>: 
				“<span class="alpheios-lex-la" lang="lat">error,</span>”
				 <i><span class="en">Val.
					Max. 8, 11, 4</span></i>
			.— <i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">excūsābĭlĭter</span></b> ,
				<i>excusably</i>, <i><span class="en">Alcim.
				Avit. Homil. Fragm. 2</span></i>.—<i>Comp.</i>: 
				“<span class="alpheios-lex-la" lang="lat">excusabilius peccat,</span>”
				 <i><span class="en">Aug. Trin. 17, 15 <i>fin.</i></span></i>
			</div>
