    <div class="alpheios-lex-entry" lemma-id="n11490" body-key=""><b><span class="alpheios-lex-la" lang="lat">Crătes</span></b> , is,
		m., = <span class="alpheios-lex-greek" lang="grc">Κράτης</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a Greek proper
			name</i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A Theban philosopher</i>,
				<i><span class="en">App. Mag. p. 26</span></i> Bip.;
