    <div class="alpheios-lex-entry" lemma-id="n46432" body-key=""><b><span class="alpheios-lex-la" lang="lat">sufflātĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">subfl-</span></b> ),
		ōnis, f.
		sufflo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a blowing</i> or <i>puffing up</i>,
				<i>inflation</i> (Plinian): 
				“<span class="alpheios-lex-la" lang="lat">bullantium aquarum,</span>”
				 <i><span class="en">Plin.
					9, 7, 6, § 18</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">praedurum est sufflatione viventibus,</span>”
				 <i><span class="en">id. 9,
					29, 46, § 86</span></i>
			.</div>
