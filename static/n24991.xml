    <div class="alpheios-lex-entry" lemma-id="n24991" body-key=""><b><span class="alpheios-lex-la" lang="lat">irrītāmen</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inr-</span></b> ),
		ĭnis, n.
		1. irrito, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an incitement</i>, <i>incentive</i>,
				<i>provocative</i> (<b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">opes, animi inritamen avari,</span>”
				 <i><span class="en">Ov.
					M. 13, 434</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">amoris,</span>”
				 <i><span class="en">id.
					ib. 9, 133</span></i>
			.—In plur.: 
				“<span class="alpheios-lex-la" lang="lat">cum (taurus) sua terribili petit inritamina
					cornu Poeniceas vestis,</span>”
				 <i><span class="en">Ov.
					M. 12, 103</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">corporis,</span>”
				 <i><span class="en">Prud. Ham. 523</span></i>
			.</div>
