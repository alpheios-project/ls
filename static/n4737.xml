<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n4737" body-key=""><b><span class="alpheios-lex-la" lang="lat">axĭcŭlus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">assĭc-</span></b> ), i,
			m.
		dim.
		axis. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A small axle-tree</i>, <i><span class="en">Vitr. 10,
			14</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<i>A pin</i>, <i><span class="en">Vitr. 10,
			21</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<i>A small beam</i> or <i>pole</i>,
				<i><span class="en">Col.
				6, 19, 2</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>C.</b>
			<i>A small board</i> or <i>plank</i>,
					<i><span class="en">Amm. 21, 2</span></i>; <i><span class="en">16,
			8</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
