    <div class="alpheios-lex-entry" lemma-id="n36943" body-key=""><b><span class="alpheios-lex-la" lang="lat">Pŏlyphēmus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-os</span></b> ), i,
			m., = <span class="alpheios-lex-greek" lang="grc">Πολύφημος</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>The one-eyed Cyclops in Sicily</i>, <i>son of Neptune</i>, <i>who was blinded by
			Ulysses</i>, <i><span class="en">Cic. Tusc. 5, 39, 115</span></i>; <i><span class="en">Ov. M. 13,
				772</span></i>; <i><span class="en">14, 167</span></i>; <i><span class="en">Mart. 4,
				49, 6</span></i>; <i><span class="en">Juv. 14, 20</span></i>; <i><span class="en">9, 64</span></i>; <i><span class="en">Hyg. Fab.
				125</span></i>; cf. <i><span class="en">Verg. A. 3, 618
			sq.</span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>One of the Argonauts</i>, <i><span class="en">Hyg. Fab.
				14</span></i>.</div>
