    <div class="alpheios-lex-entry" lemma-id="n29345" body-key=""><b><span class="alpheios-lex-la" lang="lat">Mnestheus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">dissyl.</span></b> ), ĕi and
