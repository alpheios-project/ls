    <div class="alpheios-lex-entry" lemma-id="n36770" body-key=""><b><span class="alpheios-lex-la" lang="lat">pŏdā^gra</span></b> , ae,
			f., = <span class="alpheios-lex-greek" lang="grc">ποδάγρα</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the gout in the
			feet</i>: 
				“<span class="alpheios-lex-la" lang="lat">doloribus podagrae cruciari,</span>”
				 <i><span class="en">Cic.
					Tusc. 2, 19, 45</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cum arderet podagrae doloribus,</span>”
				 <i><span class="en">id.
					Fin. 5, 31, 94</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">nodosa,</span>”
				 <i><span class="en">Ov.
					P. 1, 3, 23</span></i>
			; cf. <i><span class="en">Plin. 26, 10, 64, § 100</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">locuples,</span>”
				 <i><span class="en">Juv.
					13, 96</span></i>
			.—In plur., <i><span class="en">Cels. 5,
			18</span></i>.</div>
