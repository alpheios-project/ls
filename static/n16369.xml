    <div class="alpheios-lex-entry" lemma-id="n16369" body-key=""><b><span class="alpheios-lex-la" lang="lat">Euphrānor</span></b> ,
		ŏris, m., = <span class="alpheios-lex-greek" lang="grc">Εὐφράνωρ</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A celebrated painter and sculptor</i>, <i>a contemporary of Praxiteles</i>, <i><span class="en">Quint. 12,
				10, 6</span></i>; <i><span class="en">12</span></i>;
				<i><span class="en">Plin.
				34, 8, 19, § 50</span></i>; <i><span class="en">35, 11, 40, §
			128</span></i>; <i><span class="en">Juv. 3, 217</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>An architect</i>, <i><span class="en">Vitr. 7,
			14</span></i>.</div>
