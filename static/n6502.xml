    <div class="alpheios-lex-entry" lemma-id="n6502" body-key=""><b><span class="alpheios-lex-la" lang="lat">Caninĕfātes</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Cannin-</span></b> ), um,
		m., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				people dwelling upon the Batavian peninsula</i>, <i><span class="en">Vell. 2,
			105</span></i>; <i><span class="en">Tac. H. 4, 15</span></i>; <i><span class="en">4, 32</span></i>;
				<i><span class="en">4, 56</span></i>; 4, 79; 4, 85; also called <b><span class="alpheios-lex-la" lang="lat">Cannĕnĕfātes</span></b> , <i><span class="en">Plin. 4, 15,
				29, § 101</span></i>; and <b><span class="alpheios-lex-la" lang="lat">Cannunĕfā-tes</span></b> , <i><span class="en">Inscr.
					Orell. 96</span></i>.—In
			sing.: 
				“<span class="alpheios-lex-la" lang="lat">dux natione Caninefas,</span>”
				 <i><span class="en">Tac.
					A. 11, 18</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Adj.</i>: <b><span class="alpheios-lex-la" lang="lat">Caninĕfas</span></b> , ātis, <i>of Caninefas</i>: 
				“<span class="alpheios-lex-la" lang="lat">ala,</span>”
				 <i><span class="en">Tac. A.
					4, 73</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">tumultus,</span>”
				 <i><span class="en">id. H.
					4, 16</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cohortes,</span>”
				 <i><span class="en">id. ib. 4, 19</span></i>
			 al.</div>
