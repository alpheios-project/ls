    <div class="alpheios-lex-entry" lemma-id="n32227" body-key=""><b><span class="alpheios-lex-la" lang="lat">octŭplus</span></b> , a, um,
			adj., = <span class="alpheios-lex-greek" lang="grc">ὀκταπλοῦς</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>eightfold</i>,
				<i>octuple</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">pars,</span>”
				 <i><span class="en">Cic.
					Univ. 7, 20</span></i>
			.—<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">octŭplum</span></b> , i,
			n., <i>the eightfold penalty</i>, <i>the octuple</i>: 
				“<span class="alpheios-lex-la" lang="lat">damnare aliquem octupli,</span>”
				 <i><span class="en">Cic. Verr. 2, 3, 11, § 28</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">poena octupli,</span>”
				 <i><span class="en">id. ib.</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">judicium in octuplum,</span>”
				 <i><span class="en">id. ib.</span></i>
			</div>
