    <div class="alpheios-lex-entry" lemma-id="n45162" body-key=""><b><span class="alpheios-lex-la" lang="lat">spurcĭtĭa</span></b> , ae
			(nom. collat. form <b><span class="alpheios-lex-la" lang="lat">spur-cĭtĭes</span></b> , <i><span class="en">Lucr. 6,
		977</span></i>; abl. spurcitie, <i><span class="en">App. M.
			8, p. 214, 33</span></i>), f.
		spurcus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>filth</i>, <i>dirt</i>, <i>smut</i>, <i>dung</i> (rare; not in
			Cic.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i><span class="en">Col. 1, 5,
			8</span></i>; <i><span class="en">12, 17,
			2</span></i>; <i><span class="en">Plin. 33, 4, 21, § 69</span></i>;
				plur., <i><span class="en">Varr. R. R. 3, 16, 17</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">spurcitias suum laudant,</span>”
				 <i><span class="en">Plin.
					17, 9, 6, § 52</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>: alicujus, Afran. ap.
					<i><span class="en">Non. 393, 33</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">patris,</span>”
				 <i><span class="en">id. ib. 394, 4</span></i>
			.</div>
