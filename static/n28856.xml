    <div class="alpheios-lex-entry" lemma-id="n28856" body-key=""><b><span class="alpheios-lex-la" lang="lat">mĕsŏchŏrus</span></b> ,
			i, m., = <span class="alpheios-lex-greek" lang="grc">μεσόχορος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>one who stands in the middle of a chorus</i> (of
			dancers or singers) <i>to lead it, a chorusleader</i>
			(post-class.): 
				“<span class="alpheios-lex-la" lang="lat">cum mesochorus dedit signum,</span>”
				 <i><span class="en">Plin.
					Ep. 2, 14, 7</span></i>
			; <i><span class="en">Sid. Ep. 1, 2</span></i>; Schol. <i><span class="en">Juv. 11,
				172</span></i>.</div>
