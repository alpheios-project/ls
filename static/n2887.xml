    <div class="alpheios-lex-entry" lemma-id="n2887" body-key=""><b><span class="alpheios-lex-la" lang="lat">Antĭphōn</span></b> ,
			ōntis, m., = <span class="alpheios-lex-greek" lang="grc">Ἀντιφῶν</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A renowned sophist of Rhamnus</i>, <i>a contemporary of Socrates</i>, <i><span class="en">Cic. Brut.
				12, 47</span></i>; <i><span class="en">Quint. 3, 1, 11</span></i>; <i><span class="en">12, 10,
			22</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>The name of an interpreter of dreams</i>, <i><span class="en">Cic. Div. 1,
				20</span></i>; <i><span class="en">1, 51</span></i>.</div>
