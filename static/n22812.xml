    <div class="alpheios-lex-entry" lemma-id="n22812" body-key=""><b><span class="alpheios-lex-la" lang="lat">indignābundus</span></b> , a, um,
			adj.
		indignor, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of indignation</i>, <i>enraged</i>, <i>indignant</i> (not ante-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">illa muliebriter indignabunda,</span>”
				 <i><span class="en">Liv.
					38, 57, 7</span></i>
			; 
				“<span class="alpheios-lex-la" lang="lat">with clamitans,</span>”
				 <i><span class="en">Suet. Aug. 40</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">animo irritato, indignabundus,</span>”
				 <i><span class="en">Gell.
					19, 9, 8</span></i>
			.</div>
