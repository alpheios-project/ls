    <div class="alpheios-lex-entry" lemma-id="n6038" body-key=""><b><span class="alpheios-lex-la" lang="lat">caelĭtus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">coel-</span></b> ), adv.
		caelum. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>From heaven</i> (late Lat. for divinitus or caelo)
			omnia quae caelitus mortalibus exhibentur,
				<i><span class="en">App. Dogm. Plat. 1, p. 8, 31</span></i>;
					<i><span class="en">Lact. 4, 2 <i>fin.</i></span></i>; <i><span class="en">4, 28</span></i>; <i><span class="en">Amm.
				23, 6, 34</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>from the
			emperor</i>, Cod. Th. 6, 32, 2; 10, 20, 16.</div>
