    <div class="alpheios-lex-entry" lemma-id="n25349" body-key=""><b><span class="alpheios-lex-la" lang="lat">juncus</span></b> , i, m., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a rush</i>.
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">murteta juncis circumvincire,</span>”
				 <i><span class="en">Plaut. Rud. 3, 4, 27</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">palustres,</span>”
				 <i><span class="en">Ov. M.
					8, 336</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">acutā cuspide junci,</span>”
				 <i><span class="en">id.
					ib. 4, 299</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A twig resembling a rush</i>, <i><span class="en">Plin. 26, 8,
				46, § 72</span></i>.</div>
