    <div class="alpheios-lex-entry" lemma-id="n21687" body-key=""><b><span class="alpheios-lex-la" lang="lat">immĕdĭtātus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inm-</span></b> ), a,
