    <div class="alpheios-lex-entry" lemma-id="n16972" body-key=""><b><span class="alpheios-lex-la" lang="lat">exōtĭcus</span></b> , a,
		um, adj., = <span class="alpheios-lex-greek" lang="grc">ἐξωτικός</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>foreign</i>, <i>exotic</i> (ante- and
			post-class.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Adj.</i>: 
				“<span class="alpheios-lex-la" lang="lat">unguenta,</span>”
				 <i><span class="en">Plaut. Most. 1, 1, 41</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vinum,</span>”
				 <i><span class="en">Gell.
					13, 5, 5</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">jus (piscium),</span>”
				 <i><span class="en">App. M. 10, p. 246, 28</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">pulvis,</span>”
				 <i><span class="en">id. Mag. p. 278, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">sermo,</span>”
				 <i><span class="en">id. Met. 1 <i>init.</i></span></i>
			—Comically: 
				“<span class="alpheios-lex-la" lang="lat">Graecia, i. q. magna,</span>”
				 <i><span class="en">Plaut. Men. 2, 1, 11</span></i>
			.—* </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">exōtĭcum</span></b> , i,
			n., <i>a foreign garment</i>, <i><span class="en">Plaut. Ep.
				2, 2, 48</span></i>.</div>
