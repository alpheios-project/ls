    <div class="alpheios-lex-entry" lemma-id="n21775" body-key=""><b><span class="alpheios-lex-la" lang="lat">immūnītus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inm-</span></b> ), a, um,
			adj.
		2. in-munitus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unfortified</i>, <i>undefended</i>
			(rare but class.): 
				“<span class="alpheios-lex-la" lang="lat">oppida castellaque,</span>”
				 <i><span class="en">Liv.
					22, 11, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Sparte,</span>”
				 <i><span class="en">Ov.
					M. 10, 169</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">inermes atque immuniti abscondimus,</span>”
				 <i><span class="en">App. M. 8, p. 202 <i>fin.</i></span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">via,</span>”
				i. e. <i>not properly made</i>, <i>impassable</i>,
				 <i><span class="en">Cic.
					Caecin. 19, 54</span></i>
			.</div>
