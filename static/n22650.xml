    <div class="alpheios-lex-entry" lemma-id="n22650" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-cunctans</span></b> , antis, adj.,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>not
			delaying</i>, <i>unhesitating</i> (eccl. Lat.): 
				“<span class="alpheios-lex-la" lang="lat">fides,</span>”
				 <i><span class="en">Paul. Petr. Vit. S. Mart. 5, 233</span></i>
			.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">in-cunctan-ter</span></b>  (<b><span class="alpheios-lex-la" lang="lat">incont-</span></b> ), <i>without delay</i>,
				<i>unhesitatingly</i> (post-class.); 
				“<span class="alpheios-lex-la" lang="lat">with fortiter,</span>”
				 <i><span class="en">Lact. 6, 12</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">fateri,</span>”
				 <i><span class="en">id. 1, 15, 26</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">incunctanter et liberius respondere,</span>”
				 <i><span class="en">App. M. 9, p. 234, 5</span></i>
			; <i><span class="en">Dig. 40, 2, 20 al.</span></i></div>
