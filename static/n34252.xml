    <div class="alpheios-lex-entry" lemma-id="n34252" body-key=""><b><span class="alpheios-lex-la" lang="lat">paxillus</span></b> , i, m., =
			<span class="alpheios-lex-greek" lang="grc">πάσσαλος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a small stake</i>, <i>a peg.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, Varr. ap. <i><span class="en">Non.
				153, 9</span></i>; <i><span class="en">Col. 4, 16, 3</span></i>; <i><span class="en">8, 8, 3</span></i>: 
