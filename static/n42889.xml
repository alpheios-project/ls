    <div class="alpheios-lex-entry" lemma-id="n42889" body-key=""><b><span class="alpheios-lex-la" lang="lat">scărīfātĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">scărīphātĭo</span></b> ; later
		collat. form <b><span class="alpheios-lex-la" lang="lat">scărīfĭcātĭo</span></b> ,
				<i><span class="en">Veg. 4, 21, 1</span></i>),
			ōnis, f.
		scarifo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a scratching open;</i> of the skin, <i>a scarifying</i>, <i><span class="en">Col. 6, 12, 1</span></i>; <i><span class="en">6, 17, 1</span></i>; <i><span class="en">6, 17, 4</span></i>;
