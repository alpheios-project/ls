    <div class="alpheios-lex-entry" lemma-id="n49016" body-key=""><b><span class="alpheios-lex-la" lang="lat">trīcēnārĭus</span></b> , a,
			um, adj.
		triceni, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>containing thirty</i>: 
				“<span class="alpheios-lex-la" lang="lat">fistula,</span>”
				<i>thirty quarterdigits in diameter</i>,
				 <i><span class="en">Front. Aquaed. 29</span></i>
			; <i><span class="en">48</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">filius,</span>”
				<i>thirty years old</i>,
				 <i><span class="en">Sen. Excerpt. Controv. 3, 3 <i>fin.</i></span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">homo,</span>”
				 <i><span class="en">Arn. 2, 58</span></i>
			; <i><span class="en">Pall. Aug. 12</span></i>; <i><span class="en">Front.
				Aquaed. 29</span></i>; <i><span class="en">48</span></i>.</div>
