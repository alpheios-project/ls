    <div class="alpheios-lex-entry" lemma-id="n2309" body-key=""><b><span class="alpheios-lex-la" lang="lat">ampĕlŏs</span></b> , i,
			f., = <span class="alpheios-lex-greek" lang="grc">ἄμπελος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a vine</i>, <i>grape-vine</i> (used technically; in pure Lat.
			vitis). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b> Ampelos agria,
				<i>wild vine</i> (in pure Lat. labrusca), <i><span class="en">Plin. 23, 1,
				14, § 19</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			 Ampelos chironia, <i>greasewort;</i> in
			pure Lat. vitis nigra or bryonia, <i><span class="en">Plin. 23, 1,
				17, § 27</span></i>; <i><span class="en">24, 4, 16, §
			34</span></i>.</div>
