    <div class="alpheios-lex-entry" lemma-id="n18264" body-key=""><b><span class="alpheios-lex-la" lang="lat">flābĭlis</span></b> , e,
			adj.
		flo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>airy.</i> * </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">nihil est in animis mixtum atque concretum ...
					nihil ne aut humidum quidem aut flabile aut igneum,</span>”
				 <i><span class="en">Cic.
					Tusc. 1, 27, 66</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b>Trop.</b>, <i>spiritual</i> (eccl.
			Lat.): aedes, Prud. <span class="alpheios-lex-greek" lang="grc">στεφ</span>. 10, 347
			al.</div>
