    <div class="alpheios-lex-entry" lemma-id="n26271" body-key=""><b><span class="alpheios-lex-la" lang="lat">Lĕōnĭdas</span></b> 
			(nom.
		<b><span class="alpheios-lex-la" lang="lat">Lĕōnĭda</span></b> , <i><span class="en">Just. 2, 11,
		2</span></i>), ae, m., = <span class="alpheios-lex-greek" lang="grc">Λεωνίδας</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A king of Sparta, who fell at
			Thermopylæ</i>, <i><span class="en">Cic. Fin.
				2, 30, 97</span></i>; <i><span class="en">2, 19, 62</span></i>; <i><span class="en">id. Tusc.
				1, 42, 101</span></i>; <i><span class="en">1, 49, 116</span></i>; <i><span class="en">Nep. Them.
			3</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>The name of a slave</i>, <i><span class="en">Plaut.
				As. 1, 1, 43 al.</span></i>; v. also Leonides.</div>
