    <div class="alpheios-lex-entry" lemma-id="n18882" body-key=""><b><span class="alpheios-lex-la" lang="lat">frūmentātor</span></b> ,
			ōris, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				provider of corn</i>, <i>purchaser of grain</i>:
			in Volscis frumentum ne emi quidem potuit; 
				“<span class="alpheios-lex-la" lang="lat">periculum ipsis frumentatoribus fuit,</span>”
				 <i><span class="en">Liv.
					2, 34, 4</span></i>
			.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Milit. t. t.</b>, <i>a forager</i>,
				<i><span class="en">Liv.
				31, 36, 8</span></i>; ib. § 9 al.</div>
