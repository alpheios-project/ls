    <div class="alpheios-lex-entry" lemma-id="n20048" body-key=""><b><span class="alpheios-lex-la" lang="lat">Gyas</span></b>  or <b><span class="alpheios-lex-la" lang="lat">Gyes</span></b> , ae, m., =
			<span class="alpheios-lex-greek" lang="grc">Γύης</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A giant with a hundred arms</i>, <i><span class="en">Hor. C. 2,
				17, 14</span></i>; <i><span class="en">Ov. Tr. 4, 7, 18</span></i>; <i><span class="en">id. F.
			593</span></i> (this the better read. inst. of
			Gyges).—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A companion of Æneas</i>, <i><span class="en">Verg. A. 1,
				222</span></i>; <i><span class="en">5, 118</span></i>; <i><span class="en">12, 460</span></i>.
			—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>A Latin</i>, <i>slain by
				Æneas</i>, <i><span class="en">Verg. A. 10, 318</span></i>.</div>
