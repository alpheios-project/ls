    <div class="alpheios-lex-entry" lemma-id="n35980" body-key=""><b><span class="alpheios-lex-la" lang="lat">phengītes</span></b> , ae,
		m., = <span class="alpheios-lex-greek" lang="grc">φεγγίτης</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>phengite</i>, <i>selenite</i>, or <i>erystallized
				gypsum</i>, used for window-panes: 
				“<span class="alpheios-lex-la" lang="lat">in Cappadociā repertus est lapis
					candidus, atque translucens, ex argumento phengites
					appellatus,</span>”
				 <i><span class="en">Plin.
					36, 22, 46, § 163</span></i>
			; 
				“<span class="alpheios-lex-la" lang="lat">lapis,</span>”
				 <i><span class="en">Suet. Dom. 14</span></i>
			.</div>
