    <div class="alpheios-lex-entry" lemma-id="n7037" body-key=""><b><span class="alpheios-lex-la" lang="lat">cătăgrăphus</span></b> ,
			a, um, adj., = <span class="alpheios-lex-greek" lang="grc">κατάγραφος</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Painted</i>, <i>colored</i>, <i>depicted</i>: 
				“<span class="alpheios-lex-la" lang="lat">Thyni,</span>”
				 <i><span class="en">Cat.
					25, 7</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">cătăgră-pha</span></b> ,
				ōrum, n., <i>profile paintings</i>, <i>side views</i> (pure
			Lat. obliquae imagines), <i><span class="en">Plin. 35, 8, 34, §
		56</span></i>.</div>
