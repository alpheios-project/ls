    <div class="alpheios-lex-entry" lemma-id="n31369" body-key=""><b><span class="alpheios-lex-la" lang="lat">nūgālis</span></b> , e,
			adj.
		nugae, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>frivolous, trifling, worthless, empty</i> (post-class.): 
				“<span class="alpheios-lex-la" lang="lat">theoremata,</span>”
				 <i><span class="en">Gell.
					1, 2, 6</span></i>
			; <i><span class="en">Mart. Cap. 1, § 2</span></i>
			Kopp (al. nugalas): 
				“<span class="alpheios-lex-la" lang="lat">scholica quaedam,</span>”
				 <i><span class="en">id. 4, 1, 1</span></i>
			; <i><span class="en">7, 17, 3</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">illa olim nugalia conscripsi,</span>”
				<i>trifles, bagatelles</i>,
				 <i><span class="en">Front. de Fer. Als. 3</span></i>
			 Mai.</div>
