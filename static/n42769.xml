    <div class="alpheios-lex-entry" lemma-id="n42769" body-key=""><b><span class="alpheios-lex-la" lang="lat">Saūroctŏnos</span></b> , i,
			m., = <span class="alpheios-lex-greek" lang="grc">Σαυροκτόνος,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the
			lizard-killer</i>, <i>an epithet of Apollo;</i>
			hence, Apollo Sauroctonos, <i>a statue by
			Praxiteles</i>, <i><span class="en">Plin. 34, 8, 19, § 70</span></i>; cf. 
				“<span class="alpheios-lex-la" lang="lat">Corinthius,</span>”
				 <i><span class="en">Mart.
					14, 172</span></i>
			
			<i>in lemm.</i></div>
