    <div class="alpheios-lex-entry" lemma-id="n1527" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ăgĕlastus</span></b> , i,
			m., = <span class="alpheios-lex-greek" lang="grc">ἀγέλαστος</span> (not
		laughing), <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a surname
				of M. Crassus</i>, <i>grandfather of the triumvir
				of the same name</i>, <i><span class="en">Plin. 7, 19, 18, § 79</span></i>; cf.
			Lucil. ap. <i><span class="en">Cic. Fin. 5, 30, 92</span></i>, and Tusc. 3, 15,
			31.</div>
