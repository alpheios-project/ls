    <div class="alpheios-lex-entry" lemma-id="n36992" body-key=""><b><span class="alpheios-lex-la" lang="lat">pōmus</span></b> , i, f.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i>a fruit-tree</i> of
			any kind (v. pomum <i>init.</i>), <i><span class="en">Tib. 2, 1,
				43</span></i>; <i><span class="en">Vulg. Cant. 5,
			1</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, for pomum, <i>fruit</i>, Cato ap. <i><span class="en">Plin. 15, 18, 20, §
		74</span></i>.</div>
