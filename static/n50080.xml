    <div class="alpheios-lex-entry" lemma-id="n50080" body-key=""><b><span class="alpheios-lex-la" lang="lat">vădōsus</span></b> , a, um,
			adj.
		vadum, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of shallows</i> or <i>fords</i>, <i>shallow</i>, <i>shoal</i>: 
				“<span class="alpheios-lex-la" lang="lat">mare,</span>”
				 <i><span class="en">Caes.
					B. C. 1, 25</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">amnis,</span>”
				 <i><span class="en">Verg.
					A. 7, 728</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Syrtes,</span>”
				 <i><span class="en">Sall. J. 78, 2</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ostium portūs,</span>”
				 <i><span class="en">Liv.
					37, 14, 7</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">fretum,</span>”
				 <i><span class="en">id.
					33, 17, 6</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">litora,</span>”
				 <i><span class="en">Val.
					Max. 8, 7</span></i>
			, ext. 1: 
				“<span class="alpheios-lex-la" lang="lat">navigatio,</span>”
				 <i><span class="en">Plin.
					6, 23, 26, § 99</span></i>
			.—<b>Poet.</b>: 
				“<span class="alpheios-lex-la" lang="lat">aquae,</span>”
				i. e. <i>restless</i>,
				 <i><span class="en">Luc.
					8, 698</span></i>
			.—<i>Sup.</i>: 
				“<span class="alpheios-lex-la" lang="lat">Ganges ubi vadosissimus est,</span>”
				 <i><span class="en">Sol. 52</span></i>
			.</div>
