    <div class="alpheios-lex-entry" lemma-id="n30044" body-key=""><b><span class="alpheios-lex-la" lang="lat">mūrĭcīdus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">murric-</span></b> ),
		i, m.
		perh. mus-caedo, mouse-killer, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a coward, poltroon</i>, as a term of
			abuse: 
				“<span class="alpheios-lex-la" lang="lat">vae tibi muricide homo,</span>”
				 <i><span class="en">Plaut. Ep. 3, 1, 12</span></i>
			; cf. Paul. ex <i><span class="en">Fest. p. 125</span></i> Müll.</div>
