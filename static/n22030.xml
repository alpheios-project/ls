    <div class="alpheios-lex-entry" lemma-id="n22030" body-key=""><b><span class="alpheios-lex-la" lang="lat">imprŏbātĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inpr-</span></b> ),
			ōnis, f.
		improbo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>disapprobation</i>, <i>blame</i>
			(very rare): 
				“<span class="alpheios-lex-la" lang="lat">haec et ad improbationem et approbationem
					testium pertinebunt,</span>”
				 <i><span class="en">Auct. Her. 2, 6, 9</span></i>
			; <i><span class="en">Cic. Verr. 2, 3, 74, §
			172</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">accusatoris erit, improbatione hominis uti,</span>”
				 <i><span class="en">id.
					Inv. 2, 10, 32</span></i>
			.</div>
