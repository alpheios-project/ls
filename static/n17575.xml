    <div class="alpheios-lex-entry" lemma-id="n17575" body-key=""><b><span class="alpheios-lex-la" lang="lat">faenĭ-sex</span></b>  (<b><span class="alpheios-lex-la" lang="lat">fēn-, foen-</span></b> ),
			ĕcis (<b><span class="alpheios-lex-la" lang="lat">faenĭ-sĕca</span></b> , ae, <i><span class="en">Pers. 6,
		40</span></i>), m.
		id.. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b> Prop., <i>a mower</i>, <i><span class="en">Varr.
				R. R. 1, 49, 2</span></i>; <i><span class="en">Col. 2, 17, 4</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">igitur cornu propter oleum ad crus ligato
					faenisex incedebat,</span>”
				 <i><span class="en">Plin.
					18, 28, 67, § 261</span></i>
			.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Meton.</b>, <b>poet.</b> for
				<i>countryman</i>, <i>rustic</i>,
				<i><span class="en">Pers.
				6, 40</span></i>.</div>
