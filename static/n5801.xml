    <div class="alpheios-lex-entry" lemma-id="n5801" body-key=""><b><span class="alpheios-lex-la" lang="lat">būcĭnātor</span></b>  (<b><span class="alpheios-lex-la" lang="lat">bucc-</span></b> ),
			ōris, m.
		bucino, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>one who blew the</i> bucina, <i>a trumpeter</i>,
					<i><span class="en">Caes. B.C. 2, 35</span></i>;
					<i><span class="en">Petr. 26, 9</span></i>; <i><span class="en">Varr. L. L. 6, § 75</span></i>; <i><span class="en">Dig. 50, 6,
				6</span></i>; <i><span class="en">Inscr. Orell.
			3522</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b> (cf. bucina, II. D.), <i>one who trumpets forth</i>, <i>blazes
			abroad</i>: bucinator existimationis meae, Cic. Fil. ap. <i><span class="en">Cic. Fam.
				16, 21, 2</span></i>; <i><span class="en">Inscr. Orell.
			3232</span></i>.</div>
