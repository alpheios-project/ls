    <div class="alpheios-lex-entry" lemma-id="n42752" body-key=""><b><span class="alpheios-lex-la" lang="lat">sătyrĭon</span></b> ,
			ii, n. (<b><span class="alpheios-lex-la" lang="lat">sătyrĭos</span></b> ,
		ii, f., <i><span class="en">Plin. 26, 10,
			62, § 96</span></i>), = <span class="alpheios-lex-greek" lang="grc">σατύριον,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a plant that
