    <div class="alpheios-lex-entry" lemma-id="n21258" body-key=""><b><span class="alpheios-lex-la" lang="lat">ĭambus</span></b> , i, m.,
		= <span class="alpheios-lex-greek" lang="grc">ἴαμβος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an iambic foot</i>, <i>an
				iambus.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i><span class="en">Hor. A. P. 251</span></i>; <i><span class="en">Cic. de
				Or. 3, 47, 182</span></i>; <i><span class="en">id. Or. 57, 192</span></i>; <i><span class="en">Quint. 9,
				4, 47</span></i>; <i><span class="en">48</span></i>;
				<i><span class="en">80</span></i>;
					<i><span class="en">Diom. p. 473</span></i> P. et
			saep.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>an iambic
			poem</i>, <i>iambic poetry</i>: 
				“<span class="alpheios-lex-la" lang="lat">quem Hipponactis iambus laeserat aut qui erat
					Archilochi versu vulneratus,</span>”
				 <i><span class="en">Cic.
					N. D. 3, 38, 91</span></i>
			; so in sing., <i><span class="en">Hor. A. P.
			79</span></i>; <i><span class="en">Quint. 10, 1, 96</span></i>.—In
				plur., <i><span class="en">Hor. C. 1,
				16, 3</span></i>; <i><span class="en">24</span></i>; <i><span class="en">id. Ep. 1,
				19, 23</span></i>; <i><span class="en">2, 2, 59</span></i>; <i><span class="en">Quint. 10,
				1, 9</span></i>; <i><span class="en">59</span></i>.</div>
