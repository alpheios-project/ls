    <div class="alpheios-lex-entry" lemma-id="n41130" body-key=""><b><span class="alpheios-lex-la" lang="lat">rĕnuntĭātor</span></b>  (<b><span class="alpheios-lex-la" lang="lat">rĕnunc-</span></b> ),
