    <div class="alpheios-lex-entry" lemma-id="n50381" body-key=""><b><span class="alpheios-lex-la" lang="lat">vēnābŭlum</span></b> ,
		i, n.
		venor, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>a huntingspear.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i><span class="en">Cic. Fam. 7,
				1, 3</span></i>; <i><span class="en">Verg. A. 4, 131</span></i>; <i><span class="en">Ov. H. 4,
			83</span></i>; <i><span class="en">id. M. 8, 419</span></i>; <i><span class="en">8, 404</span></i>;
				<i><span class="en">9, 205</span></i>; 10, 713; 12, 453; <i><span class="en">Mart. 14,
				31, 1</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>: sagittarum, <i>large
				spear-like arrows</i>, for killing elephants, <i><span class="en">Plin. 8, 8,
				8, § 26</span></i>.</div>
