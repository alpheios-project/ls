    <div class="alpheios-lex-entry" lemma-id="n22596" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-crēdŭlus</span></b> , a,
		um (perh. not anteAug.). <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Act.</i>, <i>unbelieving</i>, <i>incredulous</i>, <i>without
			faith</i>: odi. <i><span class="en">Hor. A. P. 188</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">patronus,</span>”
				 <i><span class="en">Quint. 12, 8, 11</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">quidam,</span>”
				 <i><span class="en">id.
					10, 3, 11</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Judaei,</span>”
				 <i><span class="en">Vulg. Act. 14, 2 al.</span></i>
			— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Pass.</i>, <i>incredible</i>: 
				“<span class="alpheios-lex-la" lang="lat">res,</span>”
				 <i><span class="en">Gell.
					9, 4, 3</span></i>
			.</div>
