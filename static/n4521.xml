    <div class="alpheios-lex-entry" lemma-id="n4521" body-key=""><b><span class="alpheios-lex-la" lang="lat">aulĭcus</span></b> , a, um,
		adj., = <span class="alpheios-lex-greek" lang="grc">αὐλικός [αὐλή]</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>belonging to a prince</i>'<i>s
			court</i>, <i>princely</i>: 
				“<span class="alpheios-lex-la" lang="lat">apparatus,</span>”
				 <i><span class="en">Suet. Dom. 4</span></i>
			; 
				“<span class="alpheios-lex-la" lang="lat">luctatores,</span>”
				 <i><span class="en">id. Ner. 45</span></i>
			.—Hence <i>subst.</i>: <b><span class="alpheios-lex-la" lang="lat">aulĭci</span></b> ,
				ōrum, m., <i>courtiers</i>, <i><span class="en">Nep. Dat. 5, 2</span></i>; <i><span class="en">Suet.
				Calig. 9</span></i>.</div>
