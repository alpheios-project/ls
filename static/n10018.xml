    <div class="alpheios-lex-entry" lemma-id="n10018" body-key=""><b><span class="alpheios-lex-la" lang="lat">condĭtīvus</span></b> , a,
		um, adj.
		condo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>suitable for laying up</i> or <i>preserving, laid
				up, preserved</i> (rare; 
				“<span class="alpheios-lex-la" lang="lat">not in Cic.): olea,</span>”
				 <i><span class="en">Cato, R. R. 6, 1</span></i>
			; <i><span class="en">Macr. S. 2, 16</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">mala,</span>”
				 <i><span class="en">Cato, R. R. 7, 3</span></i>
			; <i><span class="en">Varr. R. R. 1, 59, 1</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">cibi,</span>”
				 <i><span class="en">Col.
					7, 9, 9</span></i>
			; cf. also conditicius.—<i>Subst.</i>:
				<b><span class="alpheios-lex-la" lang="lat">condĭtīvum</span></b> , i,
			n., <i>a tomb</i>, <i><span class="en">Sen. Ep.
				60, 4</span></i>; <i><span class="en">82,
			2</span></i>; <i><span class="en">Inscr. Orell. 4511</span></i>.</div>
