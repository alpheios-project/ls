			: 
				“<span class="alpheios-lex-la" lang="lat">vertex (collis),</span>”
				 <i><span class="en">Verg.
					A. 8, 351</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ramus,</span>”
				 <i><span class="en">Ov. M.
					8, 410</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vitis,</span>”
				 <i><span class="en">Verg.
					E. 2, 70</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">aestas,</span>”
				 <i><span class="en">id. G.
					3, 296</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">taxus frondosior,</span>”
