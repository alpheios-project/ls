    <div class="alpheios-lex-entry" lemma-id="n20765" body-key=""><b><span class="alpheios-lex-la" lang="lat">hircīnus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">hirquīnus</span></b> ), a, um,
			adj.
		hircus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of a goat</i>, <i>goat's</i>: 
				“<span class="alpheios-lex-la" lang="lat">barba,</span>”
				 <i><span class="en">Plaut. Ps. 4, 2, 12</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">sanguis,</span>”
				 <i><span class="en">Plin.
				20</span></i>
			 prooem. § 2; 
				“<span class="alpheios-lex-la" lang="lat">37, 4, 15, § 59: pelles,</span>”
				 <i><span class="en">id.
					12, 17, 40, § 81</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">folles,</span>”
				 <i><span class="en">Hor.
					S. 1, 4, 19</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">sidus,</span>”
				i. e. <i>the constellation Capricorn</i>,
				 <i><span class="en">Prud. Apoth. 621</span></i>
			.—Comically: 
				“<span class="alpheios-lex-la" lang="lat">alae,</span>”
				<i>that have a goatish smell</i>,
				 <i><span class="en">Plaut. Poen. 4, 2, 51</span></i>
			.</div>
