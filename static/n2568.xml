    <div class="alpheios-lex-entry" lemma-id="n2568" body-key=""><b><span class="alpheios-lex-la" lang="lat">anguĭfer</span></b>  (<b><span class="alpheios-lex-la" lang="lat">trisyl.</span></b> ), fĕra,
		fĕrum, adj.
		anguis-fero, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>serpent-bearing</i>: 
				“<span class="alpheios-lex-la" lang="lat">caput,</span>”
				 <i><span class="en">Ov. M.
					4, 741</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Gorgo,</span>”
				 <i><span class="en">Prop.
					2, 2, 8</span></i>
			.—Hence, <i>subst.</i>: <b><span class="alpheios-lex-la" lang="lat">Anguĭfer</span></b> ,
				fĕri, m. (as transl. of
				<span class="alpheios-lex-greek" lang="grc">Ὀφιοῦχος</span>), <i>the serpent-bearer</i>, <i>the constellation
				Serpentarius</i> or <i>Ophiuchus</i>, <i><span class="en">Col. 11,
				2, 49</span></i>; cf. anguitenens.</div>
