    <div class="alpheios-lex-entry" lemma-id="n24915" body-key=""><b><span class="alpheios-lex-la" lang="lat">irrătĭōnālis</span></b> 
			(<b><span class="alpheios-lex-la" lang="lat">inr-</span></b> ),
		e, adj.
		2. in-rationalis, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>without reason</i>, <i>irrational</i>
			(postAug.): 
				“<span class="alpheios-lex-la" lang="lat">animal,</span>”
				 <i><span class="en">Quint.
					7, 3, 3</span></i>
			; <i><span class="en">24</span></i>; Sen. Ep.
				
			 113, 17; 118, 14; 
				“<span class="alpheios-lex-la" lang="lat">124, 23: usus,</span>”
				<i>mechanical exercises</i>,
				 <i><span class="en">Quint. 10, 7, 11</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">anima,</span>”
				 <i><span class="en">Tert. Poen. 12</span></i>
			.—<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">irrătĭōnālĭa</span></b> ,
				ĭum, n.
			plur., <i>things</i> or <i>creatures without reason</i>: 
				“<span class="alpheios-lex-la" lang="lat">de irrationalibus,</span>”
				 <i><span class="en">Quint. 8, 6, 13</span></i>
			.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">irră-tĭōnālĭter</span></b> ,
				<i>irrationally</i>, <i><span class="en">Tert.
				adv. Marc. 2, 6 al.</span></i></div>
