    <div class="alpheios-lex-entry" lemma-id="n7681" body-key=""><b><span class="alpheios-lex-la" lang="lat">chalcis</span></b> , ĭdis,
		f., = <span class="alpheios-lex-greek" lang="grc">χαλκίς</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A fish of the herring kind</i>, <i><span class="en">Col. 8,
				17, 12</span></i>; <i><span class="en">Plin. 9, 47, 71, § 154</span></i>;
				<i><span class="en">9, 51, 74, §
				162</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A lizard with copper-colored spots on its back</i>,
				<i><span class="en">Plin.
				32, 3, 13, § 30</span></i>; <i><span class="en">32, 5, 17, §
			46</span></i>.</div>
