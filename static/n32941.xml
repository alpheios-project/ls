    <div class="alpheios-lex-entry" lemma-id="n32941" body-key=""><b><span class="alpheios-lex-la" lang="lat">ordĭnātor</span></b> ,
			ōris, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an orderer</i>, 
			<i>regulator</i>, <i>arranger</i>
			(post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">litis,</span>”
				i. e. <i>pleader</i>,
				 <i><span class="en">Sen.
					Ep. 109</span></i>
			: omnium, Hilar. Trin. 4, 12, 14.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>An ordainer</i>, <i>one authorized to
				ordain</i>, <i><span class="en">Ambros. in 2</span></i> Tim. 4,
			13.</div>
