<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n25515" body-key=""><b><span class="alpheios-lex-la" lang="lat">lābrusca</span></b>  (<b><span class="alpheios-lex-la" lang="lat">ae</span></b> ) <b><span class="alpheios-lex-la" lang="lat">vītis</span></b>  or <b><span class="alpheios-lex-la" lang="lat">ūva</span></b> ; also <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>absol.</i>: <b><span class="alpheios-lex-la" lang="lat">lābrusca</span></b> , ae, f.,
				<i>the wild vine, claret-vine</i>: 
				“<span class="alpheios-lex-la" lang="lat">vitis labrusca, Linn.: uva labrusca,</span>”
				 <i><span class="en">Col. 8,
					5 <i>fin.</i></span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vitis labrusca,</span>”
				 <i><span class="en">Plin.
					12, 13, 28, § 48</span></i>
			.—<b>
				<i>Absol.</i>
			</b>: 
				“<span class="alpheios-lex-la" lang="lat">aspice ut antrum Sylvestris raris sparsit
					labrusca racemis,</span>”
				 <i><span class="en">Verg. E.
					5, 7</span></i>
			 Serv. ad loc.; <i><span class="en">Plin. 23, 1, 14, § 19</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">omphacium ... fit e labrusca, hoc est vite
					sylvestri, quod vocatur oenanthinum,</span>”
				 <i><span class="en">id.
					14, 16, 18, § 98</span></i>
			.</div>
