    <div class="alpheios-lex-entry" lemma-id="n19588" body-key=""><b><span class="alpheios-lex-la" lang="lat">glăbellus</span></b> , a, um, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>adj. dim.</i>
			[glaber], <i>without hair</i>, <i>smooth</i> (post-class.): 
				“<span class="alpheios-lex-la" lang="lat">corpus Cupidinis,</span>”
				 <i><span class="en">App. M. 5, p. 168, 28</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">feminal,</span>”
				 <i><span class="en">id. ib. 2</span></i>
			, p. 122, 11: 
				“<span class="alpheios-lex-la" lang="lat">Apollo corpore glabellus,</span>”
				 <i><span class="en">id. Flor. 1, p. 341</span></i>
			; <i><span class="en">Mart. Cap. 2, 34</span></i>.</div>
