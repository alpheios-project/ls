    <div class="alpheios-lex-entry" lemma-id="n21571" body-key=""><b><span class="alpheios-lex-la" lang="lat">illūmĭnātio</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inl-</span></b> ),
			ōnis, f.
		illumino, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a lighting up</i>, <i>enlightening</i> (post-class.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">solis,</span>”
				 <i><span class="en">Macr. S. 1, 18, § 13</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vultus tui,</span>”
				 <i><span class="en">Ambros. in Psa. 43, 12</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>: 
				“<span class="alpheios-lex-la" lang="lat">bonorum,</span>”
				 <i><span class="en">Tert. Adv. Herm. 15</span></i>
			.</div>
