    <div class="alpheios-lex-entry" lemma-id="n5845" body-key=""><b><span class="alpheios-lex-la" lang="lat">būmastus</span></b> , i (<b><span class="alpheios-lex-la" lang="lat">būmasta</span></b> , ae,
