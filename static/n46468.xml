<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n46468" body-key=""><b><span class="alpheios-lex-la" lang="lat">suf-fūmĭgo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">subf-</span></b> ), āre,
			v. a., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>to fumigate from below</i>, <i>to
				suffumigate</i>: 
				“<span class="alpheios-lex-la" lang="lat">si ex alvo apes minus frequentes evadunt,
					suffumigandum,</span>”
				 <i><span class="en">Varr. R. R. 3, 16, 6</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vulvam sulphure,</span>”
				 <i><span class="en">Cels.
					4, 20 <i>med.</i></span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vulnus,</span>”
				 <i><span class="en">id.
					5, 27, 5</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vasa rore marino vel lauro vel myrto,</span>”
				 <i><span class="en">Col.
					12, 25, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">dolia albā cerā,</span>”
				 <i><span class="en">id.
					12, 52, 16</span></i>
			.— <b>
				<i>Absol.</i>
			</b>: 
				“<span class="alpheios-lex-la" lang="lat">suffumigare expedit,</span>”
				 <i><span class="en">Cels.
					6, 6, 35</span></i>
			.</div>
