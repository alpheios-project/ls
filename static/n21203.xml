    <div class="alpheios-lex-entry" lemma-id="n21203" body-key=""><b><span class="alpheios-lex-la" lang="lat">hypocrĭsis</span></b> ,
		is, f., = <span class="alpheios-lex-greek" lang="grc">ὑπόκρισις</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an imitation of a person's speech and gestures</i>,
				<i>mimicry</i>, Don. Vit.
				<i><span class="en">Verg. 11</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>hypocrisy</i>, <i>pretended sanctity</i> (eccl. Lat.), = pietatis
			simulatio, <i><span class="en">Vulg. Matt. 23, 28</span></i>; <i><span class="en">id. Luc. 12,
				1</span></i>.</div>
