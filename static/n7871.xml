    <div class="alpheios-lex-entry" lemma-id="n7871" body-key=""><b><span class="alpheios-lex-la" lang="lat">chŏrĭambus</span></b> , i,
			m., = <span class="alpheios-lex-greek" lang="grc">χορίαμβος</span>, in
		verse, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a foot
				composed of a choreus and an
			iambus</i>,—˘˘—,
					<i><span class="en">Diom. p. 478</span></i> P.; Marc. Vict.
			p. 2490 ib. al.—<i>Adj.</i>: 
				“<span class="alpheios-lex-la" lang="lat">choriambum carmen,</span>”
				<i>consisting of the choriambus</i>,
				 <i><span class="en">Aus. Ep. 10, 37</span></i>
			.—Hence, <b><span class="alpheios-lex-la" lang="lat">chŏrĭambĭcus</span></b> , a,
				um, adj., <i>choriambic</i>: 
				“<span class="alpheios-lex-la" lang="lat">metrum,</span>”
				 <i><span class="en">Diom. p. 509</span></i>
			 P.; <i><span class="en">Serv. Centim. p. 1822</span></i> ib.: 
				“<span class="alpheios-lex-la" lang="lat">versus,</span>”
				 <i><span class="en">Sid. Ep. 9, 13</span></i>
			.</div>
