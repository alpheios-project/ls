    <div class="alpheios-lex-entry" lemma-id="n26216" body-key=""><b><span class="alpheios-lex-la" lang="lat">Lēnaeus</span></b> , a, um,
		adj., = <span class="alpheios-lex-greek" lang="grc">Ληναῖος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>Lenæan,
				Bacchic</i>: 
				“<span class="alpheios-lex-la" lang="lat">Lenaei latices,</span>”
				i. e. <i>wine</i>,
				 <i><span class="en">Verg.
					G. 3, 510</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">honorem libare,</span>”
				 <i><span class="en">id. A.
					4, 207</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Lenaea dona,</span>”
				 <i><span class="en">Stat.
					S. 4, 6, 80</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Lenaeus pater,</span>”
				i. e. <i>Bacchus</i>,
				 <i><span class="en">Verg. G.
					2, 7</span></i>
			; <i><span class="en">Ov.
				M. 4, 14</span></i>; <i><span class="en">11, 132</span></i>; and <i>absol.</i>: <b><span class="alpheios-lex-la" lang="lat">Lēnaeus</span></b> , i, m., <i>Bacchus</i>: 
				“<span class="alpheios-lex-la" lang="lat">te libans, Lenaee, vocat,</span>”
				 <i><span class="en">Verg.
					G. 2, 529</span></i>
			; <i><span class="en">Tib. 3, 6, 38</span></i>.</div>
