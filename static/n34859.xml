    <div class="alpheios-lex-entry" lemma-id="n34859" body-key=""><b><span class="alpheios-lex-la" lang="lat">pĕrendĭē</span></b> , adv.
		Gr. <span class="alpheios-lex-greek" lang="grc">πέραν</span>-dies, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>on the day after
				to-morrow</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">cras agito, perendie agito,</span>”
				 <i><span class="en">Plaut. Merc. 2, 3, 41</span></i>
			; <i><span class="en">id. Aul. 2, 1, 34</span></i>; <i><span class="en">id. Stich.
				4, 1, 12</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">scies igitur fortasse cras, summum perendie,</span>”
				 <i><span class="en">Cic.
					Att. 12, 44, 3</span></i>
			; <i><span class="en">id. Fam. 16, 17, 3</span></i>.</div>
