    <div class="alpheios-lex-entry" lemma-id="n35364" body-key=""><b><span class="alpheios-lex-la" lang="lat">perpĕtŭārĭus</span></b> ,
			a, um, adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>constant</i>, <i>permanent; always employed</i>,
				<i>constantly engaged</i> in any business or
			calling  (post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">mulio,</span>”
				 <i><span class="en">Sen. Apoc. 6, 2</span></i>
			.—<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">perpĕtŭārĭus</span></b> ,
				ii, m., <i>a
			fee-farmer</i>, <i>hereditary tenant</i>,
					<i><span class="en">Cod. Just. 11, 70, 5</span></i>.</div>
