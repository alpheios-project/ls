    <div class="alpheios-lex-entry" lemma-id="n51179" body-key=""><b><span class="alpheios-lex-la" lang="lat">vītĭlis</span></b> , e,
			adj.
		vieo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>platted</i>, <i>interwoven.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Adj.</i>: 
				“<span class="alpheios-lex-la" lang="lat">cola,</span>”
				 <i><span class="en">Cato, R. R. 11, 2</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">alvi apum,</span>”
				 <i><span class="en">Varr. R. R. 3, 16, 16</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cistae,</span>”
				 <i><span class="en">Plin.
					15, 17, 18, § 60</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">naves corio circumsutae,</span>”
				 <i><span class="en">id. 7,
					56, 57, § 206</span></i>
			 et saep.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">vītĭlia</span></b> ,
			ĭum, n., <i>things
				platted</i>, <i>wicker-work</i>, <i><span class="en">Plin. 13, 4,
				9, § 38</span></i>; <i><span class="en">21, 18, 69, §
			114</span></i>; <i><span class="en">24, 9, 38,
				§ 59</span></i>.</div>
