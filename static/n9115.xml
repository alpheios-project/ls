    <div class="alpheios-lex-entry" lemma-id="n9115" body-key=""><b><span class="alpheios-lex-la" lang="lat">collūsĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">conl-</span></b> ),
		ōnis, f.
		colludo, II., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a secret</i>, <i>deceptive
				understanding</i>, <i>collusion</i>, *
				<i><span class="en">Cic. Verr. 2, 3, 13, § 33</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">inter raptae patrem et raptorem,</span>”
				 <i><span class="en">Sen. Contr. 2, 11, 22</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">per collusionem,</span>”
				 <i><span class="en">id.
					ib. 5, 31</span></i>
			
			<i>fin.</i>: 
				“<span class="alpheios-lex-la" lang="lat">illa inter virum et uxorem nota collusio,</span>”
				 <i><span class="en">App. Mag. p. 322, 13</span></i>
			; <i><span class="en">Dig. 40, 16</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">de collusione detegendā,</span>”
				 <i><span class="en">ib. 40,
					4</span></i>
			; <i><span class="en">8, 5, 19</span></i>;
				<i><span class="en">17, 1, 8</span></i>; 12,
			2, 30, § 3.</div>
