    <div class="alpheios-lex-entry" lemma-id="n28547" body-key=""><b><span class="alpheios-lex-la" lang="lat">mellītŭlus</span></b> , a,
		um, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>adj.
				dim.</i> [mellitus], <i>honey-sweet, darling</i>
			(ante- and post-class.): 
				“<span class="alpheios-lex-la" lang="lat">corpusculum mellitulum! (al. melliculum),</span>”
				 <i><span class="en">Plaut. Cas. 4, 4, 19</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">puella,</span>”
				 <i><span class="en">Hier. Ep. 79, 6</span></i>
			. —<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">mellītŭla</span></b> ,
			ae, f., <i>little honey</i>: 
				“<span class="alpheios-lex-la" lang="lat">mea mellitula,</span>”
				 <i><span class="en">App. M. 3, 139, 3</span></i>
			.</div>
