    <div class="alpheios-lex-entry" lemma-id="n43029" body-key=""><b><span class="alpheios-lex-la" lang="lat">scŏlŏpendra</span></b> ,
		ae, f., = <span class="alpheios-lex-greek" lang="grc">σκολόπενδρα.</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
