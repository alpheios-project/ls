    <div class="alpheios-lex-entry" lemma-id="n7907" body-key=""><b><span class="alpheios-lex-la" lang="lat">chrȳsēlectrum</span></b> ,
		i, n., = <span class="alpheios-lex-greek" lang="grc">χρυσήλεκτρον</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Gold-colored amber</i>, <i>a precious
				stone</i>, <i><span class="en">Plin. 37, 3, 12, §
			51</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b><span class="alpheios-lex-la" lang="lat">chrȳsē-lectrus</span></b> , i,
				f., <i>a dark-yellow precious
			stone</i>, perh. <i>amber-colored hyacinth</i>, <i><span class="en">Plin. 37,
				9, 43, § 127</span></i>.</div>
