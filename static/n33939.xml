    <div class="alpheios-lex-entry" lemma-id="n33939" body-key=""><b><span class="alpheios-lex-la" lang="lat">Parthĕnĭas</span></b> ,
		ae, m., = <span class="alpheios-lex-greek" lang="grc">Παρθενίας</span> (maidish). <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>1.</b>
			<i>An epithet of Virgil</i>, <i>on
				account of the purity of his morals</i>, Serv. Verg. A. praef.;
					<i><span class="en">Aus. Idyll. 13 <i>fin.</i></span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>A river in Asia</i>, <i>a tributary of
				the Tigris</i>, <i><span class="en">Plin. 6, 27, 31, §
		129</span></i>.</div>
