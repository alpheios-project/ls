<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n28674" body-key=""><b><span class="alpheios-lex-la" lang="lat">Mĕnestheus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-steus</span></b> ), ei and eos,
			m., = <span class="alpheios-lex-greek" lang="grc">Μενεσθευς</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a man's name</i>.
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A son of Iphicrates the Athenian</i>, Nep. lphicr.
			3.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A king of the Athenians, a leader in the Trojan
			war</i>, <i><span class="en">Just. 2, 6</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>A charioteer of Diomedes</i>, <i><span class="en">Stat. Th. 6,
				661</span></i>; <i><span class="en">712</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>IV.</b> = Mnestheus, q. v.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
