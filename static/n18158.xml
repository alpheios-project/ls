    <div class="alpheios-lex-entry" lemma-id="n18158" body-key=""><b><span class="alpheios-lex-la" lang="lat">fĭgŭlus</span></b> ,
			i, m.
		v. fingo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a potter</i>, <i><span class="en">Varr.
				R. R. 3, 15, 2</span></i>; <i><span class="en">Plin. 35, 12, 43, § 159</span></i>:
				<i><span class="en">Col.
				11, 1, 9</span></i>; <i><span class="en">Inscr. Orell.
			4190</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">SIGILLATOR ( = sigillorum fictor),</span>”
				<i>a seal-maker</i>,
				 <i><span class="en">ib. 4191</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vas figuli,</span>”
				 <i><span class="en">Vulg.
					Psa. 2, 9 al.</span></i>
			— <b>Poet.</b> of the <i>builders</i> of the brick walls of Babylon: 
				“<span class="alpheios-lex-la" lang="lat">a figulis munita urbs,</span>”
				 <i><span class="en">Juv.
					10, 171</span></i>
			.</div>
