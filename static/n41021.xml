    <div class="alpheios-lex-entry" lemma-id="n41021" body-key=""><b><span class="alpheios-lex-la" lang="lat">rĕmĕdĭo</span></b> ,
			āvi, ātum, 1, v. a.,
		and <b><span class="alpheios-lex-la" lang="lat">rĕ-mĕdĭor</span></b> ,
			ātus, 1, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>v. dep. n.</i> [remedium], <i>to heal</i>, <i>cure</i>, <i>remedy</i> (post-class.; cf.: sano, curo, medico).
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense5"><b>(a).</b>
			<i>Act.</i>: 
				“<span class="alpheios-lex-la" lang="lat">capitis dolorem,</span>”
				 <i><span class="en">Scrib. Comp. 11</span></i>
			; <i><span class="en">18</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">multos,</span>”
				 <i><span class="en">id.
					ib. 122</span></i>
			; <i><span class="en">Tert. adv. Marc. 4, 35</span></i>;
					<i><span class="en">id. ad Scapul. 4
			al.</span></i>— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense5"><b>(b).</b>
			<i>Dep.</i>, <i><span class="en">Hier. Ep.
			68</span></i>; <i><span class="en">App. Herb. 2</span></i>;
			<i><span class="en">105</span></i>.</div>
