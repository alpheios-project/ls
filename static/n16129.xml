    <div class="alpheios-lex-entry" lemma-id="n16129" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ērĭdănus</span></b> ,
		i, m., = <span class="alpheios-lex-greek" lang="grc">Ἠριδανός</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>The mythical and poetical name of the river Po</i>,
				<i><span class="en">Plin. 3, 16, 20</span></i>, § §
			117, 120; <i><span class="en">Verg. G. 4, 372</span></i>; <i><span class="en">id. A. 6,
				659</span></i>; <i><span class="en">Prop. 1, 12, 4</span></i>; <i><span class="en">4</span></i> (5), 10, 39; <i><span class="en">Ov. M. 2,
				324</span></i>; <i><span class="en">372</span></i>; <i><span class="en">Mart. Cap.
				6, § 640</span></i>.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>The constellation</i> Eridanus, <i><span class="en">Cic.
				Arat. 389</span></i>; <i><span class="en">Hyg. Astr. 2, 32</span></i>;
					<i><span class="en">Mart. Cap. 8, § 838
			al.</span></i></div>
