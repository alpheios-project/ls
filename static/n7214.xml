    <div class="alpheios-lex-entry" lemma-id="n7214" body-key=""><b><span class="alpheios-lex-la" lang="lat">caustĭcus</span></b> , a, um,
			adj., = <span class="alpheios-lex-greek" lang="grc">καυστικός</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>burning</i>,
				<i>caustic</i>, <i>corrosive</i>: 
				“<span class="alpheios-lex-la" lang="lat">natura,</span>”
				 <i><span class="en">Plin.
					27, 9, 54, § 77</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vis,</span>”
				 <i><span class="en">id.
					32, 10, 52, § 140</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">spuma,</span>”
				<i>a kind of soap with which the Germans colored their
						hair</i>,
				 <i><span class="en">Mart. 14, 26, 1</span></i>
			.—<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">caustĭcum</span></b> , i,
			n. (sc. medicamentum), <i>a burning</i>,
				<i>corroding medicament</i>, <i><span class="en">Plin. 26, 1,
				3, § 3</span></i>; <i><span class="en">26, 8, 39, § 65</span></i>; <i><span class="en">34, 18, 56, §
			178</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
