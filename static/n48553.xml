    <div class="alpheios-lex-entry" lemma-id="n48553" body-key=""><b><span class="alpheios-lex-la" lang="lat">torcŭlārĭus</span></b> ,
			a, um, adj.
		torcular, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>belonging to a
			press</i>: 
				“<span class="alpheios-lex-la" lang="lat">vasa,</span>”
				 <i><span class="en">Varr. R. R. 1, 22, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cella,</span>”
				 <i><span class="en">Col.
					1, 6, 9</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">lacus,</span>”
				 <i><span class="en">id.
					12, 18, 3</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Substt.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<b><span class="alpheios-lex-la" lang="lat">torcŭlārĭus</span></b> ,
			ii, m., <i>a presser</i>,
				<i>pressman</i>, <i><span class="en">Col. 12,
				52, 3</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b><span class="alpheios-lex-la" lang="lat">torcŭlārĭum</span></b> ,
			ii, n., = torcular, I., <i>a
				press</i>, <i><span class="en">Cato, R. R. 13, 1</span></i>;
				<i><span class="en">18, 1</span></i>; <i><span class="en">Plin. 18, 31, 74, §
		317</span></i>.</div>
