    <div class="alpheios-lex-entry" lemma-id="n1849" body-key=""><b><span class="alpheios-lex-la" lang="lat">ălĭmōnĭa</span></b> ,
		ae, f.
		alo (ante- and postclass. for alimentum), <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>nourishment</i>, <i>food</i>, <i>sustenance</i>, <i>support</i>: 
				“<span class="alpheios-lex-la" lang="lat">quaestus alimoniae,</span>”
				 <i><span class="en">Plaut.
					Pers. 1, 2, 1</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">naturalis,</span>”
				 <i><span class="en">Gell. 17, 15, 5</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">flammae,</span>”
				<i>fuel</i>,
				 <i><span class="en">Prud. Cath. 5, 19</span></i>
			; <i><span class="en">App. M. 2, p. 115</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">in alimoniam ignis,</span>”
				<i>for the food of the burnt-offering</i>,
				 <i><span class="en">Vulg.
					Lev. 3, 16</span></i>
			; <i><span class="en">ib. 1 Macc. 14, 10</span></i>.</div>
