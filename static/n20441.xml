    <div class="alpheios-lex-entry" lemma-id="n20441" body-key=""><b><span class="alpheios-lex-la" lang="lat">hēpătĭcus</span></b> ,
		i, m., = <span class="alpheios-lex-greek" lang="grc">ἡπατικός</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>belonging to the liver</i>: 
				“<span class="alpheios-lex-la" lang="lat">morbus,</span>”
				 <i><span class="en">Isid. 4, 7, 21</span></i>
			.— <i>Plur.</i> as <i>subst.</i>: <b><span class="alpheios-lex-la" lang="lat">hēpătĭci</span></b> ,
