    <div class="alpheios-lex-entry" lemma-id="n33224" body-key=""><b><span class="alpheios-lex-la" lang="lat">ŏvĭārĭus</span></b> 
		(collat. form ‡ <b><span class="alpheios-lex-la" lang="lat">ŏvĭārĭcus</span></b> : <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
				“<span class="alpheios-lex-la" lang="lat">conductoribus gregum oviaricorum,</span>”
				 <i><span class="en">Inscr. Momms. 4916</span></i>
			), a, um, adj.
			ovis, <i>of</i> or <i>belonging to sheep</i>, <i>sheep-</i>
			(post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">pecus (al. oviaricum),</span>”
				 <i><span class="en">Col.
					7, 6, 1</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">ŏvĭārĭa</span></b> ,
				ae, f., <i>a flock of
				sheep</i>, <i><span class="en">Varr. R. R. 2 praef.</span></i> §
		6.</div>
