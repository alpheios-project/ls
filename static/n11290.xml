<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n11290" body-key=""><b><span class="alpheios-lex-la" lang="lat">cor-rīdĕo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">conr-</span></b> ), ēre,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>v. n., to laugh
				together</i> or <i>aloud</i> (ante- and
			post-class.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i><span class="en">Aug.
				Conf. 4, 8</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">alicui,</span>”
				 <i><span class="en">Vulg.
					Gen. 21, 6</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>: 
				“<span class="alpheios-lex-la" lang="lat">perfusa lepore Omnia corrident,</span>”
				 <i><span class="en">Lucr.
					4, 81</span></i>
			.</div>
