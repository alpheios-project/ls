    <div class="alpheios-lex-entry" lemma-id="n19759" body-key=""><b><span class="alpheios-lex-la" lang="lat">Gordĭum</span></b> , ii,
		n., = <span class="alpheios-lex-greek" lang="grc">Γόρδιον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a city of Phrygia
				Major on the Sangarius</i>, <i>famous for the
				Gordian knot</i> (v. Gordius), <i><span class="en">Plin. 5, 32,
				42, § 146</span></i>; <i><span class="en">Liv. 38,
				18, 10</span></i> sqq.; <i><span class="en">Curt. 3, 1, 12</span></i>
			sqq.—Hence, <b><span class="alpheios-lex-la" lang="lat">Gordĭensis</span></b> , e,
			adj., <i>of Gordium</i>, <i><span class="en">Scrib.
			172</span></i>.</div>
