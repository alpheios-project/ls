    <div class="alpheios-lex-entry" lemma-id="n24706" body-key=""><b><span class="alpheios-lex-la" lang="lat">invectīvus</span></b> , a, um,
			adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>scolding</i>, <i>abusive</i>, <i>reproachful</i>, <i>full of invectives</i>
			(postclass.): 
				“<span class="alpheios-lex-la" lang="lat">oratio acer, et invectiva,</span>”
				 <i><span class="en">Amm. 21, 10, 7</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">volumen,</span>”
				 <i><span class="en">id. 22, 14, 2</span></i>
			.—<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">in-vectīva</span></b> ,
			ōrum, n., <i>invectives</i>, <i>abuse</i>: 
				“<span class="alpheios-lex-la" lang="lat">quaedam in principem,</span>”
				 <i><span class="en">Amm. 28, 1, 20</span></i>
			.</div>
