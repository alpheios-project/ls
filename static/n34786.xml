				 <i><span class="en">id. N.
					D. 1, 1, 1</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">navigatio,</span>”
				 <i><span class="en">id.
					Att. 3, 8, 2</span></i>
			.—<i>Sup.</i>: 
				“<span class="alpheios-lex-la" lang="lat">perdifficillimus aditus,</span>”
				<i>exceedingly difficult</i>,
				 <i><span class="en">Liv.
					40, 21</span></i>
