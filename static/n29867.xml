    <div class="alpheios-lex-entry" lemma-id="n29867" body-key=""><b><span class="alpheios-lex-la" lang="lat">multātĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">mulct-</span></b> ),
		ōnis, f.
		2. multo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a penalty, amercement, fine</i> in any thing
			(class.): 
				“<span class="alpheios-lex-la" lang="lat">misera est multatio bonorum,</span>”
				 <i><span class="en">Cic.
					Rab. Perd. 5, 16</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">multatio non nisi ovium boumque impendio
					dicebatur,</span>”
				 <i><span class="en">Plin.
					18, 3, 3, § 11</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">AEDILIS MVLTATIO,</span>”
				 <i><span class="en">Inscr. Orell. 2488</span></i>
			.</div>
