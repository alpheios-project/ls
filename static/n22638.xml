    <div class="alpheios-lex-entry" lemma-id="n22638" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-culpābĭlis</span></b> ,
		e, adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unblamable</i>, <i>blameless</i>
			(post-class.): 
				“<span class="alpheios-lex-la" lang="lat">numen,</span>”
				 <i><span class="en">Prud. Apoth. 1015</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">mores,</span>”
				 <i><span class="en">Avien. Arat. 28</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">lapis,</span>”
				i. e. <i>faultless</i>, <i>without a flaw</i>,
				 <i><span class="en">Sol. 30</span></i>
			. —<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">inculpābĭlĭter</span></b> ,
				<i>without blame</i>,
				<i><span class="en">Cassiod. Var. 5, 27</span></i>; <i><span class="en">11,
			18</span></i> sq.</div>
