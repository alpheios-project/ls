    <div class="alpheios-lex-entry" lemma-id="n33158" body-key=""><b><span class="alpheios-lex-la" lang="lat">ostentātor</span></b> ,
		ōris, m.
		ostento, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a vain</i>, <i>self-satisfied
				exhibiter</i>, <i>a displayer</i>, <i>parader</i>, <i>boaster</i>, <i>vaunter</i>: 
				“<span class="alpheios-lex-la" lang="lat">ostentatores meri,</span>”
				 <i><span class="en">Plaut. Curc. 4, 1, 15</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ostentatorem pecuniae gloriosum describere,</span>”
				 <i><span class="en">Auct. Her. 4, 50, 63</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">factorum,</span>”
				 <i><span class="en">Liv. 1,
					10</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">omnium, quae diceret,</span>”
				 <i><span class="en">Tac. H.
					2, 80</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">rector juveni et ceteris periculorum
					praemiorumque ostentator,</span>”
				 <i><span class="en">id. A.
					1, 24</span></i>
			.</div>
