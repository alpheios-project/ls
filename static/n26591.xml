    <div class="alpheios-lex-entry" lemma-id="n26591" body-key=""><b><span class="alpheios-lex-la" lang="lat">lignōsus</span></b> , a, um, adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>like wood, woody</i>: 
				“<span class="alpheios-lex-la" lang="lat">caules,</span>”
				 <i><span class="en">Plin.
					25, 6, 29, § 65</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">glutinum,</span>”
				 <i><span class="en">id.
					28, 17, 71, § 236</span></i>
			.—<i>Comp.</i>: 
				“<span class="alpheios-lex-la" lang="lat">lignosiora sunt reliqua,</span>”
				 <i><span class="en">Plin.
					19, 5, 27, § 88</span></i>
			.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Stony, having a large stone</i> or <i>kernel</i>: 
				“<span class="alpheios-lex-la" lang="lat">fructus,</span>”
				 <i><span class="en">Plin.
					24, 9, 42, § 69</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">nucleus,</span>”
				 <i><span class="en">id.
					13, 19, 34, § 112</span></i>
			.</div>
