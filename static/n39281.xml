<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n39281" body-key=""><b><span class="alpheios-lex-la" lang="lat">Psămăthē</span></b> ,
			ēs, f., = <span class="alpheios-lex-greek" lang="grc">Ψαμάθη</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Daughter of Crotopus</i>, <i>king of
				Argos</i>, <i><span class="en">Ov. Ib. 575</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A sea-nymph</i>, <i>mother of
			Phocus</i>, <i><span class="en">Ov. M. 11,
			398</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>A fountain in Laconia</i>, <i>near
				Psamathus</i>, <i><span class="en">Plin. 4, 5, 9, § 17</span></i>; <i><span class="en">Val. Fl. 1,
				365</span></i>.</div>
