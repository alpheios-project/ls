    <div class="alpheios-lex-entry" lemma-id="n36216" body-key=""><b><span class="alpheios-lex-la" lang="lat">phȳsēter</span></b> ,
		ēris, m., = <span class="alpheios-lex-greek" lang="grc">φυσητήρ</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A blow-pipe</i>, <i>blowing-tube</i>,
			Pelag. Vet. <i>fin.</i>— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>a large species of
				whale</i>, <i>a cachalot</i>, <i>spermaceti whale</i>, <i><span class="en">Plin. 9, 4, 3, § 8</span></i>; <i><span class="en">Sen.
				Hippol. 1030</span></i>.</div>
