    <div class="alpheios-lex-entry" lemma-id="n6973" body-key=""><b><span class="alpheios-lex-la" lang="lat">castănĕa</span></b> , ae,
			f., = <span class="alpheios-lex-greek" lang="grc">κάστανον</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>The chestnut-tree</i>, <i><span class="en">Col. 4,
			33</span></i>; <i><span class="en">5, 10,
			14</span></i>; <i><span class="en">Pall. Febr. 25, 33</span></i>;
					<i><span class="en">id. Nov. 7, 17</span></i>; <i><span class="en">Plin. 16,
