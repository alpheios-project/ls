        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A chestnut</i>, <i><span class="en">Verg. E. 1,
				82</span></i>; <i><span class="en">7, 53</span></i>; <i><span class="en">Plin. 13,
				18, 32, § 110</span></i>; <i><span class="en">15, 28, 34, §
			112</span></i>; cf. 
				“<span class="alpheios-lex-la" lang="lat">appos. castaneae nuces,</span>”
				 <i><span class="en">Verg.
					E. 2, 52</span></i>
			; <i><span class="en">Ov. A. A. 2, 26, 8</span></i>.</div>
