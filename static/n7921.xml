<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n7921" body-key=""><b><span class="alpheios-lex-la" lang="lat">chrȳsŏcolla</span></b> ,
		ae, f., = <span class="alpheios-lex-greek" lang="grc">χρυσόκολλα</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Mountain - green</i>, <i>copper -
				green</i>, <i>borax.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b> Natural, <i><span class="en">Plin. 33,
				5, 26, § 86 sq.</span></i>; <i><span class="en">Vitr. 7, 9 <i>fin.</i></span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b> Made by art, <i><span class="en">Plin. 33,
				5, 27, § 89 sq.</span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A precious stone</i>, <i>called
			also</i> amphitane, <i><span class="en">Plin. 37, 10, 54, §
		147</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
