    <div class="alpheios-lex-entry" lemma-id="n15930" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ĕpĭdamnus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-os</span></b> ), i,
		f., = <span class="alpheios-lex-greek" lang="grc">Επίδαμνος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an older name of
				Dyrrachium</i>, <i><span class="en">Mel. 2, 3, 13</span></i>; <i><span class="en">Plin. 3, 23,
				26, § 145</span></i>; <i><span class="en">Plaut. Men.
				2, 1, 38</span></i>; <i><span class="en">id. ib.</span></i> prol. 33,
			49; 51; 72 al.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b> Derivv. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<b><span class="alpheios-lex-la" lang="lat">Ĕpĭdamnĭus</span></b> , a,
				um, adj., <i>Epidamnian</i>: 
				“<span class="alpheios-lex-la" lang="lat">natio,</span>”
				 <i><span class="en">Plaut. Men. 2, 1, 33</span></i>
			.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b><span class="alpheios-lex-la" lang="lat">Ĕpĭdamnĭensis</span></b> ,
			e, the same: 
				“<span class="alpheios-lex-la" lang="lat">cives,</span>”
				 <i><span class="en">id. ib. 5, 7, 11</span></i>
			; cf. <i><span class="en">id. ib.</span></i> prol. 32;
		57.</div>
