    <div class="alpheios-lex-entry" lemma-id="n48408" body-key=""><b><span class="alpheios-lex-la" lang="lat">Tīrĕsĭas</span></b> ,
		ae, m., = <span class="alpheios-lex-greek" lang="grc">Τειρεσίας.</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A celebrated blind soothsayer of Thebes</i>, <i><span class="en">Hyg. Fab.
				68</span></i>; <i><span class="en">75</span></i>;
				<i><span class="en">Cic. Tusc. 5, 39, 115</span></i>; <i><span class="en">id. Div.
				1, 40, 88</span></i>; <i><span class="en">2, 3, 9</span></i>; <i><span class="en">id. N. D. 2,
				3, 7</span></i>; <i><span class="en">Ov. M. 3, 323</span></i>; <i><span class="en">6, 157</span></i>;
				<i><span class="en">Hor.
				S. 2, 5, 1</span></i>; <i><span class="en">Stat. Th. 10,
			589</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, for <i>a blind
			man</i>, <i><span class="en">Juv. 13, 249</span></i>.</div>
