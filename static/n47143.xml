    <div class="alpheios-lex-entry" lemma-id="n47143" body-key=""><b><span class="alpheios-lex-la" lang="lat">sustentātus</span></b> , ūs,
			m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				holding up</i> or <i>upright</i>, <i>a sustaining</i>, <i>support</i> (postclass.): 
				“<span class="alpheios-lex-la" lang="lat">levia sustentatui, gravia demersui,</span>”
				 <i><span class="en">App. Mag. p. 287, 34</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cujus ille sustentatu,</span>”
				 <i><span class="en">Aus. Per. 5</span></i>
			.</div>
