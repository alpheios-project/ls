    <div class="alpheios-lex-entry" lemma-id="n3145" body-key=""><b><span class="alpheios-lex-la" lang="lat">appĕtentĭa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">adp-</span></b> ), ae, f.
		appeto, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a longing after</i> something, <i>appetite</i>: 
				“<span class="alpheios-lex-la" lang="lat">adpetentia cibi,</span>”
				 <i><span class="en">Plin.
					19, 8, 38, § 127</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">liberalium artium,</span>”
				 <i><span class="en">id.
					23, 1, 22, § 38</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">gloriae,</span>”
				 <i><span class="en">Aur.
					Vict. Epit. 15</span></i>
			.—Without <i>gen.</i>, <i>desire</i>, <i>longing</i>: 
				“<span class="alpheios-lex-la" lang="lat">libido effrenatam (efficit) adpetentiam,</span>”
				 <i><span class="en">Cic.
					Tusc. 4, 7, 15</span></i>
			.</div>
