    <div class="alpheios-lex-entry" lemma-id="n33924" body-key=""><b><span class="alpheios-lex-la" lang="lat">Parrhăsĭus</span></b> 
			(<b><span class="alpheios-lex-la" lang="lat">Parră-</span></b> ),
			ĭi, m., = <span class="alpheios-lex-greek" lang="grc">Παρράσιος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a celebrated Greek painter</i>, <i>a
				native of Ephesus</i>, <i><span class="en">Plin. 35,
				10, 36, § 67 sq.</span></i>; <i><span class="en">Prop. 3,
			9</span></i> (4, 8), 12; <i><span class="en">Hor. C. 4, 8, 6</span></i>; <i><span class="en">Sen.
				Contr. 5, 34</span></i>.—<b>Transf.</b>: 
				“<span class="alpheios-lex-la" lang="lat">non multos apud nos futuros Polyclitos et
					Parrhasios fuisse,</span>”
				 <i><span class="en">Cic.
					Tusc. 1, 2, 4</span></i>
			.</div>
