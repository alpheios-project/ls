    <div class="alpheios-lex-entry" lemma-id="n49293" body-key=""><b><span class="alpheios-lex-la" lang="lat">trŏpŏlŏgĭcus</span></b> ,
			a, um, adj., = <span class="alpheios-lex-greek" lang="grc">τροπολογικός</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>figurative</i>, <i>tropical</i>, <i>tropological</i> (late Lat.): 
				“<span class="alpheios-lex-la" lang="lat">tropologicum et figuratum genus,</span>”
				 <i><span class="en">Sid. Ep. 9, 3 <i>med.</i></span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">interpretatio,</span>”
				 <i><span class="en">Hier. adv. Joan. Hierosol. 7</span></i>
			.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">trŏpŏlŏ-gĭcē</span></b> ,
				<i>figuratively</i>, <i>metaphorically</i>: 
				“<span class="alpheios-lex-la" lang="lat">exponere aliquid,</span>”
				 <i><span class="en">Hier. in Soph. 1, 8</span></i>
			; <i><span class="en">id. in Ezech. 1, 6, 2</span></i>.</div>
