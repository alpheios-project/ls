<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n29473" body-key=""><b><span class="alpheios-lex-la" lang="lat">mollĭcŭlus</span></b> ,
			a, um, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>adj. dim.</i> [mollis]. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i>soft, tender,
			delicate</i> (<b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">escae,</span>”
				 <i><span class="en">Plaut. Cas. 2, 8, 58</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">meus molliculus caseus,</span>”
				 <i><span class="en">id.
					Poen. 1, 2, 154</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>, <i>voluptuous</i>: 
				“<span class="alpheios-lex-la" lang="lat">versiculi,</span>”
				 <i><span class="en">Cat.
					16, 4</span></i>
			; cf. 
				“<span class="alpheios-lex-la" lang="lat">adulescentulus,</span>”
				 <i><span class="en">Charis. 183</span></i>
			 P.</div>
