    <div class="alpheios-lex-entry" lemma-id="n36980" body-key=""><b><span class="alpheios-lex-la" lang="lat">Pompējŏpŏlis</span></b> ,
			is, f.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A city of</i>
			
			
			<i>Cilicia</i>, <i>formerly called
			Soli</i>, now <i>Mezetli</i>, <i><span class="en">Mel. 1, 13,
				2</span></i>; <i><span class="en">Plin. 5, 27, 22, § 92</span></i>; <i><span class="en">Tac. A. 2,
			58</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A city of Paphlagonia</i>, now <i>Tash
				Kupri</i>, <i><span class="en">Plin. 6, 2, 2, § 7</span></i>.</div>
