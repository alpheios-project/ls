    <div class="alpheios-lex-entry" lemma-id="n20519" body-key=""><b><span class="alpheios-lex-la" lang="lat">hērēdĭŏlum</span></b> ,
		i, n.
		dim.
		heredium, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a small inheritance</i>, <i>small
				patrimony</i>, <i><span class="en">Col. 1</span></i>, praef. § 13; <i><span class="en">Gell. 19,
				7, 1</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">herediolum, majorum regna meorum,</span>”
				 <i><span class="en">Aus. Idyll. 3, 1</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ex iguum,</span>”
				 <i><span class="en">App. Mag. p. 338, 6</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">num ipsum heredioli pretium invidiosum est?</span>”
				 <i><span class="en">id. ib.</span></i>
			 p. 338, 17.</div>
