    <div class="alpheios-lex-entry" lemma-id="n15603" body-key=""><b><span class="alpheios-lex-la" lang="lat">embŏlismus</span></b> , a, um,
			adj., = <span class="alpheios-lex-greek" lang="grc">ἐμβολισμός</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>intercalary</i>: 
				“<span class="alpheios-lex-la" lang="lat">dies,</span>”
				 <i><span class="en">Sol. 1, § 42</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">annus,</span>”
				<i>leap-year</i>,
				 <i><span class="en">Isid. Orig. 6, 17, 21 sq.</span></i>
			—As <i>subst.</i>: <b><span class="alpheios-lex-la" lang="lat">embolismus</span></b> , i, m.,
				<i>the interposition</i>, <i>intercalation</i>, <i><span class="en">Isid. 6, 17,
			23</span></i>.</div>
