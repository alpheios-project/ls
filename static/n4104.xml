    <div class="alpheios-lex-entry" lemma-id="n4104" body-key=""><b><span class="alpheios-lex-la" lang="lat">assultus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">ads-</span></b> ), ūs, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				leaping to</i> or <i>toward</i>, <i>an attack</i>, <i>assault</i>: 
				“<span class="alpheios-lex-la" lang="lat">locum variis adsultibus urget,</span>”
				 <i><span class="en">Verg.
					A. 5, 442</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">adsultibus et velocitate corporum uti,</span>”
				 <i><span class="en">Tac. A.
					2, 21</span></i>
			.</div>
