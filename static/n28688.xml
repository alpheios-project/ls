    <div class="alpheios-lex-entry" lemma-id="n28688" body-key=""><b><span class="alpheios-lex-la" lang="lat">Mĕnoetĭus</span></b> , ii,
			m., = <span class="alpheios-lex-greek" lang="grc">Μενοίτιος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the son of Actor and
				father of Patroclus, one of the Argonauts</i>, <i><span class="en">Hyg. Fab.
				14</span></i> and 97.—Hence, <b><span class="alpheios-lex-la" lang="lat">Mĕnoetĭădes</span></b> ,
			ae, m., = <span class="alpheios-lex-greek" lang="grc">Μενοιτιάδης</span>, <i>the</i>
			
			<i>son of Menœtius</i>, i. e. <i>Patroclus, the friend of Achilles</i>, <i><span class="en">Prop. 2, 1,
				38</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
