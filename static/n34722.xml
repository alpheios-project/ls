    <div class="alpheios-lex-entry" lemma-id="n34722" body-key=""><b><span class="alpheios-lex-la" lang="lat">per-commŏdus</span></b> , a, um,
			adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>very suitable</i>, <i>very
			convenient</i>, <i>very opportune</i>: 
				“<span class="alpheios-lex-la" lang="lat">alicui rei,</span>”
				 <i><span class="en">Liv. 22, 43, 11</span></i>
			.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">percom-mŏdē</span></b> , <i>very suitably</i>, <i>very
				conveniently</i>, <i>very well</i>: 
				“<span class="alpheios-lex-la" lang="lat">percommode accidit, quod, etc.,</span>”
				 <i><span class="en">Cic.
					Caecin. 27, 77</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">percommode factum est, quod, etc.,</span>”
				 <i><span class="en">id.
					Tusc. 4, 30, 64</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">hoc percommode cadit quod, etc.,</span>”
				 <i><span class="en">id.
					Verr. 1, 2, 5</span></i>
			.</div>
