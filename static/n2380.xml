    <div class="alpheios-lex-entry" lemma-id="n2380" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ămūlĭus</span></b> ,
		i, m., = <span class="alpheios-lex-greek" lang="grc">Ἀμούλιος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>son of Procas</i>, <i>king in
			Alba</i>, <i>who expelled his brother Numitor</i>,
				<i>and ordered his grandsons Romulus and Remus to
				be thrown into the Tiber;</i> hence, dirus, <i><span class="en">Ov. F. 4,
			53</span></i>; cf. <i><span class="en">Liv. 1, 3 sq.</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">injustus,</span>”
				 <i><span class="en">Ov. M. 14, 772 al.</span></i>
			</div>
