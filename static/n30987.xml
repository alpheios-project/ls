    <div class="alpheios-lex-entry" lemma-id="n30987" body-key=""><b><span class="alpheios-lex-la" lang="lat">ninguĭdus</span></b> , a, um,
			adj.
		ninguis, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of snow, snowy</i> (post-class.): 
				“<span class="alpheios-lex-la" lang="lat">juga,</span>”
				 <i><span class="en">Aus. Ep. 24, 68</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">oppida,</span>”
				 <i><span class="en">id. ib. 24, 124</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Boreas,</span>”
				 <i><span class="en">Prud. Apophth. 729</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>falling like
			snow</i>: 
				“<span class="alpheios-lex-la" lang="lat">cibus,</span>”
				i. e. <i>manna</i>,
				 <i><span class="en">Prud. Cath. 5, 97</span></i>
			.</div>
