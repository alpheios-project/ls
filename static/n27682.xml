<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n27682" body-key=""><b><span class="alpheios-lex-la" lang="lat">mălăcus</span></b> , a,
		um, adj., = <span class="alpheios-lex-greek" lang="grc">μαλακός</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>soft, supple,
				pliant</i> (Plautin.): 
				“<span class="alpheios-lex-la" lang="lat">pallium malacum et calidum,</span>”
				 <i><span class="en">Plaut. Mil. 3, 1, 93</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">pallium,</span>”
				 <i><span class="en">id.
					Bacch. 1, 1, 38</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>soft, delicate,
				luxurious</i>: 
				“<span class="alpheios-lex-la" lang="lat">ad saltandum malacus,</span>”
				 <i><span class="en">Plaut. Mil. 3, 1, 74</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">unctiones,</span>”
				 <i><span class="en">id.
					Stich. 1, 3, 74</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">in malacum modum,</span>”
				 <i><span class="en">id.
					Bacch. 2, 3, 121</span></i>
			.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
