    <div class="alpheios-lex-entry" lemma-id="n7683" body-key=""><b><span class="alpheios-lex-la" lang="lat">chalcītes</span></b> , ae,
		m., or <b><span class="alpheios-lex-la" lang="lat">chalcītis</span></b> , ĭdis,
		f., = <span class="alpheios-lex-greek" lang="grc">χαλκιτης</span> or <span class="alpheios-lex-greek" lang="grc">χαλκῖτις</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Copperstone</i>, <i>copper ore</i>,
				<i><span class="en">Plin.
				34, 2, 2, § 2</span></i>; <i><span class="en">34, 12, 29, §
			117</span></i> sq.; <i><span class="en">Cels. 6, 6, 31</span></i>; <i><span class="en">6, 7,
			7</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A precious stone of a copper color</i>, <i><span class="en">Plin. 37,
				11, 73, § 191</span></i>.</div>
