    <div class="alpheios-lex-entry" lemma-id="n21159" body-key=""><b><span class="alpheios-lex-la" lang="lat">Hypaepa</span></b> , ōrum,
			n., = <span class="alpheios-lex-greek" lang="grc">Ὕπαιπα</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a small town in
			Lydia</i>, now <i>Beréki</i>, <i><span class="en">Ov. M. 6,
			13</span></i>; <i><span class="en">11, 152</span></i>; <i><span class="en">Petr.
			133</span></i>.—Hence, <b><span class="alpheios-lex-la" lang="lat">Hy-paepēni</span></b> ,
			ōrum, m., <i>its
				inhabitants</i>, <i><span class="en">Plin. 5, 29, 31, § 120</span></i>;
				<i><span class="en">Tac. A.
				4, 55</span></i>.</div>
