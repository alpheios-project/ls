    <div class="alpheios-lex-entry" lemma-id="n21736" body-key=""><b><span class="alpheios-lex-la" lang="lat">immōbĭlĭtas</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inm-</span></b> ),
			ātis, f.
		immobilis, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>immovableness</i> (post-class.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">aquae (maris mortui),</span>”
