    <div class="alpheios-lex-entry" lemma-id="n24983" body-key=""><b><span class="alpheios-lex-la" lang="lat">irrīsĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inr-</span></b> ), ōnis,
			f.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				deriding</i>, <i>mocking</i>, <i>mockery</i>: 
				“<span class="alpheios-lex-la" lang="lat">liber a tali irrisione Socrates,</span>”
				 <i><span class="en">Cic. Ac. 2, 39, 123</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">stultitiae,</span>”
				 <i><span class="en">Auct. Her. 1, 6, 10</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">irrisio omnium,</span>”
				 <i><span class="en">Cic.
					de Or. 1, 12, 50</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cum irrisione audientium,</span>”
				 <i><span class="en">id. de Off. 1, 38, 137</span></i>
			.</div>
