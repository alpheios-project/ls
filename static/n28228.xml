    <div class="alpheios-lex-entry" lemma-id="n28228" body-key=""><b><span class="alpheios-lex-la" lang="lat">mattĕa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">mattya</span></b> , <b><span class="alpheios-lex-la" lang="lat">mactĕa</span></b> ), ae,
		f., = <span class="alpheios-lex-greek" lang="grc">ματτύα</span> (v. <i><span class="en">Varr. L. L. 5, 22, § 112</span></i>
