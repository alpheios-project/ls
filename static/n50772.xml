    <div class="alpheios-lex-entry" lemma-id="n50772" body-key=""><b><span class="alpheios-lex-la" lang="lat">Veturĭus</span></b> , i,
		m.; <b><span class="alpheios-lex-la" lang="lat">Veturĭa</span></b> ,
			ae, f., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the name of a Roman</i> gens.
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>1.</b> L. Veturius Philo, <i>a consul</i> 548 A.U.C., <i><span class="en">Cic. Brut.
				14, 57</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b> T. Veturius Calvinus, <i>a consul</i> 433
			A.U.C., <i><span class="en">Cic. Off. 3, 30, 109</span></i>; <i><span class="en">id. Sen. 12,
				41</span></i>; <i><span class="en">Liv. 3, 8, 2</span></i>.—<i>Fem.</i>: 
				“<span class="alpheios-lex-la" lang="lat">Veturia,</span>”
				<i>the mother of Coriolanus</i>,
				 <i><span class="en">Liv.
					2, 40, 1</span></i>
			.</div>
