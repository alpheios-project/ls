    <div class="alpheios-lex-entry" lemma-id="n30366" body-key=""><b><span class="alpheios-lex-la" lang="lat">năpaeus</span></b> , a, um,
		adj., = <span class="alpheios-lex-greek" lang="grc">ναπαῖος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>belonging to a wooded vale</i> or <i>dell</i>: nymphae napaeae, <i>dell-nymphs</i>,
			Col. poët. 10, 264. —Hence, </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">Năpaeae</span></b> , ārum,
				f., <i>the dell-nymphs</i>: 
				“<span class="alpheios-lex-la" lang="lat">faciles venerare Napaeas,</span>”
				 <i><span class="en">Verg.
					G. 4, 535</span></i>
			; <i><span class="en">Stat. Th. 4, 255</span></i>;
				<i><span class="en">Nemes. Ecl. 2, 20</span></i>.</div>
