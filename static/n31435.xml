    <div class="alpheios-lex-entry" lemma-id="n31435" body-key=""><b><span class="alpheios-lex-la" lang="lat">nummŭlus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">nūm-</span></b> ), i, m.
