<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n27198" body-key=""><b><span class="alpheios-lex-la" lang="lat">lūmĭnōsus</span></b> , a,
			um, adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of light, light, luminous</i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">aedificia,</span>”
				 <i><span class="en">Vitr. 6,
					9</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">oleum luminosius,</span>”
				 <i><span class="en">Aug.
					Ep. 137 <i>fin.</i></span></i>
			—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>, <i>bright, conspicuous,
				prominent, remarkable</i>: 
				“<span class="alpheios-lex-la" lang="lat">partes orationis,</span>”
				 <i><span class="en">Cic.
					Or. 36, 125</span></i>
			.—<i>Sup.</i>: 
				“<span class="alpheios-lex-la" lang="lat">luminosissima caritas,</span>”
				 <i><span class="en">Aug.
					Ep. 144</span></i>
			.</div>
