    <div class="alpheios-lex-entry" lemma-id="n40585" body-key=""><b><span class="alpheios-lex-la" lang="lat">rĕcīsĭo</span></b> ,
			ōnis, m.
		id.. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i>a cutting off</i>
			(very rare): 
				“<span class="alpheios-lex-la" lang="lat">rosae,</span>”
				 <i><span class="en">Plin.
					21, 4, 10, § 21</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>, <i>a retrenchment</i>,
				<i>diminution</i>:
			 legatorum, <i><span class="en">Dig. 28, 5, 35</span></i>; <i><span class="en">Mart.
					Cap. 9, § 971</span></i>.</div>
