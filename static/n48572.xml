    <div class="alpheios-lex-entry" lemma-id="n48572" body-key=""><b><span class="alpheios-lex-la" lang="lat">tornus</span></b> , i, m., = <span class="alpheios-lex-greek" lang="grc">τόρνος,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a turner</i>'<i>s wheel</i>, <i>lathe.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">fit quasi ut ad tornum saxorum structa tuamur,</span>”
				 <i><span class="en">Lucr.
					4, 361</span></i>
			; <i><span class="en">Plin. 7, 56, 57, § 198</span></i>; <i><span class="en">16, 40, 76, §
			205</span></i>; <i><span class="en">Vitr. 10, 19 <i>med.</i></span></i>: 
				“<span class="alpheios-lex-la" lang="lat">nec tiliae leves torno Non formam accipiunt,</span>”
				 <i><span class="en">Verg.
					G. 2, 449</span></i>
			; <i><span class="en">id. E. 3, 38
			al.</span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>: angusto versus includere torno. <i><span class="en">Prop. 2,
				34, 43</span></i>; Auct. Paneg. ad Pis. 83.</div>
