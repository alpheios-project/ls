    <div class="alpheios-lex-entry" lemma-id="n39143" body-key=""><b><span class="alpheios-lex-la" lang="lat">Prōtĕsĭlāus</span></b> ,
		i, m., = <span class="alpheios-lex-greek" lang="grc">Πρωτεσίλαος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a son of Iphiclus</i>, <i>a native of
				Phylace in Thessaly</i>, <i>the husband of
				Laodamia</i>, <i>and the leader of the Thessalians
				against Troy</i>, <i>where he was the first man
				killed</i>, <i><span class="en">Ov. M. 12, 68</span></i>; <i><span class="en">Prop. 1,
				19, 7</span></i>; <i><span class="en">Mel. 2, 2</span></i>; <i><span class="en">Hyg.
				Fab. 103 sq.</span></i>—Hence, </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b><span class="alpheios-lex-la" lang="lat">Prōtĕsĭlāēus</span></b> ,
				a, um, adj., <i>Protesilœan</i>: 
				“<span class="alpheios-lex-la" lang="lat">domus,</span>”
				 <i><span class="en">Cat.
					68, 74</span></i>
			.</div>
