    <div class="alpheios-lex-entry" lemma-id="n23157" body-key=""><b><span class="alpheios-lex-la" lang="lat">infĕrĭālis</span></b> ,
			e, adj.
		inferiae, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>belonging to a
			funeral</i>: 
				“<span class="alpheios-lex-la" lang="lat">officia,</span>”
				 <i><span class="en">App. M. 8, p. 204</span></i>
