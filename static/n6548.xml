    <div class="alpheios-lex-entry" lemma-id="n6548" body-key=""><b><span class="alpheios-lex-la" lang="lat">cantērīnus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">canth-</span></b> ), a, um,
			adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>pertaining to a horse</i>, <i>horse-</i>: 
				“<span class="alpheios-lex-la" lang="lat">ritus,</span>”
				<i>like a horse</i>,
				 <i><span class="en">Plaut. Men. 2, 3, 44</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">hordeum,</span>”
				i. e. <i>winter barley</i>,
				 <i><span class="en">Col.
					2, 9, 14</span></i>
			; <i><span class="en">2, 10, 31</span></i>;
					<i><span class="en">Pall. Oct. 1, 2</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">lapathum = rumex,</span>”
				 <i><span class="en">Plin.
					20, 21, 85, § 231</span></i>
			.</div>
