				 <i><span class="en">Lucr.
					3, 464</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">delira furiosaque,</span>”
				 <i><span class="en">id. 2,
					985</span></i>
			; 
				“<span class="alpheios-lex-la" lang="lat">with amens,</span>”
				 <i><span class="en">Hor.
					S. 2, 3, 107</span></i>
			: 
