    <div class="alpheios-lex-entry" lemma-id="n28571" body-key=""><b><span class="alpheios-lex-la" lang="lat">mēlōta</span></b> , ae, or
			<b><span class="alpheios-lex-la" lang="lat">mēlōtē</span></b> ,
		ōs, f., = <span class="alpheios-lex-greek" lang="grc">μηλωτή</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a sheepskin</i> (with the wool on): 
				“<span class="alpheios-lex-la" lang="lat">circumierunt in melotis, in pellibus caprinis,</span>”
				 <i><span class="en">Vulg.
					Heb. 11, 37</span></i>
			; <i><span class="en">Cael. Aur. Tard. 1, 4, 76</span></i>.
			—Collat. form, <b><span class="alpheios-lex-la" lang="lat">mēlōtes</span></b> ,
				<i><span class="en">Isid. 19, 24, 19</span></i>; and <b><span class="alpheios-lex-la" lang="lat">mēlōtis</span></b> ,
				idis, f.,
				<i><span class="en">Ambros. Ep. 15, 9</span></i>.</div>
