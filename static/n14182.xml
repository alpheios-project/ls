    <div class="alpheios-lex-entry" lemma-id="n14182" body-key=""><b><span class="alpheios-lex-la" lang="lat">discŏbŏlus</span></b> , i,
			m., = <span class="alpheios-lex-greek" lang="grc">δισκοβόλος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the thrower of the
				discus</i> or <i>quoit</i>, a famous piece of
			sculpture by Myron, <i><span class="en">Quint. 2, 13, 10</span></i>; <i><span class="en">Plin. 34, 8,
				19, § 57</span></i>; also by Naucydes, Plin. ib. §
			80; 
				“<span class="alpheios-lex-la" lang="lat">and a painting by Tauriscus,</span>”
				 <i><span class="en">id.
					35, 11, 40, § 144</span></i>
			.</div>
