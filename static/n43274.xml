    <div class="alpheios-lex-entry" lemma-id="n43274" body-key=""><b><span class="alpheios-lex-la" lang="lat">Sĕcundus</span></b> ,
		i, m.; <b><span class="alpheios-lex-la" lang="lat">Sĕcunda</span></b> , ae, f.
		1. secundus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>a Roman proper name.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b> C. Plinius Secundus, <i>the writer on natural
			history.</i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b> C. Plinius Caecilius Secundus, <i>his
			nephew</i>: 
				“<span class="alpheios-lex-la" lang="lat">OCTAVIA Q. F. SECVNDA,</span>”
				 <i><span class="en">Inscr. Grut. 445, 2</span></i>
			; cf. <i><span class="en">Varr. L. L. 9, § 60</span></i>
			Müll.</div>
