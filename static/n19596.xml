    <div class="alpheios-lex-entry" lemma-id="n19596" body-key=""><b><span class="alpheios-lex-la" lang="lat">glăcĭālis</span></b> ,
		e, adj.
		glacies, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>icy</i>, <i>frozen</i>, <i>full of ice</i> (<b>poet.</b> and
			in post-Aug. prose; 
				“<span class="alpheios-lex-la" lang="lat">syn.: frigidus, algidus, gelidus, rigidus).
					hiems,</span>”
				 <i><span class="en">Verg.
					A. 3, 285</span></i>
			; <i><span class="en">Ov.
				M. 2, 30</span></i>; cf. 
				“<span class="alpheios-lex-la" lang="lat">frigus,</span>”
				 <i><span class="en">id.
					ib. 9, 582</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">polus,</span>”
				 <i><span class="en">id.
					ib. 2, 173</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Scythia,</span>”
				 <i><span class="en">id.
					ib. 8, 790</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">regio (opp. perfervida),</span>”
				 <i><span class="en">Col.
					3, 1, 3</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Oceanus,</span>”
				 <i><span class="en">Juv. 2,
					1</span></i>
			; cf. 
				“<span class="alpheios-lex-la" lang="lat">pontus,</span>”
				 <i><span class="en">Luc. 1,
					18</span></i>
			.</div>
