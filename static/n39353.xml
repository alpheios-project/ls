    <div class="alpheios-lex-entry" lemma-id="n39353" body-key=""><b><span class="alpheios-lex-la" lang="lat">Psylli</span></b> , ōrum,
		m., = <span class="alpheios-lex-greek" lang="grc">Ψύλλοι</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an African people
				south-west of the Syrtis Major</i>, <i>celebrated
				as serpent-charmers</i>: 
				“<span class="alpheios-lex-la" lang="lat">qui Psylli nominantur,</span>”
				 <i><span class="en">Cels.
					5, 27, 3</span></i>
			; <i><span class="en">Plin. 7, 2, 2, § 14</span></i>; <i><span class="en">8, 25, 38, §
			93</span></i>; <i><span class="en">Suet. Aug. 17</span></i>; <i><span class="en">Luc. 9,
				893</span></i>.—<i>Sing.</i>: 
				“<span class="alpheios-lex-la" lang="lat">exemplum Psylli secutus,</span>”
				 <i><span class="en">Cels.
					5, 27, 3</span></i>
			.</div>
