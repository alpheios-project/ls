    <div class="alpheios-lex-entry" lemma-id="n44169" body-key=""><b><span class="alpheios-lex-la" lang="lat">sĭdērītes</span></b> ,
		ae, m., = <span class="alpheios-lex-greek" lang="grc">σιδηρίτης</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A loadstone</i>, <i>magnet</i>, <i><span class="en">Plin. 36,
				16, 25, § 127</span></i> (Jan.
			sideritis).—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A kind of diamond</i>, <i><span class="en">Plin. 37, 4,
				16, § 58</span></i>.</div>
