<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n20128" body-key=""><b><span class="alpheios-lex-la" lang="lat">Haemus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Aemus</span></b> ) or <b><span class="alpheios-lex-la" lang="lat">Haemos</span></b> ,
			i, m., = <span class="alpheios-lex-greek" lang="grc">Αἷμος</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A high range of mountains in Thrace</i>, now called
				<i>the Great Balkan</i>, <i><span class="en">Mel. 2, 2,
			2</span></i>; <i><span class="en">Plin. 4, 11, 18, § 41</span></i>; <i><span class="en">Liv. 4, 21
				sq.</span></i>; <i><span class="en">Ov. M. 6, 87</span></i>; <i><span class="en">2, 219</span></i>;
				<i><span class="en">10, 77</span></i>; <i><span class="en">id. F. 1, 390</span></i>; <i><span class="en">Hor. C. 1,
				12, 6</span></i> et saep.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A celebrated actor</i>, <i><span class="en">Juv. 3,
			99</span></i>; <i><span class="en">6,
		198</span></i>.</div>
