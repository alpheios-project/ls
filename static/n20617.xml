    <div class="alpheios-lex-entry" lemma-id="n20617" body-key=""><b><span class="alpheios-lex-la" lang="lat">hexăphŏros</span></b> ,
		on, adj., = <span class="alpheios-lex-greek" lang="grc">ἑξαφόρος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>one of six who carry a load together</i>: 
				“<span class="alpheios-lex-la" lang="lat">phalangarii,</span>”
				 <i><span class="en">Vitr.
					10, 8 <i>med.</i></span></i>
			—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Borne by six together; subst.</i>: <b><span class="alpheios-lex-la" lang="lat">hexăphŏrum</span></b> ,
				i, n., = <span class="alpheios-lex-greek" lang="grc">ἑξάφορον</span>, <i>a litter borne by six
			men</i>, <i><span class="en">Mart. 2, 81, 1</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">non debes ferri mortuus hexaphoro,</span>”
				 <i><span class="en">id.
					6, 77, 10</span></i>
			.</div>
