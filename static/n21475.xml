    <div class="alpheios-lex-entry" lemma-id="n21475" body-key=""><b><span class="alpheios-lex-la" lang="lat">illaetābĭlis</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inl-</span></b> ), e, adj.
		in-laetabilis, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>cheerless</i>, <i>joyless</i>, <i>gloomy</i>, <i>sad</i> (<b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">ora,</span>”
				 <i><span class="en">Verg.
					A. 3, 707</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">murmur,</span>”
				 <i><span class="en">id. ib. 12, 619</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">hymen (with funestus),</span>”
				 <i><span class="en">Sen. Troad. 861</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">onus,</span>”
				i. e. <i>a dead child</i>,
				 <i><span class="en">Stat.
					Th. 5, 633</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">munus (with grave),</span>”
				 <i><span class="en">id. ib. 3, 706</span></i>
			.</div>
