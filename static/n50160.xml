    <div class="alpheios-lex-entry" lemma-id="n50160" body-key=""><b><span class="alpheios-lex-la" lang="lat">vānĭlŏquentĭa</span></b> ,
			ae, f.
		vaniloquus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>empty</i> or <i>idle talk</i>, <i>prating</i>, <i>vaunting</i> (rarely; 
				“<span class="alpheios-lex-la" lang="lat">not in Cic.),</span>”
				 <i><span class="en">Plaut. Rud. 4, 1, 14</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">hac vaniloquentiā primum Aristaenum
					praetorem Achaeorum excitavit,</span>”
				 <i><span class="en">Liv.
					34, 24, 1</span></i>
			; <i><span class="en">Tac. A. 3, 49</span></i>; <i><span class="en">6,
				31</span></i>.—<i>Plur.</i>, <i><span class="en">Jul.
					Val. Rer. Gest. Alex. 2, 10</span></i>.</div>
