<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n3304" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ăquītānĭa</span></b> ,
		ae, f.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A province in Southern Gaul</i>, <i>between the Loire and the Pyrenees</i>, <i><span class="en">Caes. B. G. 1,
				1</span></i>; <i><span class="en">3, 20</span></i>; <i><span class="en">Plin. 4,
				19, 33, § 108 sq.</span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b> Derivv. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<b><span class="alpheios-lex-la" lang="lat">Ăquītānus</span></b> , a,
			um, adj., <i>Aquitanian</i>: 
				“<span class="alpheios-lex-la" lang="lat">gens,</span>”
				 <i><span class="en">Tib.
					1, 7, 3</span></i>
			. —</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b><span class="alpheios-lex-la" lang="lat">Ăquītāni</span></b> ,
				ōrum, m., <i>the inhabitants of Aquitania</i>, <i><span class="en">Plin. 33, 6,
				31, § 97</span></i>; <i><span class="en">Caes. B. G. 1,
			1</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>C.</b>
			<b><span class="alpheios-lex-la" lang="lat">Ăquītānĭcus</span></b> ,
				a, um, adj., <i>Aquitanian</i>: 
				“<span class="alpheios-lex-la" lang="lat">sinus,</span>”
				 <i><span class="en">Plin.
					4, 19, 33, § 108</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">provincia,</span>”
				 <i><span class="en">id. 26,
					1, 3, § 4</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>D.</b>
			<b><span class="alpheios-lex-la" lang="lat">Ăquītā-nensis</span></b> ,
			e, adj., <i>Aquitanian</i>,
					<i><span class="en">Inscr. Grut. 440, 3</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
