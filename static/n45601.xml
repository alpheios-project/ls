    <div class="alpheios-lex-entry" lemma-id="n45601" body-key=""><b><span class="alpheios-lex-la" lang="lat">strŏbus</span></b>  or <b><span class="alpheios-lex-la" lang="lat">storbus</span></b> , i, m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A tree in Carmania</i>, <i>yielding an
				odoriferous gum</i>, <i><span class="en">Plin. 12, 17, 40, §
			79</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Another name of the</i> ladanum, <i><span class="en">Plin. 12,
				17, 37, § 74</span></i>.</div>
