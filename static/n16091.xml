    <div class="alpheios-lex-entry" lemma-id="n16091" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ĕrătō</span></b>  (occurring
		only in the nom.), f., = <span class="alpheios-lex-greek" lang="grc">Ἐρατώ</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>The muse of lyric and amorous poetry</i>, <i><span class="en">Ov. F. 4,
				195</span></i>; <i><span class="en">349</span></i>; <i><span class="en">id. A. A. 2,
				16</span></i>; <i><span class="en">425</span></i>; <i><span class="en">Aus. Idyll.
				20, 6</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b>Meton.</b>, <i>a Muse</i> in gen.,
				<i><span class="en">Verg.
				A. 7, 37</span></i> Serv.; <i><span class="en">Claud. Mall.
				Theod. 282</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A queen of Armenia</i>, <i><span class="en">Tac. A. 2,
			4</span></i>.</div>
