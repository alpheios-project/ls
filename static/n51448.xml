    <div class="alpheios-lex-entry" lemma-id="n51448" body-key=""><b><span class="alpheios-lex-la" lang="lat">vultŭrīnus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">volt-</span></b> ), a, um,
