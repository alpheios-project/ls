    <div class="alpheios-lex-entry" lemma-id="n48001" body-key=""><b><span class="alpheios-lex-la" lang="lat">Tēthys</span></b> , yos,
			f., = <span class="alpheios-lex-greek" lang="grc">Τηθύς,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a sea-goddess</i>,
				<i>wife of Oceanus</i>, <i>and mother
				of the seanymphs and river - gods; acc.</i> Tethyn, <i><span class="en">Ov. F. 5,
			81</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">Tethyos neptes,</span>”
				 <i><span class="en">id.
					ib. 5, 168</span></i>
			; <i><span class="en">Verg. G. 1, 31</span></i>; <i><span class="en">Cat. 64,
			29</span></i>; <i><span class="en">66,
			70</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>the sea</i>, <i><span class="en">Ov. M. 2,
			69</span></i>; <i><span class="en">2, 509</span></i>; <i><span class="en">Luc. 1,
			413</span></i>; <i><span class="en">Sil. 3, 60</span></i>; <i><span class="en">Mart.
				Spect. 3, 6</span></i>; <i><span class="en">Sen. Herc. Fur. 886</span></i>.</div>
