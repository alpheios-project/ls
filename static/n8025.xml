    <div class="alpheios-lex-entry" lemma-id="n8025" body-key=""><b><span class="alpheios-lex-la" lang="lat">Cĭnăra</span></b> , ae,
			f., = <span class="alpheios-lex-greek" lang="grc">Κινάρα</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A Greek proper name</i>, <i><span class="en">Hor. C.
				4, 1, 4 al.</span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>An island in the Ægean Sea</i>, now <i>Zinara</i>, <i><span class="en">Mel. 2, 7,
				11</span></i>; <i><span class="en">Plin. 4, 12, 23, § 69</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
