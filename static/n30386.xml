    <div class="alpheios-lex-entry" lemma-id="n30386" body-key=""><b><span class="alpheios-lex-la" lang="lat">nardus</span></b> , i, f., and <b><span class="alpheios-lex-la" lang="lat">nardum</span></b> , i,
		n., = <span class="alpheios-lex-greek" lang="grc">νάρδος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>nard</i>, <i><span class="en">Plin. 12,
				12, 26, § 42</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">nardus Gallicus,</span>”
				 <i><span class="en">id.
					12, 12, 26, § 46</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>nard-balsam,
				nard-oil</i>: 
