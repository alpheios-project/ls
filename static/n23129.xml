<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n23129" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-faustus</span></b> , a, um, adj.,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unfortunate</i>, <i>unpropitious</i> (<b>poet.</b> and post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">infaustas exurite puppes,</span>”
				 <i><span class="en">Verg.
					A. 5, 635</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">nomen,</span>”
				 <i><span class="en">id. ib. 7, 717</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">auspicium,</span>”
				 <i><span class="en">id. ib. 11, 347</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">gradus,</span>”
				 <i><span class="en">Ov. M.
					3, 36</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">dies,</span>”
				 <i><span class="en">Tac. H.
					2, 91</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">castra,</span>”
				 <i><span class="en">id. A.
					1, 30</span></i>
			.—<i>Neutr. subst.</i>: <b><span class="alpheios-lex-la" lang="lat">in-faustum</span></b> , i,
				n., <i>a misfortune</i>: 
				“<span class="alpheios-lex-la" lang="lat">infausto Atheniensium,</span>”
				 <i><span class="en">Plin.
					16, 36, 66, § 169</span></i>
			.—<i>Adv.</i>: 
			<b><span class="alpheios-lex-la" lang="lat">infaustē</span></b> , <i>unfortunately</i> (late Lat.),
					<i><span class="en">Cassiod. An. 12</span></i>.</div>
