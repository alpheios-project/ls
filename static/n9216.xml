    <div class="alpheios-lex-entry" lemma-id="n9216" body-key=""><b><span class="alpheios-lex-la" lang="lat">cōlȳphĭa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-līphĭa</span></b> ), ōrum,
			n., = <span class="alpheios-lex-greek" lang="grc">τὰ κωλύφια</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>choice bits of
				meat</i>, <i>loin-pieces</i>: 
				“<span class="alpheios-lex-la" lang="lat">collyrae facite ut madeant et Colyphia,</span>”
				 <i><span class="en">Plaut. Pers. 1, 3, 13</span></i>
			 Ritschl: 
				“<span class="alpheios-lex-la" lang="lat">comedunt colyphia paucae,</span>”
				 <i><span class="en">Juv. 2,
					53</span></i>
			 Jan.—Form coliphia, <i><span class="en">Mart. 7,
				67, 12</span></i>; cf. Schne<i><span class="en">id. ad Veg. 6, 12, p. 105</span></i>.</div>
