    <div class="alpheios-lex-entry" lemma-id="n3038" body-key=""><b><span class="alpheios-lex-la" lang="lat">ăpŏcălypsis</span></b> ,
			is, f., = <span class="alpheios-lex-greek" lang="grc">ἀποκάλυψις</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a disclosing</i>, <i>revelation</i>
			(eccl. Lat.): 
				“<span class="alpheios-lex-la" lang="lat">apocalypsim habet,</span>”
				 <i><span class="en">Vulg.
					1 Cor. 14, 26</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">apocalypsis Jesu Christi,</span>”
				 <i><span class="en">ib.
					Apoc. 1, 1</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Joannis,</span>”
				<i>the Revelation</i>, <i>the Apocalypse</i>,
				 <i><span class="en">Tert. adv. Marc. 4, 5</span></i>
			.</div>
