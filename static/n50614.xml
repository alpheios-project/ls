    <div class="alpheios-lex-entry" lemma-id="n50614" body-key=""><b><span class="alpheios-lex-la" lang="lat">versātĭo</span></b> ,
			ōnis, f.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>a turning round.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">machinarum,</span>”
				 <i><span class="en">Vitr.
					10, 1</span></i>
			; <i><span class="en">10, 6</span></i>; <i><span class="en">10, 8</span></i>; 10, 10; 
				“<span class="alpheios-lex-la" lang="lat">10, 14: oculi,</span>”
				 <i><span class="en">Plin.
					8, 33, 51, § 121</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>, <i>a changing</i>, <i>alteration</i>, <i>mutation</i>: 
				“<span class="alpheios-lex-la" lang="lat">rerum sursum ac deorsum euntium,</span>”
				 <i><span class="en">Sen. Tranq. 11, 10</span></i>
			.</div>
