    <div class="alpheios-lex-entry" lemma-id="n4316" body-key=""><b><span class="alpheios-lex-la" lang="lat">Attălenses</span></b> , ium,
		m., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the
				inhabitants of the town Attalea</i> or <i>Attalia.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<i>In Pamphylia</i>, <i><span class="en">Cic. Agr. 1,
			2</span></i>; <i><span class="en">2, 19</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<i>In the region of Mysia</i>, <i><span class="en">Plin. 5, 30,
				33, § 126</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>C.</b>
			<i>In Galatia</i>, <i><span class="en">Plin. 5, 32,
				42, § 147</span></i>.</div>
