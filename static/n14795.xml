    <div class="alpheios-lex-entry" lemma-id="n14795" body-key=""><b><span class="alpheios-lex-la" lang="lat">drŏmas</span></b> , ădis,
			m., = <span class="alpheios-lex-greek" lang="grc">δρομάς</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A dromedary</i>, <i><span class="en">Liv. 37,
			40</span></i>; <i><span class="en">Curt. 5, 2, 5</span></i>;
				<i><span class="en">Vop. Aur. 28</span></i>.—Called
			also <b><span class="alpheios-lex-la" lang="lat">drŏmĕdārĭus</span></b> ,
				ii, m., Hier. Vit. Malchi, 10; <i><span class="en">Vulg. Isa.
				60, 6</span></i>.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b><span class="alpheios-lex-la" lang="lat">Drŏmas</span></b> ,
				ădis, m., <i>the name of one of Actaeon's hounds</i>, <i><span class="en">Ov. M. 3,
				217</span></i>.</div>
