			ae, m., = <span class="alpheios-lex-greek" lang="grc">Ὠλενίδης</span>, <i>the son of Olenus</i>: 
				“<span class="alpheios-lex-la" lang="lat">Phoceaque Oleniden,</span>”
				 <i><span class="en">Val.
					Fl. 3, 204</span></i>
			.</div>
