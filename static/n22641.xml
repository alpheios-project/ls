    <div class="alpheios-lex-entry" lemma-id="n22641" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-culpātus</span></b> , a, um,
			adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>blameless</i> (<b>poet.</b> and
			post-class.): 
				“<span class="alpheios-lex-la" lang="lat">vita fidesque,</span>”
				 <i><span class="en">Ov. M.
					9, 673</span></i>
			; cf.: 
				“<span class="alpheios-lex-la" lang="lat">vita inculpatissima,</span>”
				 <i><span class="en">Gell.
					14, 2, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">virtus,</span>”
				 <i><span class="en">id.
					2, 6, 10</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">inculpatum visum esse,</span>”
				 <i><span class="en">id. 7, 22, 4 al.</span></i>
			— <i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">inculpātē</span></b> , <i>without blame</i>, Cod. Th. 9, 7, 1; Ambros. de Jac. et Vit.
			Beat. 2, 3, § 12; <i><span class="en">Hier. in Matt. 5,
				10, 61</span></i>.</div>
