    <div class="alpheios-lex-entry" lemma-id="n291" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ăcămas</span></b> , antis,
			m., = <span class="alpheios-lex-greek" lang="grc">Ἀκάμας</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A son of Theseus and Phœdra</i>, <i><span class="en">Verg. A. 2,
				262</span></i>. —</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A servant of Vulcan</i>, <i><span class="en">Val. Fl. 1,
				583</span></i>. —</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>A promontory of Cyprus</i>, <i><span class="en">Plin. 5, 31,
				35, § 129</span></i>.</div>
