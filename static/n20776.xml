<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n20776" body-key=""><b><span class="alpheios-lex-la" lang="lat">Hirpīni</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Irpīni</span></b> ), ōrum,
			m., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a people of Lower Italy</i>, <i>between
			Campania</i>, <i>Lucania</i>, <i>and
				Apulia</i>, <i><span class="en">Plin. 3, 11, 16, § 99</span></i>;
				<i><span class="en">Liv. 22, 61, 11</span></i>; <i><span class="en">23, 37</span></i>; <i><span class="en">27, 15</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">in Hirpinis,</span>”
				<i>in the territory of the Hirpini</i>,
				 <i><span class="en">Cic.
					Div. 1, 36, 79</span></i>
			; <i><span class="en">Plin. 2, 93, 95, § 208</span></i>; so, 
				“<span class="alpheios-lex-la" lang="lat">ex Hirpinis,</span>”
				 <i><span class="en">Liv.
					22, 13 <i>init.</i></span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">in Hirpinis,</span>”
				 <i><span class="en">id. 23,
					1</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			Deriv. <b><span class="alpheios-lex-la" lang="lat">Hirpīnus</span></b> 
				(<b><span class="alpheios-lex-la" lang="lat">Irp-</span></b> ),
				a, um, adj., <i>of</i>
			or <i>belonging to the Hirpini</i>: 
				“<span class="alpheios-lex-la" lang="lat">ager, fundus,</span>”
				 <i><span class="en">Cic.
					Agr. 3, 2, 8</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">pubes,</span>”
				 <i><span class="en">Sil.
					8, 571</span></i>
			.</div>
