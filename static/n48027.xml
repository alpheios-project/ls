    <div class="alpheios-lex-entry" lemma-id="n48027" body-key=""><b><span class="alpheios-lex-la" lang="lat">tē^trastȳlos</span></b> ,
		on, adj., = <span class="alpheios-lex-greek" lang="grc">τετράστυλος,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>having four columns.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Adj.</i>: 
				“<span class="alpheios-lex-la" lang="lat">frons loci,</span>”
				 <i><span class="en">Vitr. 3,
					2</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cava aedium,</span>”
				 <i><span class="en">id. 6,
				3</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">tē^trastȳlon</span></b> , i,
				n., <i>a building with four
			columns</i>, <i>a tetrastyle</i>,
					<i><span class="en">Capitol. Gord. 32</span></i>;
					<i><span class="en">Inscr. Orell. 2270</span></i>.</div>
