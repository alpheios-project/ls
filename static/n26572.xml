    <div class="alpheios-lex-entry" lemma-id="n26572" body-key=""><b><span class="alpheios-lex-la" lang="lat">lĭgāmen</span></b> ,
			ĭnis, n.
		1. ligo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a band, tie, bandage</i> (<b>poet.</b> and in post-Aug. prose): 
				“<span class="alpheios-lex-la" lang="lat">Sidoniae nocturna ligamina mitrae,</span>”
				 <i><span class="en">Prop. 2, 22, 15</span></i>
			; <i><span class="en">Ov. M. 14, 230</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">ligamina vitium,</span>”
				 <i><span class="en">Col.
					11, 2, 92</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ligamina herbarum,</span>”
				 <i><span class="en">id.
					12, 8, 1</span></i>
			.—In sing.: 
				“<span class="alpheios-lex-la" lang="lat">papyri ligamen,</span>”
				<i>a bandage, ligature</i>,
				 <i><span class="en">Col.
					6, 6, 4</span></i>
			.</div>
