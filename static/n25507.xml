    <div class="alpheios-lex-entry" lemma-id="n25507" body-key=""><b><span class="alpheios-lex-la" lang="lat">Labrandĭus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Labradius</span></b>  or <b><span class="alpheios-lex-la" lang="lat">Lă-brăyndus</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
				v.
				infra
			), m., = <span class="alpheios-lex-greek" lang="grc">Λαβράνδεος</span> (<span class="alpheios-lex-greek" lang="grc">Λαβράδεος</span>), <i>a surname of Jupiter,
				derived from the town of Labranda, in Caria, where there was a
				temple to him</i>, Enn. ap. <i><span class="en">Lact. 1,
			13</span></i> (<i><span class="en">Enn. Euhem. 52, p. 173</span></i>
			Vahl.): 
				“<span class="alpheios-lex-la" lang="lat">in Labrayndi Jovis fonte,</span>”
				 <i><span class="en">Plin.
					32, 2, 7, § 16</span></i>
			 Jan.</div>
