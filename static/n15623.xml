    <div class="alpheios-lex-entry" lemma-id="n15623" body-key=""><b><span class="alpheios-lex-la" lang="lat">ē-mercor</span></b> , ātus,
		1, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>v. dep.
				a.</i>, <i>to buy up</i>, <i>purchase</i>, <i>bribe</i> (post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">adulterium ingentibus donis,</span>”
				 <i><span class="en">Tac.
					A. 13, 44</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">aditum principis,</span>”
				 <i><span class="en">id. ib. 16, 1</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">avaritiam praefecti,</span>”
				 <i><span class="en">id. ib. 12, 45</span></i>
			; cf. <i><span class="en">id. ib. 12, 14</span></i>.!*? <b><span class="alpheios-lex-la" lang="lat">emercor</span></b> , <i>part.
				perf.</i> in <i>pass.</i> signif.,
					<i><span class="en">Amm. 21, 6, 8</span></i>; <i><span class="en">26, 2,
			4</span></i>.</div>
