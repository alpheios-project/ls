    <div class="alpheios-lex-entry" lemma-id="n3792" body-key=""><b><span class="alpheios-lex-la" lang="lat">Artĕmĭsĭa</span></b> ,
			ae, f., = <span class="alpheios-lex-greek" lang="grc">Ἄρτεμισία</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Wife of King Mausolus</i>, <i>in
			Caria</i>, <i>to whom</i>, <i>after his
				death</i>, <i>she built the renowned
			Mausoleum</i>, <i><span class="en">Gell. 10,
			18</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b><span class="alpheios-lex-la" lang="lat">artĕmĭsĭa</span></b> ,
			ae, f., <i>the plant
			mugwort</i>, <i><span class="en">Plin. 25, 7, 36, § 73</span></i>;
					<i><span class="en">App. Herb. 10</span></i>.</div>
