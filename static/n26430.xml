    <div class="alpheios-lex-entry" lemma-id="n26430" body-key=""><b><span class="alpheios-lex-la" lang="lat">lēvor</span></b>  (<b><span class="alpheios-lex-la" lang="lat">laevor</span></b> ), ōris, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>smoothness</i>: 
				“<span class="alpheios-lex-la" lang="lat">haud sine principali aliquo levore,</span>”
				 <i><span class="en">Lucr.
					2, 423</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">spectantur in chartis tenuitas, densitas,
					candor, levor,</span>”
				 <i><span class="en">Plin.
					13, 12, 24, § 78</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">levorem corpori afferre,</span>”
				 <i><span class="en">id.
					30, 14, 43, § 127</span></i>
			; <i><span class="en">37, 4, 15,
				§ 56</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">vocis,</span>”
				 <i><span class="en">Lucr.
					4, 552</span></i>
			.</div>
