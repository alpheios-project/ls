    <div class="alpheios-lex-entry" lemma-id="n43561" body-key=""><b><span class="alpheios-lex-la" lang="lat">sēmĭ-somnus</span></b> , a,
		um, and <b><span class="alpheios-lex-la" lang="lat">sēmĭ-somnis</span></b> , e,
			adj.
		somnus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>half-asleep</i>, <i>sleepy</i>, <i>drowsy</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">tibi siccae semisomnae,</span>”
				 <i><span class="en">Plaut. Curc. 1, 2, 22</span></i>
			; <i><span class="en">Cic. Fam. 7, 1, 1</span></i>; <i><span class="en">id. Verr. 2, 5, 36, § 95</span></i> Zumpt
				<i>N. cr.;</i>
			<i><span class="en">Sall. J.
				21, 2</span></i>; <i><span class="en">Liv. 9, 24</span></i>; <i><span class="en">9, 37</span></i>; <i><span class="en">25, 39</span></i> Drak.; 30, 5
				<i>fin.</i>; 37, 20; 40, 15; <i><span class="en">Tac. A. 1,
			51</span></i>; <i><span class="en">4, 25</span></i>; <i><span class="en">id. H. 5,
			22</span></i>: sopor, Cael. ap. <i><span class="en">Quint. 4,
				2, 124</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">cor,</span>”
				 <i><span class="en">Phaedr. 4, 14, 13</span></i>
			.—Form semisomnis, <i><span class="en">Sen. Brev. Vit. 14, 4</span></i>.</div>
