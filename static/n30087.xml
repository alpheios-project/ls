    <div class="alpheios-lex-entry" lemma-id="n30087" body-key=""><b><span class="alpheios-lex-la" lang="lat">Mūsaeus</span></b> , i, m.,
		= <span class="alpheios-lex-greek" lang="grc">Μουσαῖος</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A famous Greek poet in the time of Orpheus</i>,
				<i><span class="en">Cic.
				Tusc. 1, 41, 98</span></i>; <i><span class="en">id. N. D.
				1, 15, 41</span></i>; <i><span class="en">Verg. A. 6,
			667</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A Roman surname</i>, <i><span class="en">Inscr.
				Grut. 701, 3</span></i>.</div>
