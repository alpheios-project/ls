    <div class="alpheios-lex-entry" lemma-id="n35274" body-key=""><b><span class="alpheios-lex-la" lang="lat">pernĭcĭābĭlis</span></b> ,
			e, adj.
		pernicies, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>destructive</i>, <i>ruinous</i>, <i>pernicious</i>: 
				“<span class="alpheios-lex-la" lang="lat">id perniciabile reo,</span>”
				 <i><span class="en">Tac. A.
					4, 34</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">nix oculis perniciabilis,</span>”
				 <i><span class="en">Curt.
					7, 3, 13</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">pestilentia quae magis in morbos longos quam in
					perniciabilis evasit,</span>”
				 <i><span class="en">Liv.
					27, 23, 7</span></i>
			.</div>
