    <div class="alpheios-lex-entry" lemma-id="n22718" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-dēfensus</span></b> , a, um,
			adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unprotected</i>, <i>undefended</i>
			(perh. not ante-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">Capua deserta indefensaque,</span>”
				 <i><span class="en">Liv.
					25, 15, 2</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">indefensi, inulti,</span>”
				 <i><span class="en">id.
					4, 28, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">inauditus et indefensus,</span>”
				 <i><span class="en">Tac. A.
					2, 77</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">conjux,</span>”
				 <i><span class="en">id. ib. 11, 34</span></i>
			.— <i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">indēfensē</span></b> , <i>without defence</i>, <i><span class="en">Cod. Just. 4, 18,
				2 <i>fin.</i></span></i></div>
