    <div class="alpheios-lex-entry" lemma-id="n26877" body-key=""><b><span class="alpheios-lex-la" lang="lat">lŏba</span></b> , ae, f.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>The haulm</i> or <i>straw of Indian
				millet</i>, <i><span class="en">Plin. 11, 7, 10, §
			55</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Nightshade, also called</i> strychnos,
					<i><span class="en">App. Herb. 74</span></i>.</div>
