    <div class="alpheios-lex-entry" lemma-id="n1797" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ălĕsĭa</span></b> ,
		ae, f., = <span class="alpheios-lex-greek" lang="grc">Ἀλεσία</span>, Diod. Sic., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a city of the Mandubii in Celtic Gaul</i>, now
				<i>Alise</i> in the <i>Dép. de la Cōte d' Or</i>, <i><span class="en">Caes. B. G.
				7, 68</span></i>; <i><span class="en">id. B. C. 3, 47</span></i>; <i><span class="en">Vell. 2,
			47</span></i>.—Also, <b><span class="alpheios-lex-la" lang="lat">Ălexĭa</span></b> , ae,
			f., = <span class="alpheios-lex-greek" lang="grc">Ἀλεξία</span> Strabo,
				<i><span class="en">Flor. 2,
				2</span></i>; cf. Mannert Gall. 175.</div>
