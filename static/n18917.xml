    <div class="alpheios-lex-entry" lemma-id="n18917" body-key=""><b><span class="alpheios-lex-la" lang="lat">frŭtĭcōsus</span></b> ,
			a, um, adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of shrubs</i> or <i>bushes</i>, <i>shrubby</i>, <i>bushy</i>: 
				“<span class="alpheios-lex-la" lang="lat">vimina,</span>”
				 <i><span class="en">Ov. M.
					6, 344</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">(aizoum) a radice,</span>”
				 <i><span class="en">Plin.
					25, 13, 102, § 161</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">arbor (terebinthus),</span>”
				 <i><span class="en">id.
					13, 6, 12, § 54</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">rutae rami fruticosiores,</span>”
				 <i><span class="en">id.
					20, 13, 51, § 131</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">calamus fruticosissimus qui vocatur donax,</span>”
				 <i><span class="en">id.
					16, 36, 66, § 165</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">litora,</span>”
				 <i><span class="en">Ov. H.
					2, 121</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">mare,</span>”
				 <i><span class="en">Plin.
					6, 22, 24, § 87</span></i>
			.</div>
