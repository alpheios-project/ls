    <div class="alpheios-lex-entry" lemma-id="n22308" body-key=""><b><span class="alpheios-lex-la" lang="lat">inceptĭo</span></b> , ōnis,
			f.
		incipio, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a beginning</i>, <i>undertaking</i>
			(rare but class.): 
				“<span class="alpheios-lex-la" lang="lat">tam praeclari operis,</span>”
				 <i><span class="en">Cic. Ac. 2, 38, 119</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">patrociniorum,</span>”
				 <i><span class="en">App. Mag. p. 317, 5</span></i>
			.—<b>
				<i>Absol.</i>
			</b> (opp. depositio), <i><span class="en">Quint. 11, 3, 46</span></i>.—
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>enterprise</i>,
				<i>undertaking</i>: 
				“<span class="alpheios-lex-la" lang="lat">inceptio est amentium, non amantium,</span>”
				 <i><span class="en">Ter.
					And. 1, 3, 13</span></i>
			.</div>
