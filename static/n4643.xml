    <div class="alpheios-lex-entry" lemma-id="n4643" body-key=""><b><span class="alpheios-lex-la" lang="lat">autŏmătus</span></b> , um
		(os, on), adj., = <span class="alpheios-lex-greek" lang="grc">αὐτόματος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>self - moving</i>, <i>voluntary</i>,
				<i>spontaneous</i>: 
				“<span class="alpheios-lex-la" lang="lat">plausus,</span>”
				 <i><span class="en">Petr. 50, 1</span></i>
			.—Hence, <i>subst.</i>: <b><span class="alpheios-lex-la" lang="lat">autŏmătŏn</span></b>  or <b><span class="alpheios-lex-la" lang="lat">-um</span></b> , <i>n</i>, <i>a self-moving machine</i>, <i>an
				automaton</i>, <i><span class="en">Vitr. 9, 9</span></i>;
				<i><span class="en">Petr. 54, 4</span></i>; <i><span class="en">140, 10</span></i>;
			* <i><span class="en">Suet. Claud. 34 <i>fin.</i></span></i></div>
