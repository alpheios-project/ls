    <div class="alpheios-lex-entry" lemma-id="n13814" body-key=""><b><span class="alpheios-lex-la" lang="lat">dictātōrĭus</span></b> ,
			a, um, adj.
		dictator, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>belonging to a dictator;
				dictatorial</i>: 
				“<span class="alpheios-lex-la" lang="lat">gladius,</span>”
				 <i><span class="en">Cic.
					Clu. 44, 123</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">majestas,</span>”
				 <i><span class="en">Liv. 4,
					14</span></i>
			; <i><span class="en">8, 30</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">fulmen,</span>”
				 <i><span class="en">id. 6,
					39</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">invidia,</span>”
				 <i><span class="en">id.
					22, 26</span></i>
			; cf. 
				“<span class="alpheios-lex-la" lang="lat">animadversio,</span>”
				 <i><span class="en">Vell.
					2, 68 <i>fin.</i></span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">juvenis,</span>”
				i. e. <i>the son of the dictator</i>,
				 <i><span class="en">Liv. 7,
					4</span></i>
			.</div>
