				 <i><span class="en">id.
					Am. 3, 1, 1</span></i>
			; <i><span class="en">Stat. Th. 6, 90</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">intonsi montes, silvosi, incaedui,</span>”
				 <i><span class="en">Serv. Verg. E. 5, 63</span></i>
			.</div>
