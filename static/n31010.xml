    <div class="alpheios-lex-entry" lemma-id="n31010" body-key=""><b><span class="alpheios-lex-la" lang="lat">Nĭsĭbis</span></b>  or <b><span class="alpheios-lex-la" lang="lat">Nĕsĕbis</span></b> ,
			is, f., = <span class="alpheios-lex-greek" lang="grc">Νίσιβις</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A city in Mesopotamia</i>, now <i>Nisibin</i>, <i><span class="en">Plin. 6, 13, 16, § 42</span></i>;
				<i><span class="en">Tac. A.
				15, 5</span></i>; <i><span class="en">Amm. 25, 7, 9</span></i>;
				<i><span class="en">25, 8, 27</span></i>—Hence, </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b><span class="alpheios-lex-la" lang="lat">Nĭsĭbēni</span></b> ,
				ōrum, m., <i>the inhabitants of Nisibis</i>, <i><span class="en">Amm.
				25, 8, 13</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A city in Aria</i>, <i><span class="en">Amm. 23,
				6, 69</span></i>.</div>
