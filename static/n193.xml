    <div class="alpheios-lex-entry" lemma-id="n193" body-key=""><b><span class="alpheios-lex-la" lang="lat">abscessus</span></b> , ūs, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				going away</i>, <i>departure</i>, <i>absence</i>: solis, * <i><span class="en">Cic. N. D.
				1, 10, 24</span></i>; <i><span class="en">Verg. A. 10, 445</span></i>; <i><span class="en">Tac. A. 4,
			57</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">continuus,</span>”
				<i>continued absence</i>,
				 <i><span class="en">id. ib. 6, 38</span></i>
			. —</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Medic. t. t.</b>, <i>an abscess</i>,
				<i><span class="en">Cels. 5,
				7</span></i>; in plur., <i><span class="en">id. 5,
			18</span></i>.</div>
