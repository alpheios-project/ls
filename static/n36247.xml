    <div class="alpheios-lex-entry" lemma-id="n36247" body-key=""><b><span class="alpheios-lex-la" lang="lat">pĭcĕus</span></b> , a, um,
			adj.
		pix. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i>of pitch</i>, <i><span class="en">Lucr. 6,
			135</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>black as
			pitch</i>, <i>pitch-black</i>: 
				“<span class="alpheios-lex-la" lang="lat">piceā crassus caligine,</span>”
				 <i><span class="en">Verg.
					G. 2, 308</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">turbine fumans piceo,</span>”
				 <i><span class="en">id. A.
					3, 573</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">lumen,</span>”
				 <i><span class="en">id. ib. 9, 75</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">nubes,</span>”
				 <i><span class="en">Ov.
					M. 11, 549</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">caelum,</span>”
				 <i><span class="en">Val.
					Fl. 2, 507</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">nimbus,</span>”
				 <i><span class="en">id. 2,
					115</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">oves,</span>”
				 <i><span class="en">id. 3,
					439</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">dentes,</span>”
				 <i><span class="en">Mart.
					2, 41, 7</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">imber piceus crassusque,</span>”
				 <i><span class="en">Plin.
					16, 33, 61, § 143</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">coacti aëris caligo picea,</span>”
				 <i><span class="en">Ambros. in Luc. 7, 20</span></i>
			.</div>
