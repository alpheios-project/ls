    <div class="alpheios-lex-entry" lemma-id="n36935" body-key=""><b><span class="alpheios-lex-la" lang="lat">pŏlymĭtus</span></b> ,
			a, um, adj., = <span class="alpheios-lex-greek" lang="grc">πολύμιτος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>wrought with many treads</i>: 
				“<span class="alpheios-lex-la" lang="lat">alicula,</span>”
				 <i><span class="en">Petr. 40</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ars,</span>”
				<i>the art of weaving</i>,
				 <i><span class="en">Hier. Ep. 64, 12</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">tunica,</span>”
				 <i><span class="en">Vulg.
					Gen. 37, 3</span></i>
			.—<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">pŏly-mĭta</span></b> ,
				ōrum, n., <i>damask</i>, <i><span class="en">Plin. 8, 48, 74, § 198</span></i>;
			also sing.
			<b><span class="alpheios-lex-la" lang="lat">pŏlymĭtum</span></b> ,
			i, <i><span class="en">Vulg. Ezech. 16, 13</span></i>.</div>
