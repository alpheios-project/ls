<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n29946" body-key=""><b><span class="alpheios-lex-la" lang="lat">Mulucha</span></b> , ae, m. and
			f.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Masc., a river in Africa, between Mauritania and
				Numidia</i>, now <i>Maluja</i>, <i><span class="en">Sall. J.
				19, 7</span></i>; <i><span class="en">92,
			5</span></i>; <i><span class="en">110, 8</span></i>;
				<i><span class="en">Mel.
				5, 1, 5</span></i>; <i><span class="en">Plin. 5, 2, 1, §
			35</span></i>.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Fem., a city on this river</i>, <i><span class="en">Flor. 3, 1,
				14</span></i>.</div>
