    <div class="alpheios-lex-entry" lemma-id="n51348" body-key=""><b><span class="alpheios-lex-la" lang="lat">vŏluptŭōsus</span></b> ,
			a, um, adj.
		voluptas, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of gratification</i>, <i>enjoyment</i>, <i>pleasure</i>, or <i>delight; agreeable</i>, <i>pleasant</i>, <i>delightful</i> (post-Aug.), <i><span class="en">Plin. Ep.
				3, 19, 2</span></i>; <i><span class="en">Quint. Decl. 260</span></i>.—<i>Sup.</i>: 
				“<span class="alpheios-lex-la" lang="lat">contionator,</span>”
				 <i><span class="en">Hier. adv. Jovin. 1, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">tempus,</span>”
				 <i><span class="en">Sid. Ep. 2, 9</span></i>
			.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">vŏlup-tŭōsē</span></b> , <i>with pleasure</i> or <i>delight</i>,
					<i><span class="en">Sid. Ep. 5, 20</span></i>.—<i>Comp.</i>, <i><span class="en">Sid. Ep. 1, 9 <i>med.</i></span></i></div>
