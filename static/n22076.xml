    <div class="alpheios-lex-entry" lemma-id="n22076" body-key=""><b><span class="alpheios-lex-la" lang="lat">impŭdīcĭtĭa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inp-</span></b> ), ae,
			f.
		impudicus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unchasteness</i>, <i>immodesty</i>,
				<i>lewdness</i>, <i><span class="en">Plaut. Am.
				2, 2, 189</span></i>; <i><span class="en">Tac. A. 5, 3</span></i>; <i><span class="en">Gell. 18,
				3, 1</span></i>; <i><span class="en">Dig. 1, 6, 2</span></i>;
				<i><span class="en">Tert. Spect. 17</span></i>.—Esp.,
			of unnatural vice, <i><span class="en">Suet. Caes. 52</span></i>; <i><span class="en">id.
				Aug. 71</span></i>; <i><span class="en">id. Vesp.
			13</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, = impudentia, <i>shamelessness</i>: 
				“<span class="alpheios-lex-la" lang="lat">scio fide hercle erili ut soleat inpudicitia
					opprobrari,</span>”
				 <i><span class="en">Plaut. Pers. 2, 2, 11</span></i>
			.</div>
