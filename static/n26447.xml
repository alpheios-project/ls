    <div class="alpheios-lex-entry" lemma-id="n26447" body-key=""><b><span class="alpheios-lex-la" lang="lat">Lĭbănus</span></b> 
		(scanned Lībănus, <i><span class="en">Sedul. 4,
			55</span></i>), i, m., = <span class="alpheios-lex-greek" lang="grc">Λίβανος</span> (Hebr. Lĕbānōn),
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>Mount Lebanon,
				in Syria</i>, <i><span class="en">Plin. 5, 20, 17, § 77</span></i>;
					<i><span class="en">Aus. Techn. Idyll. 12, 5</span></i>;
				<i><span class="en">Vulg. 3
				Reg. 4, 33</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b><span class="alpheios-lex-la" lang="lat">Lībănus</span></b> ,
				a, um, <i>adj., of Lebanon</i>: 
				“<span class="alpheios-lex-la" lang="lat">Libana cedrus,</span>”
				 <i><span class="en">Sedul. 4, 55</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			
			<b>Transf.</b>: <b><span class="alpheios-lex-la" lang="lat">lĭbănus</span></b> , i, <i>c., frankincense</i> (pure Lat. tus),
					<i><span class="en">Vulg. Sirach, 24, 21</span></i>;
				<i><span class="en">39, 18</span></i>.</div>
