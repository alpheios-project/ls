    <div class="alpheios-lex-entry" lemma-id="n42721" body-key=""><b><span class="alpheios-lex-la" lang="lat">Satrĭcum</span></b> , i,
		n., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an
				ancient town in Latium</i>, <i>on the Appian
			Way</i>, <i>near Antium</i>, now <i>Casale di Conca</i>, <i><span class="en">Cic. Q. Fr. 3, 1, 2, § 4</span></i>; 
			
			<i><span class="en">Liv. 2,
			39</span></i>; <i><span class="en">6, 8</span></i>; <i><span class="en">6, 22</span></i>; 9,
			16.—Hence, <b><span class="alpheios-lex-la" lang="lat">Sa-trĭcāni</span></b> ,
			ōrum, m., <i>the
				inhabitants of Satricum</i>, <i><span class="en">Liv. 9,
			12</span></i>; <i><span class="en">28,
		11</span></i>.</div>
