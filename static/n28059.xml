    <div class="alpheios-lex-entry" lemma-id="n28059" body-key=""><b><span class="alpheios-lex-la" lang="lat">Marmărĭdes</span></b> ,
		ae, m., = <span class="alpheios-lex-greek" lang="grc">Μαρμαρίδης</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a man from Marmarica</i> (v. Marmaricus), <i>a Marmarican</i>: 
				“<span class="alpheios-lex-la" lang="lat">cuspide Marmaridae Corythi,</span>”
				 <i><span class="en">Ov. M.
					5, 124</span></i>
			.—<b><span class="alpheios-lex-la" lang="lat">Marmăridae</span></b> , ārum,
				m., <i>the inhabitants of
			Marmarica</i>, <i><span class="en">Plin. 5, 5, 5, § 33</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">Marmaridae Psylli,</span>”
				 <i><span class="en">Luc.
					9, 894</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">phalanx Marmaridūm,</span>”
				i. e. <i>of the Carthaginians</i>,
				 <i><span class="en">Sil.
					5, 184</span></i>
			.</div>
