    <div class="alpheios-lex-entry" lemma-id="n32811" body-key=""><b><span class="alpheios-lex-la" lang="lat">oppŏsĭtĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">obp-</span></b> ),
			ōnis, f.
		oppono, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an opposing</i>, <i>opposition</i>
			(class.): 
				“<span class="alpheios-lex-la" lang="lat">disparatum est id, quod ab aliquā re
					per oppositionem negationis separatur, hoc modo: sapere, et
					non sapere,</span>”
				 <i><span class="en">Cic.
					Inv. 1, 28, 42</span></i>
			; <i><span class="en">Gell. 6, 1, 4</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">scientiae,</span>”
				 <i><span class="en">Vulg. 1
					Tim. 6, 20</span></i>
			.</div>
