    <div class="alpheios-lex-entry" lemma-id="n4254" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ăthĕsis</span></b>  or <b><span class="alpheios-lex-la" lang="lat">Ătĕsis</span></b> ,
