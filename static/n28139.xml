    <div class="alpheios-lex-entry" lemma-id="n28139" body-key=""><b><span class="alpheios-lex-la" lang="lat">Massaesȳli</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Masaes-</span></b> ),
