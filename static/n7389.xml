    <div class="alpheios-lex-entry" lemma-id="n7389" body-key=""><b><span class="alpheios-lex-la" lang="lat">centaurēum</span></b>  or <b><span class="alpheios-lex-la" lang="lat">-ĭon</span></b> , i, n.
		(access. form <b><span class="alpheios-lex-la" lang="lat">centaurĭa</span></b> ,
			ae, f., <i><span class="en">App. Herb.
			34</span></i> and 35), = <span class="alpheios-lex-greek" lang="grc">κενταύρειον</span>
		and <span class="alpheios-lex-greek" lang="grc">κενταύριον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>centaury</i>, <i>a
				plant of two kinds</i>: majus, Centaurea centaurium, Linn.; and
			minus, Gentiana centaurium, id.; <i><span class="en">Plin. 25, 6,
				30, § 66</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">ferum,</span>”
				 <i><span class="en">Lucr.
					2, 401</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">tristia,</span>”
				 <i><span class="en">id. 4,
					124</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Thessala,</span>”
				 <i><span class="en">Luc.
					9, 918</span></i>
			; <i><span class="en">Verg. G. 4, 270</span></i>.</div>
