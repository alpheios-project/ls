    <div class="alpheios-lex-entry" lemma-id="n36416" body-key=""><b><span class="alpheios-lex-la" lang="lat">piscātor</span></b> , ōris,
			m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				fisherman</i>, <i>fisher</i>, <i><span class="en">Plaut. Rud.
				4, 3, 48</span></i>; <i><span class="en">55</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">lanii, coqui, fartores, piscatores,</span>”
				 <i><span class="en">Ter.
					Eun. 2, 2, 26</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">piscatores ad se convocat,</span>”
				 <i><span class="en">Cic.
					Off. 3, 14, 58</span></i>
			; <i><span class="en">Juv. 4, 26</span></i>; <i><span class="en">Sen. Ep.
				55, 6</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">piscatoris instrumentum,</span>”
				 <i><span class="en">Paul. Sent. 3, 6, 66</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">PISCATORES PROPOLAE,</span>”
				 <i><span class="en">Inscr. Fabr. p. 731</span></i>
			, n. 450: 
				“<span class="alpheios-lex-la" lang="lat">PATRONVS CORPORIS PISCATORVM,</span>”
				 <i><span class="en">Inscr. Orell. 4115</span></i>
			.—Fig.: 
				“<span class="alpheios-lex-la" lang="lat">piscatores hominum,</span>”
				 <i><span class="en">Vulg.
					Matt. 4, 19</span></i>
			.</div>
