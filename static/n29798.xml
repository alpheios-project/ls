    <div class="alpheios-lex-entry" lemma-id="n29798" body-key=""><b><span class="alpheios-lex-la" lang="lat">mūcōsus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">mucc-</span></b> ), a, um,
			adj.
		mucus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>slimy, mucous</i> (post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">cruenta et mucosa ventris proluvies,</span>”
				 <i><span class="en">Col.
					1, 7, 1</span></i>
			; <i><span class="en">6, 7, 1</span></i>;
			Paul. ex <i><span class="en">Fest. p. 158</span></i> Müll.: 
				“<span class="alpheios-lex-la" lang="lat">exulceratio,</span>”
				 <i><span class="en">Cels. 5, 28, 15</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, = stultus (opp. emunctae naris),
			Acron. ad <i><span class="en">Hor. S. 1, 4, 8</span></i>.</div>
