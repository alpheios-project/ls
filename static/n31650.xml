    <div class="alpheios-lex-entry" lemma-id="n31650" body-key=""><b><span class="alpheios-lex-la" lang="lat">objurgātor</span></b> ,
		ōris, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				chider, rebuker, blamer</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">hic noster objurgator,</span>”
				 <i><span class="en">Cic.
					Agr. 3, 3, 11</span></i>
			; 
				“<span class="alpheios-lex-la" lang="lat">opp. accusator,</span>”
				 <i><span class="en">id. Verr. 2, 3, 2, § 4</span></i>
			.—In plur.: 
				“<span class="alpheios-lex-la" lang="lat">benevoli,</span>”
				 <i><span class="en">Cic.
					N. D. 1, 3, 5</span></i>
			; <i><span class="en">id. Div. 1, 49, 111</span></i>; <i><span class="en">Sen. Ep.
				9, 20</span></i>.</div>
