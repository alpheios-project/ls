    <div class="alpheios-lex-entry" lemma-id="n305" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ăcastus</span></b> , i,
		m., = <span class="alpheios-lex-greek" lang="grc">Ἄκαστος</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Son of Pelias</i>, <i>king of
			Thessaly</i>, <i>husband of Astydamia or
			Cretheis</i>, <i>and father of Laodamia</i>, <i><span class="en">Ov. M. 8,
				306</span></i>; <i><span class="en">11, 410 al.</span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>The name of one of Cicero's slaves</i>, <i><span class="en">Cic. Att.
				7, 1 al.</span></i></div>
