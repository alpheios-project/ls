    <div class="alpheios-lex-entry" lemma-id="n34667" body-key=""><b><span class="alpheios-lex-la" lang="lat">per-blandus</span></b> , a, um, adj.,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>very
			courteous</i> or <i>charming</i>, <i>very engaging</i>, <i>very bland</i>: 
				“<span class="alpheios-lex-la" lang="lat">successor,</span>”
				 <i><span class="en">Cic.
					Q. Fr. 1, 2, 3</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">oratio,</span>”
				 <i><span class="en">Liv.
					23, 10, 1</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">adulatio,</span>”
				 <i><span class="en">Juvenc. 1, 705</span></i>
			.— <i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">perblandē</span></b> , <i>very
				winningly</i>: 
				“<span class="alpheios-lex-la" lang="lat">aliquem salutare,</span>”
				 <i><span class="en">Macr. S. 1, 2, 16</span></i>
			.</div>
