    <div class="alpheios-lex-entry" lemma-id="n19202" body-key=""><b><span class="alpheios-lex-la" lang="lat">Gălătēa</span></b> ,
		ae, f., =<span class="alpheios-lex-greek" lang="grc">Γαλάτεια</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A seanymph</i>, <i><span class="en">Ov. M. 13,
				738</span></i>; <i><span class="en">789</span></i>; <i><span class="en">839</span></i> sq.; <i><span class="en">Verg. A. 9,
				103</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A rustic maiden</i>, <i><span class="en">Verg. E. 1,
				31</span></i>; <i><span class="en">3, 64</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>A female friend of Horace</i>, to whom C. 3, 27 is
			addressed.</div>
