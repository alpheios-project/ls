    <div class="alpheios-lex-entry" lemma-id="n21082" body-key=""><b><span class="alpheios-lex-la" lang="lat">Hyas</span></b> , antis
		(acc. Hyān, <i><span class="en">Ov. F. 5,
		179</span></i>), m., = <span class="alpheios-lex-greek" lang="grc">Ὕας</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a son of
			Atlas</i>, <i>and father</i> or <i>brother of the Hyades</i>, <i><span class="en">Hyg. Fab.
				192</span></i>; <i><span class="en">Ov. F. 5, 170</span></i>.—Hence, Sidus
			Hyantis, <i>the Hyades</i>, <i><span class="en">id. ib. 5,
				734</span></i>.</div>
