    <div class="alpheios-lex-entry" lemma-id="n24836" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ĭŏcasta</span></b>  (<b><span class="alpheios-lex-la" lang="lat">quadrisyl.</span></b> ), ae, and
			<b><span class="alpheios-lex-la" lang="lat">Ĭŏcastē</span></b> ,
		ēs, f., = <span class="alpheios-lex-greek" lang="grc">Ἰοκάστη,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the wife of
				Lāïus</i>, <i>and mother of
				Œdipus</i>, <i>whom she married
				unknowingly</i>, <i>and had by him Eteocles and
				Polynices.</i>—Form Iocasta, <i><span class="en">Stat. Th. 1,
				681</span></i>; <i><span class="en">Hyg. Fab. 66</span></i>.—Form
			Iocaste, <i><span class="en">Hyg. Fab. 67</span></i>; <i><span class="en">242</span></i>.</div>
