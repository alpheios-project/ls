    <div class="alpheios-lex-entry" lemma-id="n30687" body-key=""><b><span class="alpheios-lex-la" lang="lat">nĕgōtĭātrix</span></b>  (<b><span class="alpheios-lex-la" lang="lat">nĕgōc-</span></b> ), īcis,
			f.
		negotiator, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>she that carries on a business, a female trader</i>
			(post-class.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">cum testatrix negotiatrix fuerit,</span>”
				 <i><span class="en">Dig. 34, 2, 32, § 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">FRVMENTARIA,</span>”
				 <i><span class="en">Inscr. Orell. 3093</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">LEGVMINARIA,</span>”
				 <i><span class="en">Inscr. Murat. 935, 5</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>, <i>she that brings
			about</i> a thing, <i><span class="en">Tert. adv. Marc. 2,
			3</span></i>.</div>
