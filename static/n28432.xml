    <div class="alpheios-lex-entry" lemma-id="n28432" body-key=""><b><span class="alpheios-lex-la" lang="lat">Mĕlampūs</span></b> ,
			pŏdis, m., = <span class="alpheios-lex-greek" lang="grc">Μελάμπους</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Son of Amythāon, a celebrated physician
				and soothsayer</i>, <i><span class="en">Cic. Leg. 2, 13, 33</span></i>; <i><span class="en">Verg. G. 3,
				550</span></i>; <i><span class="en">Stat. Th. 3,
			452</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Son of Atreus</i>, <i><span class="en">Cic. N. D.
				3, 21, 53</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>Name of a dog</i>, <i><span class="en">Ov. M. 3,
				206</span></i>.</div>
