    <div class="alpheios-lex-entry" lemma-id="n2328" body-key=""><b><span class="alpheios-lex-la" lang="lat">Amphĭpŏlis</span></b> ,
		is, f., = <span class="alpheios-lex-greek" lang="grc">Ἀμφίπολις</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a distinguished city in Macedonia</i>, now <i>Neokhorio</i>, <i><span class="en">Plin. 4, 10,
				17, § 38</span></i>; <i><span class="en">Liv. 45,
			9</span></i>; <i><span class="en">45,
			29</span></i>.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			Derivv. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<b><span class="alpheios-lex-la" lang="lat">Amphĭpŏlītes</span></b> ,
			ae, m., = <span class="alpheios-lex-greek" lang="grc">Ἀμφιπολίτης</span>, <i>an Amphipolitan</i>,
				<i><span class="en">Varr. R. R. 1,
			1</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b><span class="alpheios-lex-la" lang="lat">Amphĭpŏlītānus</span></b> ,
				a, um, adj., <i>belonging
				to Amphipolis</i>, <i><span class="en">Just. 14 <i>fin.</i></span></i></div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
