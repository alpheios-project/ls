    <div class="alpheios-lex-entry" lemma-id="n29196" body-key=""><b><span class="alpheios-lex-la" lang="lat">mĭnūtĭo</span></b> ,
			ōnis, f.
		minuo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a lessening, diminishing</i> (post-Aug.); 
				“<span class="alpheios-lex-la" lang="lat">trop., opp. incrementum,</span>”
				 <i><span class="en">Quint. 8, 4, 28</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">rerum,</span>”
				 <i><span class="en">id.
					6, 3, 52</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">capitis, i. e. deminutio,</span>”
				 <i><span class="en">Gell.
					1, 12, 9</span></i>
			; <i><span class="en">Dig. 4, 5, 1</span></i>; <i><span class="en">4, 5, 5</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">sanguinis,</span>”
				<i>blood-letting, bleeding</i>,
				 <i><span class="en">Veg. Vet. 1, 28, 1</span></i>
			; so, 
				“<span class="alpheios-lex-la" lang="lat">minutio alone: cum praescriptis minutionis
					observantiis,</span>”
				 <i><span class="en">id. ib. 1, 17, 13</span></i>
			.</div>
