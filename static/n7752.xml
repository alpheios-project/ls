    <div class="alpheios-lex-entry" lemma-id="n7752" body-key=""><b><span class="alpheios-lex-la" lang="lat">Chăron</span></b> , ontis
		(ōnis, <i><span class="en">Fulg. Myth. 1</span></i>),
		m., = <span class="alpheios-lex-greek" lang="grc">Χάρων</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Charon</i>, <i>a ferryman in the Lower
				World</i>, <i><span class="en">Cic. N. D. 3, 17, 43</span></i>; <i><span class="en">Verg. A. 6,
				299</span></i>; <i><span class="en">id. Cul. 2, 15</span></i>; <i><span class="en">Sen. Herc. Fur. 771</span></i>. —Hence,
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b><span class="alpheios-lex-la" lang="lat">Chărōnēus</span></b> , a,
			um, adj., <i>of Charon</i>, <i>of the Lower World</i>: 
				“<span class="alpheios-lex-la" lang="lat">scrobes,</span>”
				<i>deep</i>,
				 <i><span class="en">Plin.
					2, 93, 95, § 208</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A Theban</i>, <i><span class="en">Nep.
				Pelop. 2, 5</span></i>.</div>
