    <div class="alpheios-lex-entry" lemma-id="n45697" body-key=""><b><span class="alpheios-lex-la" lang="lat">styptĭcus</span></b> , a, um,
			adj., = <span class="alpheios-lex-greek" lang="grc">στυπτικός</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>astringent</i>, <i>styptic</i>: 
				“<span class="alpheios-lex-la" lang="lat">medicamenta,</span>”
				 <i><span class="en">Plin.
					24, 13, 73, § 120</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">natura herbae,</span>”
				 <i><span class="en">id.
					32, 9, 36, § 111</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vis,</span>”
				 <i><span class="en">Macr. S. 7, 16 <i>fin.</i></span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vinum,</span>”
				<i>of an acid taste</i>,
				 <i><span class="en">Pall. Jan. 17</span></i>
			; <i><span class="en">id. Oct. 14, 1</span></i>.</div>
