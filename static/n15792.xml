<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n15792" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ĕnīpeus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">trisyl.</span></b> ), i,
		m., = <span class="alpheios-lex-greek" lang="grc">Ἐνῖπεύς</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A river in Thessaly that flows into the
				Penēus</i>, <i><span class="en">Verg. G. 4, 368</span></i>; <i><span class="en">Luc. 7,
			116</span></i>; <i>as a river-god</i>, <i>the
				lover of Tyro</i>, <i>daughter of Salmoneus</i>,
				<i>and by her the father of Pelias and Neleus</i>,
				<i><span class="en">Prop. 1, 13, 21</span></i>; <i><span class="en">3, 19, 13</span></i> (4, 18, 13
			M.); <i><span class="en">Ov.
				M. 6, 116</span></i>; <i><span class="en">Hyg. Fab. 157</span></i>: voc.
			Enīpeu, <i><span class="en">Ov. M. 7,
			229</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A river in Pieria</i>, <i><span class="en">Liv. 44, 8,
				2</span></i>; <i><span class="en">44, 20,
			3</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>A Roman youth</i>, <i><span class="en">Hor. C. 3,
				7, 23</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
