			; <i><span class="en">31, 13</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">imparatus improtectusque,</span>”
				 <i><span class="en">Gell.
					13, 27 <i>fin.</i></span></i>
			; <i><span class="en">7, 3,
		44</span></i>.</div>
