    <div class="alpheios-lex-entry" lemma-id="n22061" body-key=""><b><span class="alpheios-lex-la" lang="lat">imprōtectus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inpr-</span></b> ), a, um,
			adj.
