    <div class="alpheios-lex-entry" lemma-id="n25227" body-key=""><b><span class="alpheios-lex-la" lang="lat">Jēsus</span></b>  (also <b><span class="alpheios-lex-la" lang="lat">Ĭēsus</span></b> , trisyl.), u,
			m., = <span class="alpheios-lex-greek" lang="grc">Ἰησοῦς</span>, a Hebrew
		name; esp., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Jesus</i>: 
				“<span class="alpheios-lex-la" lang="lat">venturum praemisso nomine Jesum,</span>”
				 <i><span class="en">Sedul. 1, 153</span></i>
			; <i><span class="en">Lact. 4, 12, 6</span></i>; 
				“<span class="alpheios-lex-la" lang="lat">Arat. Act. Apost. 1, 274: Nazara, cui felix
					patria est et nomen lësus,</span>”
				 <i><span class="en">Juvenc. 2, 106</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Joshua</i>, <i><span class="en">Prud. Cath. 12,
				173</span></i>; <i><span class="en">Vulg. Act. Apost. 7, 45</span></i>; <i><span class="en">id. Heb. 4,
			8</span></i>; <i><span class="en">Lact. 4, 5, 6 al.</span></i></div>
