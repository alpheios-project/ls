    <div class="alpheios-lex-entry" lemma-id="n48345" body-key=""><b><span class="alpheios-lex-la" lang="lat">tĭlĭa</span></b> , ae,
			f., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the linden</i> or <i>lime-tree.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i><span class="en">Plin. 16,
				14, 25, § 65</span></i>; <i><span class="en">Verg. G. 1,
				173</span></i>; <i><span class="en">2, 449</span></i>; <i><span class="en">4, 183</span></i>; <i><span class="en">Ov. M. 8,
				620</span></i>; <i><span class="en">10, 92</span></i>. — </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>the inner bark of
				the linden</i>, <i>barkbands</i>, <i><span class="en">Plin. 16,
				14, 25, § 65</span></i>; cf. 
				“<span class="alpheios-lex-la" lang="lat">of the elm: corticis interior tilia lepras
					sedat,</span>”
				 <i><span class="en">id.
					24, 8, 33, § 48</span></i>
			.</div>
