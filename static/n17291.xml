    <div class="alpheios-lex-entry" lemma-id="n17291" body-key=""><b><span class="alpheios-lex-la" lang="lat">exsultābundus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">exult-</span></b> ), a, um,
			adj.
		exsulto, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>leaping for joy</i>, <i>exulting</i>
			(postclass.): 
				“<span class="alpheios-lex-la" lang="lat">maesta ac lugentia castra velut exsultabundus
					intrare,</span>”
				 <i><span class="en">Just. 18, 7, 10</span></i>
			; so <i><span class="en">Sol. 5, 20</span></i>.</div>
