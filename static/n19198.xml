    <div class="alpheios-lex-entry" lemma-id="n19198" body-key=""><b><span class="alpheios-lex-la" lang="lat">gălactītes</span></b> , ae,
			m., and <b><span class="alpheios-lex-la" lang="lat">gălactītis</span></b> ,
		ĭdis, f., = <span class="alpheios-lex-greek" lang="grc">γαλακτίτης</span> and <span class="alpheios-lex-greek" lang="grc">γαλακτῖτις</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a precious stone of a milk-white color</i>, <i>otherwise unknown</i>, <i>milk-stone</i>, <i><span class="en">Plin. 37, 10, 59, § 162</span></i>.
			—Called also <b><span class="alpheios-lex-la" lang="lat">gălaxias</span></b> , ae, m., =
				<span class="alpheios-lex-greek" lang="grc">γαλαξίας</span>, <i><span class="en">id.
		ib.</span></i></div>
