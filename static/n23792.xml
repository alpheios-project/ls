    <div class="alpheios-lex-entry" lemma-id="n23792" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-sēpărābĭlis</span></b> ,
			e, adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>that cannot be separated</i>, <i>inseparable</i> (post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">quaedam inter se,</span>”
				 <i><span class="en">Sen. Ep. 118, 85</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">societas,</span>”
				 <i><span class="en">Gell.
					1, 9, 12</span></i>
			.—<i>Comp.</i>: 
				“<span class="alpheios-lex-la" lang="lat">trinitas inseparabilior,</span>”
				 <i><span class="en">Aug. Trin. 15, 23</span></i>
			.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">insēpărā-bĭlĭter</span></b> ,
				<i>inseparably</i> (post-class.),
					<i><span class="en">Macr. Somn. Scip. 1, 22</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">conexa,</span>”
				 <i><span class="en">Lact. 3, 11</span></i>
			.</div>
