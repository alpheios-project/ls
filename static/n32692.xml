<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n32692" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ŏpheltes</span></b> , ae,
		m., = <span class="alpheios-lex-greek" lang="grc">Ὀφέλτης</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>a proper name.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Son of Lycurgus</i>, <i>king of
			Thrace</i>, <i><span class="en">Stat. Th. 5,
			538</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A Trojan warrior</i>, <i>father of
				Euryalus</i>, <i><span class="en">Verg. A. 9,
			201</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>One of the Etruscan seamen</i>, <i><span class="en">Ov. M. 3,
				605</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>IV.</b>
			<i>A Cyzicene</i>, <i><span class="en">Val. Fl. 3,
				198</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
