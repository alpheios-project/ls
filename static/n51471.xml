    <div class="alpheios-lex-entry" lemma-id="n51471" body-key=""><b><span class="alpheios-lex-la" lang="lat">xĕnŏdŏchīum</span></b>  or
			<b><span class="alpheios-lex-la" lang="lat">-ēum</span></b> ,
