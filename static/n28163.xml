    <div class="alpheios-lex-entry" lemma-id="n28163" body-key=""><b><span class="alpheios-lex-la" lang="lat">mastīgĭa</span></b> , ae,
			m., = <span class="alpheios-lex-greek" lang="grc">μαστιγίας</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a scoundrel, rascal,
				rogue</i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b> (anteclass.), <i><span class="en">Plaut.
				Curc. 4, 4, 11</span></i>; <i><span class="en">id. Capt. 3, 4, 69</span></i>; <i><span class="en">3, 5,
			1</span></i>; <i><span class="en">id. Cas. 2, 6, 9</span></i>; <i><span class="en">2, 8,
			10</span></i>; <i><span class="en">id. Most. 1, 1, 1</span></i>; <i><span class="en">3, 1,
			71</span></i>; <i><span class="en">id. Poen. 1, 2, 108</span></i>; <i><span class="en">177</span></i>;
				<i><span class="en">178</span></i>; <i><span class="en">id. Rud. 4, 83</span></i>; <i><span class="en">id. Trin.
				4, 3, 14</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">non manum abstines, mastigia?</span>”
				 <i><span class="en">Ter.
					Ad. 5, 2, 6</span></i>
			.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, f., <i>a
				whip, scourge</i> (late Lat.), <i><span class="en">Sulp.
				Sev. Dial. 2, 3, 6</span></i>.</div>
