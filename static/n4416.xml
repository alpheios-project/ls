    <div class="alpheios-lex-entry" lemma-id="n4416" body-key=""><b><span class="alpheios-lex-la" lang="lat">auctĭōnārĭus</span></b> ,
			a, um, adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>pertaining to an auction</i>, <i>auction-</i>: 
				“<span class="alpheios-lex-la" lang="lat">atria,</span>”
				<i>wherein auctions were held</i>,
				 <i><span class="en">Cic.
					Agr. 1, 3</span></i>
			; <i><span class="en">Inscr. Orell. 3883</span></i> (v.
			atrium): 
				“<span class="alpheios-lex-la" lang="lat">tabulae,</span>”
				<i>catalogues of goods to be sold by auction</i>,
				 <i><span class="en">Cic.
					Cat. 2, 8, 18</span></i>
			.</div>
