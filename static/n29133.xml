    <div class="alpheios-lex-entry" lemma-id="n29133" body-key=""><b><span class="alpheios-lex-la" lang="lat">mĭnĭārĭus</span></b> , a,
			um, adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>belonging to minium</i> or <i>cinnabar</i> (post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">miniarium metallum,</span>”
				<i>a cinnabar mine</i>,
				 <i><span class="en">Plin.
					33, 7, 40, § 118</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">mĭnĭā-rĭa</span></b> ,
				ae, f., or <b><span class="alpheios-lex-la" lang="lat">mĭnĭārĭum</span></b> ,
				ii, n., <i>a cinnabar
				mine</i>, <i><span class="en">Plin. 33, 7, 40, §
		121</span></i>.</div>
