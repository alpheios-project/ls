    <div class="alpheios-lex-entry" lemma-id="n21464" body-key=""><b><span class="alpheios-lex-la" lang="lat">illăbōrātus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inl-</span></b> ), a,
		um, adj.
		in-laboratus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>not labored</i>, <i>unwrought</i>,
				<i>uncultivated</i>, <i>acquired
				without labor</i>, <i>spontaneous</i>
			(post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">terra,</span>”
				 <i><span class="en">Sen.
					Ep. 90 <i>fin.</i></span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">fructus,</span>”
				 <i><span class="en">Quint. 12, 10, 79</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">oratio (with simplex),</span>”
				 <i><span class="en">id.
					4, 1, 60</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">virtus (with obvia),</span>”
				 <i><span class="en">id.
					12, 2, 2</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">haec omnia fluunt illaborata,</span>”
				 <i><span class="en">id.
					10, 1, 111</span></i>
			.</div>
