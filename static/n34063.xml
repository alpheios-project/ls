<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n34063" body-key=""><b><span class="alpheios-lex-la" lang="lat">pastĭo</span></b> , ōnis,
			f.
		pasco, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a pasturing</i>, <i>grazing</i>, <i>feeding.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">duo genera sunt pastionum, unum agreste, etc.,</span>”
				 <i><span class="en">Varr. R. R. 3, 2, 13</span></i>
			; <i><span class="en">3, 1, 8</span></i>;
				<i><span class="en">3, 2, 18</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">pastiones villaticae, pecuariae,</span>”
				 <i><span class="en">Col.
					8, 1, 2</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, concr., <i>a
			pasture</i>, <i><span class="en">Varr. R. R. 2</span></i>. 10, 2: 
				“<span class="alpheios-lex-la" lang="lat">pastiones laxae,</span>”
				 <i><span class="en">id. ib. 1, 12, 1</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">magnitudine pastionis,</span>”
				 <i><span class="en">Cic.
					Imp. Pomp. 6, 14</span></i>
			.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
