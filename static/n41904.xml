    <div class="alpheios-lex-entry" lemma-id="n41904" body-key=""><b><span class="alpheios-lex-la" lang="lat">rŭbĕ-făcĭo</span></b> ,
			fēci, factum, 3, v. a.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>to make red</i> or <i>ruddy</i>, <i>to redden</i> (<b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">sanguine setas,</span>”
				 <i><span class="en">Ov. M.
					8, 383</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">rubefactaque sanguine tellus,</span>”
				 <i><span class="en">id.
					ib. 13, 394</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cornua multo cruore,</span>”
				 <i><span class="en">id.
					ib. 12, 382</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ora sororum (Aurora),</span>”
				 <i><span class="en">Sil.
					16, 137</span></i>
			.</div>
