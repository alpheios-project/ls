    <div class="alpheios-lex-entry" lemma-id="n9624" body-key=""><b><span class="alpheios-lex-la" lang="lat">complexīvus</span></b> , a, um,
			adj.
		complector; in gram., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>serving for connecting</i>, <i>conneclive</i>, <i>copulative</i>: 
				“<span class="alpheios-lex-la" lang="lat">particula (atque),</span>”
				 <i><span class="en">Gell.
					10, 29</span></i>
			 tit. (in the text itself, conexiva): 
				“<span class="alpheios-lex-la" lang="lat">conjunctis,</span>”
				 <i><span class="en">Mart. Cap. 3, § 272</span></i>
			.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">com-plexīvē</span></b> : 
				“<span class="alpheios-lex-la" lang="lat">dicere,</span>”
				 <i><span class="en">Cassiod. Hist. Eccl. 1, 1</span></i>
			.</div>
