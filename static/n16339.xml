    <div class="alpheios-lex-entry" lemma-id="n16339" body-key=""><b><span class="alpheios-lex-la" lang="lat">euhoe</span></b>  (dissyl.; also, <b><span class="alpheios-lex-la" lang="lat">euoe</span></b> ; less correctly, <b><span class="alpheios-lex-la" lang="lat">ēvoe</span></b> ; cf. Lach. ad <i><span class="en">Lucr. 5,
		743</span></i>), interj., = <span class="alpheios-lex-greek" lang="grc">εὐοῖ</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a shout of joy at the festivals of Bacchus</i>: 
				“<span class="alpheios-lex-la" lang="lat">euhoe Bacche,</span>”
				 <i><span class="en">Plaut. Men. 5, 2, 82</span></i>
			; <i><span class="en">Ov. A. A. 1, 563</span></i>; <i><span class="en">Cat. 64,
				255</span></i>; <i><span class="en">Verg. A. 7, 389</span></i>; <i><span class="en">Hor. C. 2,
				19, 5</span></i> and 7; cf.: 
				“<span class="alpheios-lex-la" lang="lat">euhan euhoe euhoe euhius,</span>”
				 <i><span class="en">Enn. Tr. 150</span></i>
			.</div>
