    <div class="alpheios-lex-entry" lemma-id="n2225" body-key=""><b><span class="alpheios-lex-la" lang="lat">ămĭa</span></b> , ae,
			f., and <b><span class="alpheios-lex-la" lang="lat">ămĭas</span></b> , ae,
