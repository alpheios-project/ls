    <div class="alpheios-lex-entry" lemma-id="n46356" body-key=""><b><span class="alpheios-lex-la" lang="lat">sūcŭlentus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">succ-</span></b> ), a, um,
			adj.
		sucus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>full of juice</i> or <i>sap</i>, <i>sappy</i>, <i>succulent</i> (post-class.).
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">gracilitas,</span>”
				 <i><span class="en">App. M. 2, p. 115, 22</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">arvina,</span>”
				 <i><span class="en">id. ib. 10, 245</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">corpus,</span>”
				 <i><span class="en">Paul. Nol. Carm. 21, 631</span></i>
			. — * </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>, <i>vigorous</i>: 
				“<span class="alpheios-lex-la" lang="lat">furores,</span>”
				 <i><span class="en">Prud. Ham. 57 praef.</span></i>
			</div>
