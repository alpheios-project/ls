<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n23226" body-key=""><b><span class="alpheios-lex-la" lang="lat">infĭtĭātor</span></b>  (<b><span class="alpheios-lex-la" lang="lat">infĭc-</span></b> ),
			ōris, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				denier</i>, esp. <i>one who denies a debt</i> or
				<i>refuses to restore a deposit</i>: 
				“<span class="alpheios-lex-la" lang="lat">ille infitiator,</span>”
				 <i><span class="en">Cic. de Or. 1, 37, 168</span></i>
			; 
				“<span class="alpheios-lex-la" lang="lat">with fraudulentus,</span>”
				 <i><span class="en">Sen. Ben. 3, 27</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">lentus,</span>”
				<i>a bad debtor</i>,
				 <i><span class="en">Cic.
					Cat. 2, 10</span></i>
			.</div>
