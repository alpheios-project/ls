    <div class="alpheios-lex-entry" lemma-id="n36014" body-key=""><b><span class="alpheios-lex-la" lang="lat">Phĭlētas</span></b> , ae,
			m., = <span class="alpheios-lex-greek" lang="grc">Φιλήτας</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a Greek elegiac poet
				of Cos</i>, <i>an instructor of Ptolemy
				Philadelphus</i>, <i><span class="en">Prop. 3</span></i> (4), 1, 1; <i><span class="en">Quint. 10,
				1, 58</span></i>.—Hence, </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b><span class="alpheios-lex-la" lang="lat">Phĭlētēus</span></b> , a,
			um, adj., <i>of</i> or <i>belonging to Philetas</i>, <i>Philetean</i>: 
				“<span class="alpheios-lex-la" lang="lat">Philetea aqua,</span>”
				i. e. <i>elegiac poetry</i>,
				 <i><span class="en">Prop. 3,
					3</span></i>
			 (4, 2), 52: 
				“<span class="alpheios-lex-la" lang="lat">Philetei corymbi,</span>”
				 <i><span class="en">id.
				4</span></i>
			 (5), 6, 3.</div>
