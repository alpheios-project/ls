    <div class="alpheios-lex-entry" lemma-id="n4526" body-key=""><b><span class="alpheios-lex-la" lang="lat">Aulon</span></b> , ōnis, m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A vine - bearing mountain and adjacent valley in
				Calabria</i>, <i><span class="en">Hor. C. 2, 6, 18</span></i>; <i><span class="en">Mart. 13,
				125</span></i>; cf. <i><span class="en">Serv. ad Verg. A. 3,
			553</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A town in Elis</i>, <i><span class="en">Plin. 4, 5,
				6, § 14</span></i>.</div>
