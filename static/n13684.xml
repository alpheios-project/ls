    <div class="alpheios-lex-entry" lemma-id="n13684" body-key=""><b><span class="alpheios-lex-la" lang="lat">dĭācŏnus</span></b> ,
		i (collat. form in plur.: <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
				“<span class="alpheios-lex-la" lang="lat">diacones,</span>”
				 <i><span class="en">Vulg. Tim. 3, 8</span></i>
			; <i><span class="en">12</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">diaconibus,</span>”
				 <i><span class="en">id.
					Phil. 1, 1</span></i>
			), m., = <span class="alpheios-lex-greek" lang="grc">διάκονος</span>,
			in eccl. Lat., <i>a servant</i> or <i>minister of the church, a deacon</i>,
				<i><span class="en">Tert. Praescr. 3</span></i>;
					<i><span class="en">Cod. Just. 1, 3, 6</span></i> et saep.
				—<b><span class="alpheios-lex-la" lang="lat">dĭācŏnissa</span></b> ,
			ae, f., <i>a deaconess</i>,
					<i><span class="en">Cod. Just. 1, 3, 9</span></i>; Orell.
			Inscr. 4872 al.</div>
