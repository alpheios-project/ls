    <div class="alpheios-lex-entry" lemma-id="n48292" body-key=""><b><span class="alpheios-lex-la" lang="lat">tĭāra</span></b> , ae,
			f., or <b><span class="alpheios-lex-la" lang="lat">tĭāras</span></b> , ae,
		m., = <span class="alpheios-lex-greek" lang="grc">τιάρα</span> or <span class="alpheios-lex-greek" lang="grc">τιάρας,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the head-dress of
				the Orientals</i>, <i>a turban</i>, <i>tiara</i>: 
				“<span class="alpheios-lex-la" lang="lat">rectam capite tiaram gerens,</span>”
				 <i><span class="en">Sen. Ben. 6, 31, 8</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">sceptrumque sacerque tiaras,</span>”
				 <i><span class="en">Verg.
					A. 7, 247</span></i>
			; cf. <i><span class="en">Plaut. Pers. 4, 2, 2</span></i>; <i><span class="en">Ov. M. 11,
				181</span></i>; <i><span class="en">Val. Fl. 6, 700</span></i>; <i><span class="en">Juv. 6,
			516</span></i>; <i><span class="en">10,
			267</span></i>; <i><span class="en">Just. 1, 2, 3</span></i>;
				<i><span class="en">App. M. 10, p. 253, 30</span></i>.</div>
