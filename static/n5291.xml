    <div class="alpheios-lex-entry" lemma-id="n5291" body-key=""><b><span class="alpheios-lex-la" lang="lat">bĭcŏlor</span></b> ,
			ōris (<b><span class="alpheios-lex-la" lang="lat">bĭcŏlōrus</span></b> , a,
		um, <i><span class="en">Vop. Aur. 13</span></i>), adj.
		bis-color, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of two colors</i>, <i>twocolored</i>
				(<b>poet.</b> or in post-Aug. prose): 
				“<span class="alpheios-lex-la" lang="lat">equus,</span>”
				 <i><span class="en">Verg.
					A. 5, 566</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">baca,</span>”
				<i>green and black</i>,
				 <i><span class="en">Ov. M.
					8, 664</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">myrtus,</span>”
				<i>steel-colored</i>,
				 <i><span class="en">id.
					ib. 10, 98</span></i>
			; cf. <i><span class="en">id. ib. 11, 234</span></i>; <i><span class="en">Plin. 10,
				52, 74, § 144</span></i>.</div>
