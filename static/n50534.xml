    <div class="alpheios-lex-entry" lemma-id="n50534" body-key=""><b><span class="alpheios-lex-la" lang="lat">vĕrēdus</span></b> , i,
			m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A light horse</i> for posting, <i>a
				post-horse</i>, <i>courier's horse</i>,
					<i><span class="en">Cod. Just. 12, 51, 4</span></i>;
				<i><span class="en">12, 51, 7</span></i>; <i><span class="en">Aus. Ep. 8,
			7</span></i>; <i><span class="en">8, 14</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>a light</i>, <i>fleet huntinghorse</i>, <i><span class="en">Mart. 12,
				14, 1</span></i>; <i><span class="en">14, 86,
				1</span></i>.</div>
