    <div class="alpheios-lex-entry" lemma-id="n19199" body-key=""><b><span class="alpheios-lex-la" lang="lat">Gălaesus</span></b>  (also <b><span class="alpheios-lex-la" lang="lat">Gălēs-</span></b> ), i,
			m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<span class="alpheios-lex-greek" lang="grc">Γαλαῖσος</span>, Polyb., <i>a river of Magna Grœcia</i>, <i>near
				Tarento</i>, now <i>Galeso</i>, <i><span class="en">Liv. 25,
			11</span></i>; <i><span class="en">Hor. C. 2, 6, 10</span></i>; <i><span class="en">Verg. G. 4,
				126</span></i>; <i><span class="en">Prop. 2, 34</span></i> (3, 32), 67; <i><span class="en">Mart. 12,
				63, 3</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A wealthy Latin farmer</i>, <i><span class="en">Verg. A. 7,
				535</span></i>; <i><span class="en">575</span></i>.</div>
