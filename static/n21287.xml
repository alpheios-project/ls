    <div class="alpheios-lex-entry" lemma-id="n21287" body-key=""><b><span class="alpheios-lex-la" lang="lat">ĭātrăliptĭcē</span></b> 
		or <b><span class="alpheios-lex-la" lang="lat">ĭātrăleptĭcē</span></b> ,
			ēs, f., = <span class="alpheios-lex-greek" lang="grc">ἰατραλειπτική</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the art of healing with ointments</i>, <i>the ointment-cure</i>, <i><span class="en">Plin. 29, 1,
				2, § 4</span></i>; cf. the preced. art.‡
			† <b><span class="alpheios-lex-la" lang="lat">ĭātrŏmēa</span></b> ,
				ae, f., = <span class="alpheios-lex-greek" lang="grc">ἰατρόμαια</span>, <i>a female physician</i>,
				<i>midwife</i>, <i><span class="en">Inscr.
				Orell. 4232</span></i>.</div>
