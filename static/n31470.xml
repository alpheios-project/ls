    <div class="alpheios-lex-entry" lemma-id="n31470" body-key=""><b><span class="alpheios-lex-la" lang="lat">nuntĭātor</span></b>  (<b><span class="alpheios-lex-la" lang="lat">nunc-</span></b> ),
		ōris, m.
		id. (postclass.). <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A reporter, declarer, announcer</i>: 
				“<span class="alpheios-lex-la" lang="lat">apparuit Christus rei maximae nuntiator,</span>”
				 <i><span class="en">Arn. 1 <i>fin.</i></span></i>
			; <i><span class="en">Tert. Carn. Christ.
			7</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>An informer</i>, <i><span class="en">Dig. 39,
				1, 20</span></i>; <i><span class="en">48, 16,
				6</span></i>.</div>
