    <div class="alpheios-lex-entry" lemma-id="n16398" body-key=""><b><span class="alpheios-lex-la" lang="lat">Eurymĕdon</span></b> ,
		ontis, m., = <span class="alpheios-lex-greek" lang="grc">Εὐρυμέδων</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A river of Pamphylia</i>, <i><span class="en">Liv. 33,
			41</span></i>; <i><span class="en">37, 23</span></i>;
				<i><span class="en">Mel.
				1, 14, 1</span></i>; <i><span class="en">Avien. Descr. Orb.
			1015</span></i>.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>An Athenian general in the Peloponnesian war</i>,
				<i><span class="en">Just.
				4, 4, 11</span></i>; <i><span class="en">4, 5,
				7</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>A son of Faunus</i>, <i><span class="en">Stat. Th.
				11, 32</span></i>.</div>
