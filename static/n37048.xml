    <div class="alpheios-lex-entry" lemma-id="n37048" body-key=""><b><span class="alpheios-lex-la" lang="lat">poppysma</span></b> , ătis,
		n., and <b><span class="alpheios-lex-la" lang="lat">poppys-mus</span></b> ,
			i, m., = <span class="alpheios-lex-greek" lang="grc">πόππυσμα</span> and <span class="alpheios-lex-greek" lang="grc">ποππυσμός</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a smacking</i>
			or <i>clucking with the tongue</i>, as a sign of
			approbation, <i><span class="en">Juv. 6, 584</span></i>; 
				“<span class="alpheios-lex-la" lang="lat">on occasion of lightning, as a religious
					ceremony,</span>”
				 <i><span class="en">Plin.
					28, 2, 5, § 25</span></i>
			; 
				“<span class="alpheios-lex-la" lang="lat">of a similar sound,</span>”
				 <i><span class="en">Mart. 7, 18, 11</span></i>
			.</div>
