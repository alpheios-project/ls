    <div class="alpheios-lex-entry" lemma-id="n45017" body-key=""><b><span class="alpheios-lex-la" lang="lat">spīnētum</span></b> , i,
			n.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				thorn hedge</i>, <i>a thicket of thorns.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i><span class="en">Verg. E. 2, 9</span></i>; <i><span class="en">Plin. 10,
				74, 95, § 204</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">spineta sentesque,</span>”
				 <i><span class="en">Sen. Ira, 2, 10, 4</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Trop.</b>: 
				“<span class="alpheios-lex-la" lang="lat">Aristotelis spineta,</span>”
				 <i><span class="en">Hier. in Helv. 2</span></i>
			.</div>
