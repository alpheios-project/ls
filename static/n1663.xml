    <div class="alpheios-lex-entry" lemma-id="n1663" body-key=""><b><span class="alpheios-lex-la" lang="lat">ăīzōŏn</span></b> ,
			i, n., = <span class="alpheios-lex-greek" lang="grc">ἀείζωον</span> (ever-living), <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>an evergreen plant.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b> Majus, <i>live-forever</i>, <i>houseleek</i>: Sempervivum
			tectorum, Linn.; <i><span class="en">Plin. 25, 13, 102, §
			160</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			Minus or minusculum, <i>stone-crop</i>: Sedum album,
			Linn.; <i><span class="en">Plin. 25, 13, 102, §
		160</span></i>.</div>
