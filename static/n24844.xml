    <div class="alpheios-lex-entry" lemma-id="n24844" body-key=""><b><span class="alpheios-lex-la" lang="lat">Īon</span></b> , ōnis,
			m., = <span class="alpheios-lex-greek" lang="grc">Ἴων,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>an Athenian</i>,
				<i>son of Xuthus</i>, <i>who led a
				colony into Asia; from him is derived the name Ionia</i>, <i><span class="en">Vitr. 4,
			1</span></i>; <i><span class="en">Stat. Th. 8,
			454</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A sculptor of the one hundred and thirteenth
				Olympiad</i>, <i><span class="en">Plin. 34, 8, 19, §
		51</span></i>.</div>
