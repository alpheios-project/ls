    <div class="alpheios-lex-entry" lemma-id="n19410" body-key=""><b><span class="alpheios-lex-la" lang="lat">Genāva</span></b>  (less correctly <b><span class="alpheios-lex-la" lang="lat">Genna</span></b>  or <b><span class="alpheios-lex-la" lang="lat">Genēva</span></b> ), ae,
		f., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				city of the Allobroges</i>, <i>upon Lake
			Leman</i>, <i>at the point where the Rhone passes from
				it</i>, <i>Geneva</i>, <i><span class="en">Caes. B. G.
				1, 6, 3</span></i>; <i><span class="en">1, 7, 1</span></i> sq.—Deriv.: <b><span class="alpheios-lex-la" lang="lat">Genāven-sis</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Genēv-</span></b> ),
				e, <i>of Geneva</i>,
					<i><span class="en">Inscr. Orell. 253</span></i>; 
				“<span class="alpheios-lex-la" lang="lat">called Genevensis,</span>”
				 <i><span class="en">ib. 254</span></i>
			.</div>
