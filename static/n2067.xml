    <div class="alpheios-lex-entry" lemma-id="n2067" body-key=""><b><span class="alpheios-lex-la" lang="lat">alum</span></b>  (<b><span class="alpheios-lex-la" lang="lat">hal-</span></b> ),
			n., or <b><span class="alpheios-lex-la" lang="lat">alus</span></b> ,
			i, f., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>a plant.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Comfrey</i>: Symphytum officinale, Linn.; <i><span class="en">Plin. 27, 6,
				24, § 41</span></i>; <i><span class="en">26, 7, 26, §
