    <div class="alpheios-lex-entry" lemma-id="n46033" body-key=""><b><span class="alpheios-lex-la" lang="lat">sub-sĕco</span></b> , cui, ctum, 1,
			v. a., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>to cut under</i>, <i>cut away below;
				to clip</i>, <i>pare</i> (rare; 
				“<span class="alpheios-lex-la" lang="lat">not in Cic.): stramentum et manipulum falce,</span>”
				 <i><span class="en">Varr. R. R. 1, 50, 1</span></i>
			: herbam. <i><span class="en">id. ib. 1, 49, 1</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">legumina,</span>”
				 <i><span class="en">id. ib. 1, 23, 3</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">radices,</span>”
				 <i><span class="en">Col.
					2, 9, 10</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">partes, unde creatus erat (Saturnus),</span>”
				 <i><span class="en">Ov. Ib.
					276</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ungues ferro,</span>”
				 <i><span class="en">id. F.
					6, 230</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">papavereas ungue comas,</span>”
				 <i><span class="en">id.
					ib. 4, 438</span></i>
			; <i><span class="en">Cels. 7, 33</span></i>.</div>
