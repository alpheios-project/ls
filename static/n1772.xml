    <div class="alpheios-lex-entry" lemma-id="n1772" body-key=""><b><span class="alpheios-lex-la" lang="lat">Alcyŏnē</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Halc-</span></b> ),
			ēs, f., = <span class="alpheios-lex-greek" lang="grc">Ἀλκυόνη</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a daughter of Æolus</i>, <i>who</i>, <i>from love to her husband Ceyx</i>,
				<i>who had suffered shipwreck</i>, <i>threw herself into the sea and was changed into a
			kingfisher</i> (<span class="alpheios-lex-greek" lang="grc">ἀλκυών</span>; 
				“<span class="alpheios-lex-la" lang="lat">v. alcedo),</span>”
				 <i><span class="en">Ov.
					M. 11, 384</span></i>
			; <i><span class="en">710</span></i> sq.</div>
