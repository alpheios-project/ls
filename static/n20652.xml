    <div class="alpheios-lex-entry" lemma-id="n20652" body-key=""><b><span class="alpheios-lex-la" lang="lat">hĭĕra</span></b> , ae,
			f. (sc. antidotus), = <span class="alpheios-lex-greek" lang="grc">ἱερά</span> (sacred; <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
				“<span class="alpheios-lex-la" lang="lat">Lat. sacra),</span>”
				<i>a sort of antidote against poison</i>,
				 <i><span class="en">Scrib. Comp. 99</span></i>
			; <i><span class="en">156</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b> Perh. = corona, <i>a garland</i>: 
				“<span class="alpheios-lex-la" lang="lat">hieran fecimus,</span>”
				 <i><span class="en">Sen. Ep. 83, 4</span></i>
			.</div>
