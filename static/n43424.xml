    <div class="alpheios-lex-entry" lemma-id="n43424" body-key=""><b><span class="alpheios-lex-la" lang="lat">sēmēsus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">sēmiēsus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">trisyl.</span></b> ), <i><span class="en">Verg. A. 3,
