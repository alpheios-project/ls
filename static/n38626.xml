    <div class="alpheios-lex-entry" lemma-id="n38626" body-key=""><b><span class="alpheios-lex-la" lang="lat">prōflīgātĭo</span></b> ,
			ōnis, f.
		1. profligo. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Ruin</i>, <i>destruction</i>
			(post-class.): 
				“<span class="alpheios-lex-la" lang="lat">bonorum profligatio,</span>”
				 <i><span class="en">Aus. Per. Od. 2</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A settling</i>, <i>collection</i>:
			debitorum, Cod. Th. 6, 30, 10; Novell. Th. 2, 26 <i>pr.</i></div>
