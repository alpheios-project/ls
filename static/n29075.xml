    <div class="alpheios-lex-entry" lemma-id="n29075" body-key=""><b><span class="alpheios-lex-la" lang="lat">Mĭlo</span></b>  and <b><span class="alpheios-lex-la" lang="lat">Mĭlon</span></b> , ōnis,
		m., = <span class="alpheios-lex-greek" lang="grc">Μίλων</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A celebrated athlete of Crotona</i>, <i><span class="en">Cic. Fat.
				13, 30</span></i>; <i><span class="en">id. Sen. 9, 27</span></i>; <i><span class="en">10,
			33</span></i>; <i><span class="en">Val.
					Max. 9, 12, 9</span></i>
			<i>ext.;</i>
			<i><span class="en">Vitr. 9
				praef.</span></i> § 2; <i><span class="en">Plin. 7, 20,
				19, § 83</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A king of Pisa, in Elis</i>, <i><span class="en">Ov. Ib.
			327</span></i>.</div>
