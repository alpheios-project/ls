    <div class="alpheios-lex-entry" lemma-id="n33919" body-key=""><b><span class="alpheios-lex-la" lang="lat">părōtis</span></b> ,
			ĭdis, f., = <span class="alpheios-lex-greek" lang="grc">παρωτίς</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a tumor near the ears</i>, <i>a parotis</i>: 
				“<span class="alpheios-lex-la" lang="lat">parotidas tollere,</span>”
				 <i><span class="en">Plin.
					20, 21, 84, § 229</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">parotidas reprimere,</span>”
				 <i><span class="en">id.
					20, 9, 36, § 95</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">comprimere,</span>”
				 <i><span class="en">id.
					28, 11, 48, § 177</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cohibere,</span>”
				 <i><span class="en">id.
					35, 17, 57, § 195</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">discutere,</span>”
				 <i><span class="en">id.
					20, 15, 59, § 167</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">lenire,</span>”
				 <i><span class="en">id.
					28, 7, 23, § 82</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">sanare,</span>”
				 <i><span class="en">id. 20,
					1, 2, § 4</span></i>
			.—In sing., <i><span class="en">Plin. 24, 5,
				10, § 15</span></i> (in <i><span class="en">Cels. 5,
				18, 18</span></i>; <i><span class="en">6,
			16</span></i>, written as Greek).—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>a bracket</i> or
				<i>console</i> of a hyperthyrum, <i><span class="en">Vitr. 4, 6,
				4</span></i>.</div>
