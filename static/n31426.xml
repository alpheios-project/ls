    <div class="alpheios-lex-entry" lemma-id="n31426" body-key=""><b><span class="alpheios-lex-la" lang="lat">Nŭmĭtor</span></b> ,
			ōris, m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A king of Alba, brother of Amulius, father of Ilia,
				and grandfather of Romulus and Remus</i>, <i><span class="en">Liv. 1,
			3</span></i>; <i><span class="en">Ov. F. 4, 53</span></i>; <i><span class="en">809</span></i>;
				<i><span class="en">5, 75</span></i>; <i><span class="en">id. M. 14, 773</span></i>; <i><span class="en">Verg. A. 6,
				768</span></i>; <i><span class="en">Juv. 7, 74</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A Rutulian</i>, <i><span class="en">Verg. A.
				10, 342</span></i>.</div>
