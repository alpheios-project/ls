    <div class="alpheios-lex-entry" lemma-id="n26250" body-key=""><b><span class="alpheios-lex-la" lang="lat">lentiscus</span></b> , i, f., <b><span class="alpheios-lex-la" lang="lat">lentiscum</span></b> , i,
		n., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the
				mastic - tree</i>, Pistacia lentiscus, Linn. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: viridis semperque gravata Lentiscus,
			Cic. poët. Div. 1, 9, 15.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<i>Mastic-oil</i>, <i><span class="en">Cato, R. R.
				7, 4</span></i>; <i><span class="en">Varr. R. R. 1, 60</span></i>; <i><span class="en">Plin. 15, 6,
				6, § 21</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<i>A toothpick of mastic-wood</i>, <i><span class="en">Mart. 14,
				22, 1</span></i>; <i><span class="en">3, 82,
			9</span></i>; <i><span class="en">6, 74,
		3</span></i>.</div>
