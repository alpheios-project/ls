<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n19778" body-key=""><b><span class="alpheios-lex-la" lang="lat">grăbātus</span></b> , i,
			m.
		Macedonian, = <span class="alpheios-lex-greek" lang="grc">κράβατος</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a small</i> or
				<i>low couch</i>, <i>a pallet</i>,
				<i>campbed</i> (syn.: 
				“<span class="alpheios-lex-la" lang="lat">lectus, cubile, stratum, torus),</span>”
				 <i><span class="en">Cic. Div. 2, 63, 129</span></i>
			; Lucil. ap. <i><span class="en">Non. 181, 29</span></i>;
					<i><span class="en">Petr. 97</span></i>; <i><span class="en">Sen. Ep.
			18</span></i>; <i><span class="en">20</span></i>;
					<i><span class="en">Verg. M. 5</span></i>; <i><span class="en">Mart. 6,
				39, 4</span></i>; <i><span class="en">12,
				32, 11</span></i>; <i><span class="en">Cat. 10, 22</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">argento inaurato tectus,</span>”
				 <i><span class="en">Scaev. Dig. 33, 7, 20 <i>fin.</i></span></i>
			; <i><span class="en">Vulg. Marc. 2, 4</span></i>; <i><span class="en">id. Act. 5,
				15</span></i>; collat. form <b><span class="alpheios-lex-la" lang="lat">grăbātum</span></b> , i,
			n., <i><span class="en">Cael. Aur. Acut. 2, 37</span></i>.</div>
