    <div class="alpheios-lex-entry" lemma-id="n44264" body-key=""><b><span class="alpheios-lex-la" lang="lat">sĭlīgo</span></b> ,
		ĭnis, f.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A kind of very white wheat</i>, <i>winter-wheat</i>: Triticum hibernum, Linn.;
				<i><span class="en">Cato, R. R. 35, 1</span></i>?? <i><span class="en">Varr.
				R. R. 1, 23, 2</span></i>; <i><span class="en">Cels. 2, 19</span></i>; <i><span class="en">Col. 2, 6,
			2</span></i>; <i><span class="en">2, 9, 5</span></i>;
				<i><span class="en">2, 9, 13</span></i>; <i><span class="en">Plin. 18, 8,
				20, § 85</span></i>; <i><span class="en">18, 7, 10, §
			61</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>fine wheaten
			flour</i>, <i><span class="en">Plin. 18, 9, 20, § 85</span></i>; <i><span class="en">Juv. 5,
			70</span></i>; <i><span class="en">6,
		472</span></i>.</div>
