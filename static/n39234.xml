    <div class="alpheios-lex-entry" lemma-id="n39234" body-key=""><b><span class="alpheios-lex-la" lang="lat">pro-vulgo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-volgo</span></b> ), āvi, ātum, 1,
