    <div class="alpheios-lex-entry" lemma-id="n47253" body-key=""><b><span class="alpheios-lex-la" lang="lat">syngrăpha</span></b> , ae,
		f., = <span class="alpheios-lex-greek" lang="grc">συγγραφή,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a written agreement
				to pay</i>, <i>a promissory note</i>, <i>bond</i> (cf. chirographum), <i><span class="en">Cic. Fam.
				7, 17, 1</span></i>; <i><span class="en">id. Att. 5, 21, 11 sq.</span></i>; <i><span class="en">id. Phil.
				2, 37, 95</span></i>; <i><span class="en">id. Verr. 2, 4, 13, § 30</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">ex syngraphā agere,</span>”
				 <i><span class="en">id.
					Mur. 17, 35</span></i>
			; <i><span class="en">Amm. 26, 3, 4</span></i>.</div>
