    <div class="alpheios-lex-entry" lemma-id="n35009" body-key=""><b><span class="alpheios-lex-la" lang="lat">per-grăvis</span></b> , e,
		adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>very weighty</i> or <i>grave</i>, <i>very important</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">pergravia (haec), opp. levia,</span>”
				 <i><span class="en">Ter.
					Hec. 3, 1, 12</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">testes,</span>”
				 <i><span class="en">Cic.
					Cael. 26, 63</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">oratio,</span>”
				 <i><span class="en">id.
					Sest. 50, 107</span></i>
			.— <i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">pergrăvĭter</span></b> , <i>very gravely</i>, <i>very
			seriously</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">pergraviter offensus,</span>”
				 <i><span class="en">Cic.
					Att. 1, 10, 2</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">reprehendere aliquem,</span>”
				 <i><span class="en">id.
					de Or. 1, 53, 227</span></i>
			.</div>
