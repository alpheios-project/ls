    <div class="alpheios-lex-entry" lemma-id="n3334" body-key=""><b><span class="alpheios-lex-la" lang="lat">ărānĕus</span></b> , i,
			m.
		
			<span class="alpheios-lex-greek" lang="grc">ἀραχνός</span>
		. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A spider</i>, <i><span class="en">Lucr. 3,
			383</span></i>; <i><span class="en">Cat. 23, 2</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">aranei (apibus) hostiles,</span>”
				 <i><span class="en">Plin.
					11, 19, 21, § 65</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">araneorum natura,</span>”
				 <i><span class="en">id.
					11, 24, 28, § 79</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">aranei textura,</span>”
				 <i><span class="en">Sen. Ep. 121, 22 al.</span></i>
			—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A sea-fish</i>: Draco trachinus, Linn.; <i><span class="en">Plin. 32,
				11, 53, § 145</span></i>.</div>
