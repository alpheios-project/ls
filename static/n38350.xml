<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n38350" body-key=""><b><span class="alpheios-lex-la" lang="lat">princĭpor</span></b> , āri,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>v. dep. a.</i>
			[princeps], <i>to rule</i> (eccl. Lat.).
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>: 
				“<span class="alpheios-lex-la" lang="lat">principari in nationes,</span>”
				 <i><span class="en">Lact. 14, 13, 19</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">prolem ... principibus principantem,</span>”
				 <i><span class="en">Sid. Carm. 9, 47</span></i>
			; <i><span class="en">23, 90</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>: 
				“<span class="alpheios-lex-la" lang="lat">sanguis in nostro corpore principatur,</span>”
				 <i><span class="en">Aug. Prophet. 6</span></i>
			.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
