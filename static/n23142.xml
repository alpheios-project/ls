    <div class="alpheios-lex-entry" lemma-id="n23142" body-key=""><b><span class="alpheios-lex-la" lang="lat">in-fēcundus</span></b> , a, um,
			adj., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unfruitful</i> (rare): 
				“<span class="alpheios-lex-la" lang="lat">ager frugum fertilis, arbore infecundus,</span>”
				 <i><span class="en">Sall. J. 17, 5</span></i>
			; <i><span class="en">Verg. G. 2, 48</span></i>; <i><span class="en">Ov. Tr. 3,
				14, 34</span></i>.— <i>Comp.</i>: 
				“<span class="alpheios-lex-la" lang="lat">infecundior materia,</span>”
				 <i><span class="en">Col.
					2, 4, 7</span></i>
			.— * <i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">infēcundē</span></b> ,
				<i>unfruitfully</i>, i. e. <i>meagrely</i>, <i>sparingly</i>: 
				“<span class="alpheios-lex-la" lang="lat">infecunde atque jejune laudare,</span>”
				 <i><span class="en">Gell.
					19, 3, 2</span></i>
			.</div>
