    <div class="alpheios-lex-entry" lemma-id="n20574" body-key=""><b><span class="alpheios-lex-la" lang="lat">hērōis</span></b> ,
		ĭdis, f., = <span class="alpheios-lex-greek" lang="grc">ἡρωΐς</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a demi-goddess</i>, <i>heroine</i>: 
				“<span class="alpheios-lex-la" lang="lat">heroidum ac dearum personis effictis,</span>”
				 <i><span class="en">Suet. Ner. 21</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">veteres heroidas aequare,</span>”
				 <i><span class="en">Ov.
					Am. 2, 4, 33</span></i>
			.—In Gr., <i>dat. plur.</i> heroisin,
				<i><span class="en">Ov.
				Tr. 5, 5, 43</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b><span class="alpheios-lex-la" lang="lat">Hērōĭdes</span></b> , <i>the title of the Epistles of Ovid</i>, acc. to
					<i><span class="en">Prisc. p. 908</span></i> P.</div>
