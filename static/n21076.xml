    <div class="alpheios-lex-entry" lemma-id="n21076" body-key=""><b><span class="alpheios-lex-la" lang="lat">hyălĭnus</span></b> ,
			a, um, adj., = <span class="alpheios-lex-greek" lang="grc">ὑάλινος</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Of glass</i>, <i>glass-</i>: 
				“<span class="alpheios-lex-la" lang="lat">sphaera, Fulg. Myth. praef.: pulvis,</span>”
				 <i><span class="en">Mart. Cap. 6, § 575</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Glass-green</i>, <i>green</i>: 
				“<span class="alpheios-lex-la" lang="lat">pennae,</span>”
				 <i><span class="en">Mart. Cap. 1, § 66 sq.</span></i>
			 al.</div>
