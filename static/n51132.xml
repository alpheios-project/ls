        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b>Trop.</b>, <i>a visitation</i>,
				<i>punishment</i>, <i><span class="en">Vulg. Isa.
				10, 3</span></i>; <i><span class="en">id. 1</span></i> Pet. 2,
		12.</div>
