    <div class="alpheios-lex-entry" lemma-id="n26338" body-key=""><b><span class="alpheios-lex-la" lang="lat">lētĭfer</span></b>  (<b><span class="alpheios-lex-la" lang="lat">lēth-</span></b> ),
			fĕra, fĕrum, adj.
		letum, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>death-bringing, death-dealing, deadly, fatal</i> (<b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">arcus,</span>”
				 <i><span class="en">Verg.
					A. 10, 169</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ictus,</span>”
				 <i><span class="en">Ov. M.
					8, 362</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">dextra,</span>”
				 <i><span class="en">id.
					ib. 12, 606</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vestis,</span>”
				 <i><span class="en">id.
					ib. 9, 166</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">anguis,</span>”
				 <i><span class="en">Stat.
					Th. 5, 628</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">certamen,</span>”
				 <i><span class="en">Cat.
					64, 390</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">annus,</span>”
				 <i><span class="en">Verg.
					A. 3, 139</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">autumnus,</span>”
				 <i><span class="en">Juv. 4,
					57</span></i>
			.—In prose: 
				“<span class="alpheios-lex-la" lang="lat">rabies letifer morbus canibus,</span>”
				 <i><span class="en">Col. 7,
					12 <i>fin.</i></span></i>
			—<b>Transf.</b>: 
				“<span class="alpheios-lex-la" lang="lat">locus,</span>”
				<i>a place in the body where a wound is fatal, a mortal
						part</i>,
				 <i><span class="en">Ov. M.
					5, 133</span></i>
			.</div>
