    <div class="alpheios-lex-entry" lemma-id="n544" body-key=""><b><span class="alpheios-lex-la" lang="lat">ăcŏnītum</span></b> ,
		i, n., = <span class="alpheios-lex-greek" lang="grc">ἀκόνιτον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a poisonous plant</i>, <i>wolf's-bane</i>, <i>monk's-hood</i>, <i>aconite</i>, <i><span class="en">Plin. 27, 2, 2</span></i>; <i><span class="en">6, 1, 1</span></i>
