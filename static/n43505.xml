<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n43505" body-key=""><b><span class="alpheios-lex-la" lang="lat">sēmĭ-mās</span></b> ,
			măris, m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<b>Lit.</b>, <i>a halfmale</i>,
			
			<i>hermaphrodite</i>, <i><span class="en">Ov. M. 4,
				381</span></i>; <i><span class="en">12, 506</span></i>; <i><span class="en">Liv. 31, 12
					<i>fin.</i></span></i>—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, adj., <i>unmanned</i>, <i>emasculated</i>: 
				“<span class="alpheios-lex-la" lang="lat">capri,</span>”
				 <i><span class="en">Varr. R. R. 3, 9, 3</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">semimares capi (appellantur), cum sint
					castrati,</span>”
				 <i><span class="en">Col.
					8, 2, 3</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ovis,</span>”
				 <i><span class="en">Ov. F.
					1, 588</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Galli (the priests of Cybele),</span>”
				 <i><span class="en">id.
					ib. 4, 183</span></i>
			.</div>
