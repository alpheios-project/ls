    <div class="alpheios-lex-entry" lemma-id="n21209" body-key=""><b><span class="alpheios-lex-la" lang="lat">hypŏgēus</span></b> , a,
			um, adj., = <span class="alpheios-lex-greek" lang="grc">ὑπόγαιος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>underground</i>: 
				“<span class="alpheios-lex-la" lang="lat">loca,</span>”
				 <i><span class="en">Cael.
						Aur. Tard. 2, 37, 191</span></i>
			.—Hence, <i>subst.</i>: <b><span class="alpheios-lex-la" lang="lat">hypŏgēum</span></b>  or <b><span class="alpheios-lex-la" lang="lat">hy-pŏgaeum</span></b> ,
				i, n., = <span class="alpheios-lex-greek" lang="grc">ὑπόγειον</span> (<span class="alpheios-lex-greek" lang="grc">ὑπόγαιον</span>), <i>a vault</i> or <i>cellar under ground</i>, <i><span class="en">Vitr. 6,
			11</span></i>; <i>a burying-vault</i>, <i>sepulchre</i>, <i><span class="en">Petr. 111, 2</span></i>;
					<i><span class="en">Inscr. Grut. 1114, 3</span></i>.</div>
