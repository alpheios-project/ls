    <div class="alpheios-lex-entry" lemma-id="n7914" body-key=""><b><span class="alpheios-lex-la" lang="lat">chrȳsītis</span></b> ,
			ĭdis, f., = <span class="alpheios-lex-greek" lang="grc">χρυσῖτις</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			Adj., <i>gold-colored</i>: 
				“<span class="alpheios-lex-la" lang="lat">chrysitis spuma. found in silver mines,</span>”
				 <i><span class="en">Plin.
					33, 6, 35, § 106</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			Subst., <i>a plant</i>, <i>also called</i> chrysocome, q. v., <i><span class="en">Plin. 21, 8,
				26, § 50</span></i>; <i><span class="en">21, 20, 85, §
			148</span></i>.</div>
