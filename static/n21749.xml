    <div class="alpheios-lex-entry" lemma-id="n21749" body-key=""><b><span class="alpheios-lex-la" lang="lat">immŏlātĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inm-</span></b> ),
			ōnis, f.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				sacrificing</i>, <i>a sacrifice</i> (rare but
			class.): 
				“<span class="alpheios-lex-la" lang="lat">in ipso immolationis tempore,</span>”
				 <i><span class="en">Cic. Div. 1, 52, 119</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">in ipsa,</span>”
				 <i><span class="en">id. ib. 2, 16, 37</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Iphigeniae,</span>”
				 <i><span class="en">Quint. 2, 13, 13</span></i>
			.—In plur.: 
				“<span class="alpheios-lex-la" lang="lat">nefandae,</span>”
				 <i><span class="en">Tac. A.
					3, 13</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			Concr., <i>a sacrifice</i>, <i>offering</i>, <i><span class="en">Aug. Ep. 36, 30</span></i>.</div>
