    <div class="alpheios-lex-entry" lemma-id="n18532" body-key=""><b><span class="alpheios-lex-la" lang="lat">fontĭgĕna</span></b> , ae,
			adj.
		fons-gigno, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>born by fountains</i>, a <b>poet.</b> epithet of the Muses: 
				“<span class="alpheios-lex-la" lang="lat">virginum chorus,</span>”
				 <i><span class="en">Mart. Cap. 9, § 908</span></i>
			; and <i>subst.</i>: 
				“<span class="alpheios-lex-la" lang="lat">o sacra doctarum prudentia fontigenarum,</span>”
				 <i><span class="en">id. 6, § 574</span></i>
			.</div>
