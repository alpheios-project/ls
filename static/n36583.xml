    <div class="alpheios-lex-entry" lemma-id="n36583" body-key=""><b><span class="alpheios-lex-la" lang="lat">plastes</span></b> , ae, m., =
			<span class="alpheios-lex-greek" lang="grc">πλάστης</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a moulder</i>, <i>potter</i>, <i>modeller</i>, <i>statuary</i> (post-Aug.; 
				“<span class="alpheios-lex-la" lang="lat">syn. fictor),</span>”
				 <i><span class="en">Vell.
					1, 17, 4</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">laudatissimi,</span>”
				 <i><span class="en">Plin.
					35, 12, 45, § 154</span></i>
			; <i><span class="en">Vitr. 1, 1, 13</span></i>;
				<i><span class="en">Tert. Idol. 3</span></i>; <i><span class="en">Vulg. Isa.
				41, 25</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A creator</i>, <i>maker</i> (eccl.
			Lat.): 
				“<span class="alpheios-lex-la" lang="lat">Israel,</span>”
				 <i><span class="en">Vulg.
					Isa. 45, 11</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">terrae,</span>”
				 <i><span class="en">id. ib. 45, 18</span></i>
			.</div>
