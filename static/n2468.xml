    <div class="alpheios-lex-entry" lemma-id="n2468" body-key=""><b><span class="alpheios-lex-la" lang="lat">ănătŏmĭa</span></b>  or <b><span class="alpheios-lex-la" lang="lat">ănătŏmĭca</span></b> ,
			ae, also <b><span class="alpheios-lex-la" lang="lat">ănătŏmĭcē</span></b> ,
			ēs, f., = <span class="alpheios-lex-greek" lang="grc">ανατομία</span> or <span class="alpheios-lex-greek" lang="grc">ἀνατομική</span>
		(sc. <span class="alpheios-lex-greek" lang="grc">τέχνη</span>); <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
				“<span class="alpheios-lex-la" lang="lat">in medicine,</span>”
				<i>anatomy</i>,
				 <i><span class="en">Cael.
					Aur. Acut. 1, 8</span></i>
			; <i><span class="en">Macr. S. 7,
			15</span></i>.—Hence, <b><span class="alpheios-lex-la" lang="lat">ănătŏmĭcus</span></b> ,
				i, m. (sc. medicus), <i>an anatomist</i>, <i><span class="en">Macr. S. 7,
			13</span></i>; <i><span class="en">Amm. 28, 4 <i>fin.</i></span></i>; Aug. Civ. Dei, 22, 24.</div>
