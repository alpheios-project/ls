    <div class="alpheios-lex-entry" lemma-id="n15535" body-key=""><b><span class="alpheios-lex-la" lang="lat">Elpēnor</span></b> , ŏris,
			m., = <span class="alpheios-lex-greek" lang="grc">Ἐλπήνωρ</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>one of the companions
				of Ulysses</i>, <i>whom Circe changed into
			swine</i>, <i><span class="en">Juv. 15, 22</span></i>; 
				“<span class="alpheios-lex-la" lang="lat">being afterwards disenchanted, he fell from a
					roof while drunk, and broke his neck,</span>”
				 <i><span class="en">Ov.
					Tr. 3, 4, 19</span></i>
			; <i><span class="en">id. M. 14, 252</span></i>; <i><span class="en">id. Ib.
			483</span></i>.</div>
