    <div class="alpheios-lex-entry" lemma-id="n38563" body-key=""><b><span class="alpheios-lex-la" lang="lat">prōdĭtor</span></b> ,
			ōris, m.
		prodo, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a betrayer</i>, <i>traitor</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">cum senatus duces nullos ac pro ducibus
					proditores haberet,</span>”
				 <i><span class="en">Cic.
					Sest. 15, 35</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">proditor patriae,</span>”
				 <i><span class="en">id.
					Fin. 3, 19, 64</span></i>
			; <i><span class="en">id. Fam. 12, 3, 2</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">disciplinae,</span>”
				 <i><span class="en">Liv. 2,
					59</span></i>
			.—<b>Poet.</b>, transf.: 
				“<span class="alpheios-lex-la" lang="lat">risus proditor latentis puellae,</span>”
				<i>betraying</i>, <i>treacherous</i>,
				 <i><span class="en">Hor.
					C. 1, 9, 21</span></i>
			.</div>
