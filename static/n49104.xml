<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n49104" body-key=""><b><span class="alpheios-lex-la" lang="lat">trĭgōnus</span></b> ,
			a, um, adj., = <span class="alpheios-lex-greek" lang="grc">τρίγωνος,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>three-cornered</i>, <i>triangular</i>, <i>trigonal.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Adj.</i>: 
				“<span class="alpheios-lex-la" lang="lat">signa,</span>”
				 <i><span class="en">Manil. 2, 276</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">ductus,</span>”
				 <i><span class="en">id. 2, 342</span></i>
			.—More freq., </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Substt.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<b><span class="alpheios-lex-la" lang="lat">trĭgō-num</span></b> ,
				i, n., = <span class="alpheios-lex-greek" lang="grc">τρίγωνον,</span>
			<i>a triangle</i>, <i>trigon</i>, <i><span class="en">Varr.
				L. L. 7, 4, 95</span></i>; <i><span class="en">Gell. 2,
				21, 10</span></i>; <i><span class="en">Col. 5, 10, 13</span></i>; <i><span class="en">id. Arb.
				22, 2</span></i>; <i><span class="en">Vitr. 10, 11 <i>fin.</i></span></i> — 
				“<span class="alpheios-lex-la" lang="lat">Scanned trĭgŏna,</span>”
				 <i><span class="en">Aus. Idyll. 11, 50</span></i>
			; Ecl. Rat. Puerper. 39.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b><span class="alpheios-lex-la" lang="lat">trĭgōnus</span></b> ,
				i, m.; 
				“<span class="alpheios-lex-la" lang="lat">med. t. t.,</span>”
				<i>a soothing pill</i>,
				 <i><span class="en">Cael.
						Aur. Tard. 2, 7, 104</span></i>
			.</div>
