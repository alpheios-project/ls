    <div class="alpheios-lex-entry" lemma-id="n51527" body-key=""><b><span class="alpheios-lex-la" lang="lat">zēlŏtypus</span></b> ,
			a, um, adj., = <span class="alpheios-lex-greek" lang="grc">ζηλότυπος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>jealous</i>: 
				“<span class="alpheios-lex-la" lang="lat">larba,</span>”
				 <i><span class="en">Juv. 5,
					45</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">moechae,</span>”
				 <i><span class="en">id. 6,
					278</span></i>
