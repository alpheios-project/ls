    <div class="alpheios-lex-entry" lemma-id="n31532" body-key=""><b><span class="alpheios-lex-la" lang="lat">Nycteus</span></b> , ĕi and
		ĕos, m., = <span class="alpheios-lex-greek" lang="grc">Νυκτεύς</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a son of Hyrieus and the nymph Clonia, and father of
				Antiopa</i>: 
				“<span class="alpheios-lex-la" lang="lat">Nycteos Antiope,</span>”
				 <i><span class="en">Prop.
					3, 15</span></i>
			 (4, 14), 12.—Hence, </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b><span class="alpheios-lex-la" lang="lat">Nyctēis</span></b> ,
				ĭdis, f., <i>the Nycteide</i>, i. e. <i>Antiopa</i>: 
				“<span class="alpheios-lex-la" lang="lat">Nycteida,</span>”
				 <i><span class="en">Ov. M.
					6, 111</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Nycteidos,</span>”
				 <i><span class="en">Stat.
					Th. 7, 190</span></i>
			; <i><span class="en">Hyg. Fab. 7</span></i> and 155.</div>
