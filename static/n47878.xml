    <div class="alpheios-lex-entry" lemma-id="n47878" body-key=""><b><span class="alpheios-lex-la" lang="lat">Termes</span></b> , ētis,
		f., = <span class="alpheios-lex-greek" lang="grc">Τέρμες,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a town in
			Spain</i>, now <i>Lerma</i>, <i><span class="en">Plin. 3, 3,
				4, § 27</span></i>; <i><span class="en">Flor. 3, 22 <i>fin.</i></span></i>—Hence, <b><span class="alpheios-lex-la" lang="lat">Termestīnus</span></b> , a, um,
			adj., <i>belonging to Termes</i>, <i><span class="en">Tac. A.
			4</span></i>,  45.—<i>Subst.</i>:
				<b><span class="alpheios-lex-la" lang="lat">Termestīni</span></b> ,
				ōrum, m.
			plur., <i>the inhabitants of
			Termes</i>, Epit. <i><span class="en">Liv. 54</span></i> Drak.
			—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A town in Ionia</i>, <i><span class="en">Plin. 5, 29,
				31, § 118</span></i>.</div>
