    <div class="alpheios-lex-entry" lemma-id="n8983" body-key=""><b><span class="alpheios-lex-la" lang="lat">cŏlăphus</span></b> , i,
			m., = <span class="alpheios-lex-greek" lang="grc">κόλαφος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a blow with the
			fist</i>, <i>a cuff</i>, <i>a box on the
				ear</i>: 
				“<span class="alpheios-lex-la" lang="lat">icere,</span>”
				 <i><span class="en">Plaut. Pers. 5, 2, 65</span></i>
			 Ritschl: 
				“<span class="alpheios-lex-la" lang="lat">ducere,</span>”
				 <i><span class="en">Quint. 6, 3, 83</span></i>
			.—In plur.: 
				“<span class="alpheios-lex-la" lang="lat">in cerebro colaphos abstrudere,</span>”
				 <i><span class="en">Plaut. Rud. 4, 3, 68</span></i>
			; cf.: 
				“<span class="alpheios-lex-la" lang="lat">infringere alicui,</span>”
				 <i><span class="en">Ter.
					Ad. 2, 1, 45</span></i>
			; <i><span class="en">Plin. 8, 36, 54, § 130</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">incutere alicui,</span>”
				 <i><span class="en">Juv. 9,
					5</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">perpeti,</span>”
				 <i><span class="en">Plaut. Capt. 1, 1, 20</span></i>
			; <i><span class="en">Ter. Ad. 2, 2, 37</span></i>.</div>
