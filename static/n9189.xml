    <div class="alpheios-lex-entry" lemma-id="n9189" body-key=""><b><span class="alpheios-lex-la" lang="lat">cŏlumbīnus</span></b> , a, um
		columba, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>pertaining to a dove</i> or <i>pigeon</i>, <i>dove-</i>: 
				“<span class="alpheios-lex-la" lang="lat">pulli,</span>”
				 <i><span class="en">Varr. R. R. 3, 7, 9</span></i>
			; * <i><span class="en">Cic. Fam. 9, 18, 3</span></i>; so also <i>absol.</i>: <b><span class="alpheios-lex-la" lang="lat">cŏlumbīni</span></b> ,
			ōrum, m., <i>little
				doves</i>, <i><span class="en">Mart. 13, 66</span></i>: ovum, * <i><span class="en">Hor. S. 2,
				4, 56</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">fimus,</span>”
				 <i><span class="en">Plin.
					17, 27, 47, § 259</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">stercora,</span>”
				 <i><span class="en">id.
					35, 6, 27, § 46</span></i>
			. —</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>Dove-colored</i>: 
				“<span class="alpheios-lex-la" lang="lat">terra,</span>”
				 <i><span class="en">Plin.
					17, 7, 4, § 43</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cicer,</span>”
				 <i><span class="en">id.
					18, 12, 32, § 124</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vitis,</span>”
				 <i><span class="en">id.
					14, 3, 4, § 40</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">saxum,</span>”
				 <i><span class="en">Pall. 1, 10, 3</span></i>
			.</div>
