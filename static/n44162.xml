    <div class="alpheios-lex-entry" lemma-id="n44162" body-key=""><b><span class="alpheios-lex-la" lang="lat">Sīda</span></b> , ae (collat. form <b><span class="alpheios-lex-la" lang="lat">Sīdē</span></b> ,
			ēs, <i><span class="en">Plin. 5, 27, 26, § 96</span></i>),
			f., = <span class="alpheios-lex-greek" lang="grc">Σίδη</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a town in
			Pamphylia</i>, now <i>Eski Adalia</i>, <i><span class="en">Mel. 1, 14
				sq.</span></i>; <i><span class="en">Cic. Fam. 3, 6, 1</span></i>; <i><span class="en">3, 12,
			4</span></i>; <i><span class="en">12, 15, 5</span></i>; <i><span class="en">Liv. 35,
			13</span></i>; <i><span class="en">37, 23
			al.</span></i>—Hence, <b><span class="alpheios-lex-la" lang="lat">Sīdētae</span></b> ,
			ārum, m., = <span class="alpheios-lex-greek" lang="grc">Σιδῆται</span>, <i>the
				inhabitants of Sida</i>, <i><span class="en">Liv. 35,
				48, 6</span></i> Drak. <i>N. cr.</i></div>
