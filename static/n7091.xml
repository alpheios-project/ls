    <div class="alpheios-lex-entry" lemma-id="n7091" body-key=""><b><span class="alpheios-lex-la" lang="lat">cătellus</span></b> , i,
		m., and <b><span class="alpheios-lex-la" lang="lat">cătella</span></b> , ae, f.
		dim.
		catulus, canis, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a little dog</i>, <i>puppy</i>, <i>whelp.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense4"><b>a.</b>
			<i>Masc.</i>, <i><span class="en">Plaut.
				Stich. 4, 2, 40</span></i>; Varr. ap. <i><span class="en">Non. p.
				94, 24</span></i>; <i><span class="en">Cic. Div. 1, 46, 103</span></i> Orell. <i>N. cr.;</i>
			<i><span class="en">Val. Max.
				1, 5, 3</span></i>; <i><span class="en">Mart. 1, 84</span></i>; <i><span class="en">Juv. 6,
			551</span></i>; <i><span class="en">9, 61</span></i>; 
				“<span class="alpheios-lex-la" lang="lat">and as a term of endearment,</span>”
				 <i><span class="en">Plaut. As. 3, 3, 103</span></i>
			; <i><span class="en">Hor. S. 2, 3,
			259</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense4"><b>b.</b>
			<i>Fem.</i>, <i><span class="en">Mart. 3,
				82, 19</span></i>; <i><span class="en">Juv. 6, 654</span></i>; 
				“<span class="alpheios-lex-la" lang="lat">and as a term of endearment: mi catella,</span>”
				 <i><span class="en">Hier. Ep. 22, 29</span></i>
			.</div>
