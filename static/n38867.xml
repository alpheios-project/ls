    <div class="alpheios-lex-entry" lemma-id="n38867" body-key=""><b><span class="alpheios-lex-la" lang="lat">prŏpĕdĭem</span></b>  (also
		separate, <b><span class="alpheios-lex-la" lang="lat">prope diem</span></b> ), adv.
		prope-dies, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>at an early day</i>, <i>very
			soon</i>, <i>shortly</i> (class.), <i><span class="en">Plaut.
				Pers. 2, 4, 24</span></i>; <i><span class="en">5, 2, 56</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">prognostica mea propediem exspecta,</span>”
				 <i><span class="en">Cic.
					Att. 2, 1, 11</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">propediem te videbo,</span>”
				 <i><span class="en">id.
					Div. 1, 23, 47</span></i>
			; <i><span class="en">Sall. C. 56, 4</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">propediem,</span>”
				<i>prematurely</i>,
				 <i><span class="en">Liv.
					1, 48, 7</span></i>
			.</div>
