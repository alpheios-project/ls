			color</i> (opp. varius, differens): 
				“<span class="alpheios-lex-la" lang="lat">sues,</span>”
				 <i><span class="en">Varr. R. R. 2, 4, 3</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">oculus,</span>”
				 <i><span class="en">Plin.
					11, 37, 54, § 145</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">torus,</span>”
				 <i><span class="en">Ov.
					M. 11, 611</span></i>
			.</div>
