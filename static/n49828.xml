    <div class="alpheios-lex-entry" lemma-id="n49828" body-key=""><b><span class="alpheios-lex-la" lang="lat">ūnĭ-cŏlor</span></b> ,
			ōris (collat. form <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>acc. plur.</i> unicoloras animas,
					<i><span class="en">Prud. Ham. 821</span></i>), adj.
