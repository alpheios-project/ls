    <div class="alpheios-lex-entry" lemma-id="n3785" body-key=""><b><span class="alpheios-lex-la" lang="lat">Artăbānus</span></b> , i,
			m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A Parthian king of the family of the
				Arsacidœ</i>, <i><span class="en">Just. 42, 2</span></i>; <i><span class="en">Tac. A. 2,
			3</span></i>; <i><span class="en">2, 58</span></i>; <i><span class="en">6, 31</span></i> sq.; 11,
			8.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A general of Xerxes</i>, <i><span class="en">Nep. Reg. 1,
			5</span></i>; <i><span class="en">Just. 3, 1</span></i>.</div>
