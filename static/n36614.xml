    <div class="alpheios-lex-entry" lemma-id="n36614" body-key=""><b><span class="alpheios-lex-la" lang="lat">plausor</span></b>  (<b><span class="alpheios-lex-la" lang="lat">plōsor</span></b> , <i><span class="en">Sid. Ep. 9,
		3</span></i>; <i><span class="en">id. Carm. 9, 300</span></i>),
			ōris, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>one who claps applause</i>, <i>an applauder</i>
				(<b>poet.</b> and in post-Aug. prose): 
				“<span class="alpheios-lex-la" lang="lat">in vacuo laetus sessor plausorque theatro,</span>”
				 <i><span class="en">Hor. Ep. 2, 2, 130</span></i>
			; <i><span class="en">Petr. 5</span></i>; <i><span class="en">Suet.
				Ner. 25</span></i>.</div>
