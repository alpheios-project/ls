    <div class="alpheios-lex-entry" lemma-id="n28094" body-key=""><b><span class="alpheios-lex-la" lang="lat">marsūpĭum</span></b>  (<b><span class="alpheios-lex-la" lang="lat">-suppium</span></b> ), ii,
		n., = <span class="alpheios-lex-greek" lang="grc">μαρσύπιον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a pouch, purse</i>
			(ante- and postclass.): curam marsupii habere, Varr. ap.
					<i><span class="en">Non. 142, 1</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">nummi aurei in marsupio,</span>”
				 <i><span class="en">Plaut. Rud. 5, 2, 26</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">quom inspicio marsupium,</span>”
				 <i><span class="en">id.
					Men. 2, 1, 29</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">exenterare,</span>”
				<i>to empty</i>,
				 <i><span class="en">id.
					Ep. 2, 2, 3</span></i>
			; <i><span class="en">Prud. Psych. 600</span></i>;
					<i><span class="en">Alcim. 6, 311</span></i>.</div>
