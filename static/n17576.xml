    <div class="alpheios-lex-entry" lemma-id="n17576" body-key=""><b><span class="alpheios-lex-la" lang="lat">faenĭ-sĭcĭa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">fēn-, foen-</span></b> ),
