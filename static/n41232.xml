<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n41232" body-key=""><b><span class="alpheios-lex-la" lang="lat">rĕprĕhensor</span></b> ,
			ōris, m.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				blamer</i>, <i>censurer</i>, <i>reprehender</i>: 
				“<span class="alpheios-lex-la" lang="lat">restat unum genus reprehensorum, etc.,</span>”
				 <i><span class="en">Cic. Ac. 2, 3, 7</span></i>
			; <i><span class="en">id.
				Opt. Gen. 6, 18</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">comitiorum,</span>”
				 <i><span class="en">id.
					Planc. 3, 8</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">delicti,</span>”
				 <i><span class="en">Ov.
					H. 17, 219</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">id factum non accusatore tantum, sed etiam
					reprehensore caruit,</span>”
				 <i><span class="en">Val.
					Max. 6, 3, 9</span></i>
			.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
