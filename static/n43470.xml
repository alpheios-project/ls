    <div class="alpheios-lex-entry" lemma-id="n43470" body-key=""><b><span class="alpheios-lex-la" lang="lat">sēmĭ-ermis</span></b>  (<b><span class="alpheios-lex-la" lang="lat">sēmerm-</span></b> , v. <i><span class="en">Liv. 27, 1,
		15</span></i> Drak.; cf. semesus), e (in Liv.), and <b><span class="alpheios-lex-la" lang="lat">sēmĭ-ermus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">sēmerm-</span></b> ), a,
		um (in Tac.), adj.
		arma, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>half-armed</i>, <i>badly</i> or <i>indifferently armed</i>: 
				“<span class="alpheios-lex-la" lang="lat">mille semermes per agros palati sunt,</span>”
				 <i><span class="en">Liv.
					39, 31</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">multitudo,</span>”
				 <i><span class="en">id.
					22, 50</span></i>
			; <i><span class="en">23, 5</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">exercitus,</span>”
				 <i><span class="en">id.
					25, 19</span></i>
			; <i><span class="en">27, 1</span></i>
			<i>fin.</i>: 
				“<span class="alpheios-lex-la" lang="lat">cum sex milibus semiermium,</span>”
				 <i><span class="en">id.
					28, 16</span></i>
			; <i><span class="en">30, 28</span></i>;
				<i><span class="en">31, 41</span></i>; 
				“<span class="alpheios-lex-la" lang="lat">40, 58: hosti et paucos ac semermos cogitanti,</span>”
				 <i><span class="en">Tac. A.
					1, 68</span></i>
			; <i><span class="en">3, 39</span></i> and 45.</div>
