    <div class="alpheios-lex-entry" lemma-id="n39772" body-key=""><b><span class="alpheios-lex-la" lang="lat">pyrītes</span></b> , ae,
			m., = <span class="alpheios-lex-greek" lang="grc">πυρίτης.</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Flint</i>, 
			<i><span class="en">Plin. 36,
				19, 30, § 138</span></i>. — </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A millstone</i>, <i><span class="en">Plin. 36,
				19, 30, § 137</span></i>.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>Iron pyrites</i>, <i>sulphuret of
			iron</i>, <i>marcasite</i>, <i><span class="en">Plin. 36,
				19, 30, § 137</span></i>.</div>
