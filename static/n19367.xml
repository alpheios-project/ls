    <div class="alpheios-lex-entry" lemma-id="n19367" body-key=""><b><span class="alpheios-lex-la" lang="lat">gĕlĭcĭdĭum</span></b> ,
			ii, n.
		gelu-cado, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>frost</i>, <span class="alpheios-lex-greek" lang="grc">κρυμός</span>
			(mostly in <i>plur</i>): 
				“<span class="alpheios-lex-la" lang="lat">si gelicidia erunt, cum oleam coges,</span>”
				 <i><span class="en">Cato, R. R. 65, 2</span></i>
			; so plur., <i><span class="en">Col. 2, 8,
			3</span></i>; <i><span class="en">3, 1, 7</span></i>;
				<i><span class="en">11, 3</span></i>
			<i>fin.</i>; <i><span class="en">Vitr. 2, 7 <i>med.</i></span></i>: 
				“<span class="alpheios-lex-la" lang="lat">nocturna,</span>”
				<i>night-frosts</i>,
				 <i><span class="en">Col.
					11, 2, 6</span></i>
			.— In sing., <i><span class="en">Varr.
				R. R. 1, 55, 2</span></i>.</div>
