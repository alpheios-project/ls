    <div class="alpheios-lex-entry" lemma-id="n42583" body-key=""><b><span class="alpheios-lex-la" lang="lat">sapphīrus, sapphir</span></b> , <b><span class="alpheios-lex-la" lang="lat">sappir</span></b> , i (i short,
