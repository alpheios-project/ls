    <div class="alpheios-lex-entry" lemma-id="n24956" body-key=""><b><span class="alpheios-lex-la" lang="lat">irrĕquĭētus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inr-</span></b> ), a,
		um, adj.
		2. inrequietus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unquiet</i>, <i>restless</i> (<b>poet.</b> and in post-Aug. prose): 
				“<span class="alpheios-lex-la" lang="lat">Enipeus,</span>”
				 <i><span class="en">Ov. M.
					1, 579</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">illa,</span>”
				 <i><span class="en">id.
					ib. 5, 443</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">Charybdis,</span>”
				 <i><span class="en">id.
					ib. 13, 730</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">agitatio,</span>”
				 <i><span class="en">Sen. Brev. Vit. 10, 6</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">circuitus mundi,</span>”
				 <i><span class="en">Plin.
					2, 5, 4, § 11</span></i>
			; cf.: 
				“<span class="alpheios-lex-la" lang="lat">ambitus (mundi),</span>”
				 <i><span class="en">id. 2,
					3, 3, § 6</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>disquieting</i>,
				<i>causing unrest</i>: 
				“<span class="alpheios-lex-la" lang="lat">sors mea,</span>”
				 <i><span class="en">Ov. M.
					2, 386</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">bella,</span>”
				 <i><span class="en">id.
					Tr. 2, 236</span></i>
			.</div>
