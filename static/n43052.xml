    <div class="alpheios-lex-entry" lemma-id="n43052" body-key=""><b><span class="alpheios-lex-la" lang="lat">scordĭon</span></b> , ii,
		n., = <span class="alpheios-lex-greek" lang="grc">σκόρδιον,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a plant that smells
				like garlic</i>, <i>water - germander</i>, <i>scordium</i>: Teucrium scordium, Linn.; <i><span class="en">Plin. 25, 6,
				27, § 63</span></i>.—Also called <b><span class="alpheios-lex-la" lang="lat">scordŏtis</span></b> , <i><span class="en">Plin. 25, 6,
				27, § 63</span></i>; and <b><span class="alpheios-lex-la" lang="lat">scordĭlon</span></b> , <i><span class="en">App. Herb.
				70</span></i>.</div>
