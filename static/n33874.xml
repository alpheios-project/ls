    <div class="alpheios-lex-entry" lemma-id="n33874" body-key=""><b><span class="alpheios-lex-la" lang="lat">părĭlis</span></b> , e,
			adj.
		par, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>equal</i>, <i>like</i> (anteclass. and <b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">et noctes pariles agitare diebus,</span>”
				 <i><span class="en">Lucr.
					1, 1067</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">aetas,</span>”
				 <i><span class="en">Ov. M.
					8, 631</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vox,</span>”
				 <i><span class="en">id.
					Tr. 1, 8, 26</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">furor,</span>”
				 <i><span class="en">Nemes. Ecl. 4, 5</span></i>
			 (but in <i><span class="en">Varr. L. L. 9, § 29</span></i>
			Müll., paria is the better reading; v. Müll. ad
				loc.).—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">părĭlĭter</span></b> , <i>equally</i>, <i><span class="en">Charis. p.
			191</span></i> P.</div>
