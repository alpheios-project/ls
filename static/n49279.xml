    <div class="alpheios-lex-entry" lemma-id="n49279" body-key=""><b><span class="alpheios-lex-la" lang="lat">Trōjŭgĕna</span></b> ,
			ae, comm.
		Troja-gigno, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>Troy-born</i>, <i>born in Troy</i>,
				<i>of Trojan descent</i>, <i>Trojan</i> (<b>poet.</b>): 
				“<span class="alpheios-lex-la" lang="lat">gentes,</span>”
				 <i><span class="en">Lucr.
					1, 465</span></i>
			: Romanus, <i>descended from Trojans</i>, Vet.
			Carm. ap. <i><span class="en">Liv. 25, 12, 5</span></i>.—<i>Subst. m.</i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>1.</b>
			<i>A Trojan</i>, <i><span class="en">Cat. 64,
				356</span></i>; <i><span class="en">Verg. A. 8, 117</span></i>; <i><span class="en">3,
			359</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>A Roman</i>, <i><span class="en">Juv. 1,
			100</span></i>; <i><span class="en">11,
		95</span></i>.</div>
