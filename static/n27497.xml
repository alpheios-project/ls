    <div class="alpheios-lex-entry" lemma-id="n27497" body-key=""><b><span class="alpheios-lex-la" lang="lat">Mā^cris</span></b> , ĭdis,
			f., = <span class="alpheios-lex-greek" lang="grc">Μακρις</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the name of several
				islands</i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>In the Ægean Sea, near Ionia</i>, <i><span class="en">Liv. 27,
			13</span></i>; <i><span class="en">28</span></i>; <i><span class="en">29</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>An ancient name of the island of
			Eubœa</i>, <i><span class="en">Plin. 4, 12, 21, §
			64</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<i>Of Chios</i>, <i><span class="en">Plin. 5, 31,
				38, § 136</span></i>. —</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>IV.</b>
			<i>Of Icarus</i>, <i><span class="en">Plin. 4, 12,
				23, § 68</span></i>.</div>
