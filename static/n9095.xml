    <div class="alpheios-lex-entry" lemma-id="n9095" body-key=""><b><span class="alpheios-lex-la" lang="lat">collŏcūtĭo</span></b>  (<b><span class="alpheios-lex-la" lang="lat">conl-</span></b> ),
			ōnis, f.
		colloquor, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a</i> (<i>familiar</i> or <i>private</i>) <i>conversation</i>, <i>conference</i> (very rare): 
				“<span class="alpheios-lex-la" lang="lat">hominum,</span>”
				 <i><span class="en">Cic.
					Tusc. 1, 13, 30</span></i>
			; <i><span class="en">id. Att. 12, 1, 2</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">venire cum aliquo in collocutionem,</span>”
				 <i><span class="en">Auct. Her. 1, 15, 25</span></i>
			.—In plur.: 
				“<span class="alpheios-lex-la" lang="lat">familiarissimae cum aliquo,</span>”
				 <i><span class="en">Cic.
					Phil. 11, 2, 5</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">in sermonibus collocutionibusque aliquid
					videre,</span>”
				 <i><span class="en">id.
					Fam. 1, 9, 4</span></i>
			.</div>
