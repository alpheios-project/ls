    <div class="alpheios-lex-entry" lemma-id="n6157" body-key=""><b><span class="alpheios-lex-la" lang="lat">Cālātĭa</span></b> ,
		ae (<b><span class="alpheios-lex-la" lang="lat">Cālātĭae</span></b> ,
			ārum, <i><span class="en">Plin. 3, 5, 9,
			§ 63</span></i>), f., = <span class="alpheios-lex-greek" lang="grc">Καλατία</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a town in Campania</i>, <i>on the Via
				Appia</i>, <i>between Capua and Beneventum</i>,
			now <i>Galazze</i>, <i><span class="en">Cic. Att.
				16, 8, 1</span></i>; <i><span class="en">Liv. 9, 2, 2</span></i>; <i><span class="en">23, 14, 13</span></i>; <i><span class="en">27, 3, 7</span></i>; <i><span class="en">Sil. 8,
			542</span></i>; <i><span class="en">11, 14</span></i>
			sq.—Hence, </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b><span class="alpheios-lex-la" lang="lat">Cālātīni</span></b> , <i>its
				inhabitants</i>, <i><span class="en">Liv. 22, 61, 11 al.</span></i>—In
				sing. Calatinus, <i>cognomen of M.
				Atilius</i>, <i><span class="en">Cic. Agr. 2, 24, 63</span></i>; <i><span class="en">id. Sen. 17,
				61</span></i>.</div>
