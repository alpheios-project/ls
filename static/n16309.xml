    <div class="alpheios-lex-entry" lemma-id="n16309" body-key=""><b><span class="alpheios-lex-la" lang="lat">Euadne</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Euhadne</span></b> , <b><span class="alpheios-lex-la" lang="lat">Evadne</span></b> ), ēs, f., = <span class="alpheios-lex-greek" lang="grc">Εὐάδνη</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>wife of Capaneus</i>, <i>one
