    <div class="alpheios-lex-entry" lemma-id="n19384" body-key=""><b><span class="alpheios-lex-la" lang="lat">gĕmĭnātĭo</span></b> ,
			ōnis, f.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a
				doubling</i>: geminatio verborum habet interdum vim, leporem
			alias, * <i><span class="en">Cic. de Or. 3, 54, 206</span></i>; so, 
				“<span class="alpheios-lex-la" lang="lat">verborum,</span>”
				 <i><span class="en">Quint. 9, 3, 67</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">vocalium,</span>”
				 <i><span class="en">id.
					1, 4, 10</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">accusativi,</span>”
				 <i><span class="en">id.
					7, 9, 10</span></i>
			; <i><span class="en">id. 9, 3, 29</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">in eadem vitii geminatione,</span>”
				 <i><span class="en">id.
					1, 5, 12</span></i>
			; <i><span class="en">Gell. 13, 24, 4</span></i>.</div>
