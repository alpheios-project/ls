    <div class="alpheios-lex-entry" lemma-id="n3708" body-key=""><b><span class="alpheios-lex-la" lang="lat">Arnē</span></b> , ēs,
			f., = <span class="alpheios-lex-greek" lang="grc">Ἄρνη</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
