    <div class="alpheios-lex-entry" lemma-id="n7756" body-key=""><b><span class="alpheios-lex-la" lang="lat">chartārĭus</span></b> , a,
		um, adj.
		id., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or 
			
			<i>pertaining to paper</i>, <i>paper-</i>: 
				“<span class="alpheios-lex-la" lang="lat">officinae,</span>”
				 <i><span class="en">Plin.
					18, 10, 20, § 89</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">calamus,</span>”
				 <i><span class="en">App. Flor. 9</span></i>
			.— </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">chartārĭus</span></b> , ii,
				m., <i>a papermerchant</i>,
					<i><span class="en">Diom. p. 313</span></i> P.;
					<i><span class="en">Inscr. Orell.
			4159</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>III.</b>
			<b><span class="alpheios-lex-la" lang="lat">chartārĭum</span></b> , i,
			n., <i>archives</i>,
				<i><span class="en">Hier. adv. Ruf. 3, 6</span></i>.</div>
