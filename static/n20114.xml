    <div class="alpheios-lex-entry" lemma-id="n20114" body-key=""><b><span class="alpheios-lex-la" lang="lat">haemătītes</span></b> , ae,
			m., = <span class="alpheios-lex-greek" lang="grc">αἱματίτης</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>blood-stone</i>, <i>a kind of red
				iron-ore</i>, <i>hematite</i>, <i><span class="en">Plin. 36,
				16, 25</span></i>, §§ 129, 130; 
				“<span class="alpheios-lex-la" lang="lat">36, 20, 37, § 144.—In
					apposition: lapis haematites purgat,</span>”
				 <i><span class="en">Cels. 5,
					3</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A red-colored precious stone</i>, <i><span class="en">Plin. 37,
				10, 60, § 169</span></i>.</div>
