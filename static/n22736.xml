    <div class="alpheios-lex-entry" lemma-id="n22736" body-key=""><b><span class="alpheios-lex-la" lang="lat">indemnātus</span></b> , a, um,
			adj.
		2. in-damnatus, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>uncondemned</i>, <i>unsentenced</i>
			(class.): 
				“<span class="alpheios-lex-la" lang="lat">indemnatus atque intestatus,</span>”
				 <i><span class="en">Plaut. Curc. 5, 3, 17</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">bona indemnatorum civium,</span>”
				 <i><span class="en">Cic.
					Agr. 2, 21, 56</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">si hoc indemnato indicta causa non liceat,</span>”
				 <i><span class="en">Liv.
					3, 56, 13</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">civem interimere,</span>”
				 <i><span class="en">Vell.
					2, 45</span></i>
			; <i><span class="en">Amm. 15, 5</span></i>; <i><span class="en">Quint. 3,
				11, 14</span></i>; <i><span class="en">Juv. 6, 562 al.</span></i>—Com.: 
				“<span class="alpheios-lex-la" lang="lat">quae pendent indemnatae pernae,</span>”
				 <i><span class="en">Plaut.
					Capt. 4, 3, 8</span></i>
			.</div>
