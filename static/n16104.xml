    <div class="alpheios-lex-entry" lemma-id="n16104" body-key=""><b><span class="alpheios-lex-la" lang="lat">ĕrēmus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">ĕrĕmus</span></b> ,
			<i><span class="en">Prud. Cathem. 5, 89</span></i>;
			<i><span class="en">id. Psych. 371</span></i>), a, um,
			adj., = <span class="alpheios-lex-greek" lang="grc">ἔρημος</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>waste</i>, <i>desert</i> (late Lat.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>Adj.</i>: 
				“<span class="alpheios-lex-la" lang="lat">loca,</span>”
				 <i><span class="en">Cod. Just. 11, 57, 4</span></i>
			.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>Subst.</i>: <b><span class="alpheios-lex-la" lang="lat">ĕrēmus</span></b> , i,
			m. (sc. locus), or f. (sc. regio), <i>a wilderness</i>, <i>desert</i>,
					<i><span class="en">Tert. Idol. 5</span></i>; Sulpic. Sever.
			Dial. 1, 15; <i><span class="en">Vulg. Deut. 1, 19 al.</span></i></div>
