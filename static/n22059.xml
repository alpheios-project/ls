    <div class="alpheios-lex-entry" lemma-id="n22059" body-key=""><b><span class="alpheios-lex-la" lang="lat">improsper</span></b>  (<b><span class="alpheios-lex-la" lang="lat">inpr-</span></b> ), spĕra, ĕrum,
			adj.
		2. in-prosper, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>unfortunate</i>, <i>unprosperous</i>
			(post-Aug.): 
				“<span class="alpheios-lex-la" lang="lat">fortuna,</span>”
				 <i><span class="en">Tac. A.
					3, 24</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">moles insidiarum,</span>”
				 <i><span class="en">id. ib. 14, 65</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">multa claritudine generis sed improspera,</span>”
				 <i><span class="en">id. ib. 4, 44</span></i>
			.—<i>Adv.</i>: <b><span class="alpheios-lex-la" lang="lat">improspĕrē</span></b> , <i>unfortunately</i>: 
				“<span class="alpheios-lex-la" lang="lat">cessit,</span>”
				 <i><span class="en">Col.
					1, 1, 16</span></i>
			; <i><span class="en">Tac.
				A. 1, 8</span></i>; <i><span class="en">Gell. 9, 9, 12</span></i>.</div>
