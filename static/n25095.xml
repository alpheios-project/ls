<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n25095" body-key=""><b><span class="alpheios-lex-la" lang="lat">Istri</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Histri</span></b> ), ōrum, m., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>the inhabitants of
				Istria</i>, <i>the Istrians</i>, <i><span class="en">Liv. 41,
			11</span></i>; <i><span class="en">Plin. 3, 19, 23, §
			129</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			Derivv. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>A.</b>
			<b><span class="alpheios-lex-la" lang="lat">Istrĭa</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Hist-</span></b> ), <i>a country of Italy</i>, <i>on the
				Adriatic Sea</i>, <i>and bordering on
			Illyria</i>, <i><span class="en">Plin. 3, 19, 23, § 129</span></i>; <i><span class="en">Liv. 39,
			55</span></i>. — </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>B.</b>
			<b><span class="alpheios-lex-la" lang="lat">Istrĭ-āni</span></b> 
				(<b><span class="alpheios-lex-la" lang="lat">Hist-</span></b> ),
				ōrum, m., <i>the inhabitants of Istria</i>, <i>Istrians</i>,
				<i><span class="en">Juv.
				9, 2, 1</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>C.</b>
			<b><span class="alpheios-lex-la" lang="lat">Istrĭcus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Hist-</span></b> ), a,
			um, adj., <i>of</i> or <i>belonging to Istria</i>, <i>Istrian</i>: 
				“<span class="alpheios-lex-la" lang="lat">bellum,</span>”
				 <i><span class="en">Liv.
					41, 1</span></i>
			; <i><span class="en">41, 11</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">ostrea,</span>”
				 <i><span class="en">Plin.
					32, 6, 21, § 62</span></i>
			. — </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>D.</b>
			<b><span class="alpheios-lex-la" lang="lat">Istrus</span></b>  (<b><span class="alpheios-lex-la" lang="lat">Hist-</span></b> ), a, um,
				adj., <i>Istrian</i>: 
				“<span class="alpheios-lex-la" lang="lat">testa,</span>”
				i. e. <i>Istrian oil in Istrian jars</i>,
				 <i><span class="en">Mart. 12, 63, 2</span></i>
			.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
