    <div class="alpheios-lex-entry" lemma-id="n33742" body-key=""><b><span class="alpheios-lex-la" lang="lat">părābĭlis</span></b> ,
		e, adj.
		paro, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>easily procured</i>, <i>easy to be had</i>, <i>of easy attainment</i> (class.): 
				“<span class="alpheios-lex-la" lang="lat">divitiae,</span>”
				 <i><span class="en">Cic.
					Fin. 1, 13, 36</span></i>
			; cf. <i><span class="en">id. Tusc. 5, 33, 93</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">namque parabilem amo venerem facilemque,</span>”
				 <i><span class="en">Hor.
					S. 1, 2, 119</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">cultus (corporis),</span>”
				 <i><span class="en">Curt.
					3, 5, 2</span></i>
			; cf. <i><span class="en">id. 6, 2, 2</span></i>; <i><span class="en">8, 4, 14</span></i>: 
				“<span class="alpheios-lex-la" lang="lat">res,</span>”
				 <i><span class="en">Sen.
					Ep. 5, 4</span></i>
			.</div>
