    <div class="alpheios-lex-entry" lemma-id="n36906" body-key=""><b><span class="alpheios-lex-la" lang="lat">Pŏlybus</span></b> , i,
			m., = <span class="alpheios-lex-greek" lang="grc">Πόλυβος</span>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A king of Corinth</i>, <i>at whose
				court Œdipus was brought up</i>, <i><span class="en">Stat. Th. 1,
				64</span></i>; <i><span class="en">Hyg. Fab. 66</span></i>; <i><span class="en">67</span></i>; <i><span class="en">Sen.
				Oedip. 12</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>One of Penelope's suitors</i>, <i><span class="en">Ov. H. 1,
			91</span></i>.</div>
