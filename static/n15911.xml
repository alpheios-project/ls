<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n15911" body-key=""><b><span class="alpheios-lex-la" lang="lat">ĕpĭbăta</span></b> ,
		ae, m., = <span class="alpheios-lex-greek" lang="grc">ἐπιβάτης</span> (<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>one who mounts</i>). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b>
			<i>A rider of a camel</i>, <i><span class="en">Hyg.
				Grom. p. 10</span></i> b.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<i>A soldier on board a ship</i> (pure Lat.
			classiarius miles), Auct. B. Alex. 11, 4; Auct. B. Afr. 20, 1; 62,
			1; 63, 4; <i><span class="en">Vitr. 2, 8</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
