    <div class="alpheios-lex-entry" lemma-id="n8615" body-key=""><b><span class="alpheios-lex-la" lang="lat">clīnŏpălē</span></b> ,
			ēs, f., = <span class="alpheios-lex-greek" lang="grc">κλινοπάλη</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a wrestling in bed</i>, = concubitus, Domit. ap.
				<i><span class="en">Suet. Dom. 22</span></i> (in <i><span class="en">Aur.
				Vict. Caes. 11</span></i>, used as Greek).*
			† <b><span class="alpheios-lex-la" lang="lat">clīnŏpŏdĭon</span></b> ,
				ii, n., = <span class="alpheios-lex-greek" lang="grc">κλινοπόδιον</span>, <i>a plant</i>, <i>wild basil</i>, <i><span class="en">Plin. 24,
				15, 87, § 137</span></i>.* † <b><span class="alpheios-lex-la" lang="lat">clīnŏpūs</span></b> ,
				pŏdis, m., = <span class="alpheios-lex-greek" lang="grc">κλινόπους</span>, <i>the foot of a
				bed</i>, Lucil. ap. <i><span class="en">Macr. S. 6,
			4</span></i>.</div>
