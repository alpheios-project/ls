    <div class="alpheios-lex-entry" lemma-id="n39344" body-key=""><b><span class="alpheios-lex-la" lang="lat">psōrĭcus</span></b> , a,
		um, adj., = <span class="alpheios-lex-greek" lang="grc">ψωρικός</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>of</i> or <i>for the itch</i> or <i>mange</i>: 
				“<span class="alpheios-lex-la" lang="lat">medicamentum,</span>”
				<i>good for the itch</i>,
				 <i><span class="en">Plin.
					34, 12, 29, § 119</span></i>
			: 
				“<span class="alpheios-lex-la" lang="lat">collyrium,</span>”
				 <i><span class="en">Scrib. Comp. 32</span></i>
			.—As <i>subst.</i>: <b><span class="alpheios-lex-la" lang="lat">psō-rĭcum</span></b> ,
				i, n., <i>a remedy for
				the itch</i>, <i><span class="en">Cels. 6, 6, 31</span></i>.</div>
