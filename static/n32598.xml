			: 
				“<span class="alpheios-lex-la" lang="lat">pulcher,</span>”
				 <i><span class="en">Mart. 13, 100, 1</span></i>
			; <i><span class="en">Vulg. Psa. 103, 11</span></i>; id. Osee, 8,
			9.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>II.</b>
			<b>Transf.</b>, <i>a military engine
				for discharging large stones</i>, <i><span class="en">Veg.
				Mil. 4, 22</span></i>; <i><span class="en">Amm. 23, 4,
		4</span></i>.</div>
