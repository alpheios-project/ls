    <div class="alpheios-lex-entry" lemma-id="n24853" body-key=""><b><span class="alpheios-lex-la" lang="lat">Ĭos</span></b> , i, f., = <span class="alpheios-lex-greek" lang="grc">Ἴος,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>I.</b><i>a small island of
				the Sporades</i>, <i>in the Ægean
			Sea</i>, now <i>Nio</i>, <i><span class="en">Mel. 2, 7,
				11</span></i>; <i><span class="en">Plin. 4, 12, 23, §
				69</span></i>.—<b><span class="alpheios-lex-la" lang="lat">Ĭētae</span></b> ,
			ārum, m., = <span class="alpheios-lex-greek" lang="grc">Ἰῆται,</span>
			<i>the inhabitants of</i> Ios, Varr. ap. <i><span class="en">Gell. 3,
				11, 6</span></i>.</div>
