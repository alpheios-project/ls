    <div class="alpheios-lex-entry" lemma-id="n14816" body-key=""><b><span class="alpheios-lex-la" lang="lat">Dryops</span></b> , ŏpis,
			m.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>1.</b>
			<i>One of the Dryopes</i>, <i>a people of
				Epirus</i>, <i><span class="en">Ov. Ib. 490</span></i>; usu.
			plur.: <b><span class="alpheios-lex-la" lang="lat">Dryŏpes</span></b> , um, <i>the Dryopians</i>, <i><span class="en">Plin. 4
				praef.</span></i>; <i><span class="en">Verg. A. 4,
			146</span></i>.—</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>The name of a warrior</i>, <i><span class="en">Verg. A.
				10, 346</span></i>.</div>
